{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "types": [
      "node",
      "vite/client"
    ],
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "allowJs": false
  },
  "include": [
    "tools/**/*.ts",
    "target/temple-run/vite.config.ts",
    "target/temple-run/web/src/*-preview.ts",
    "target/temple-run/web/obstacle-tools/**/*.ts",
    "target/temple-run/web/track-tools/**/*.ts",
    "src/**/*.ts",
    "target/temple-run/web/src/entrance-search.ts"
  ]
}
