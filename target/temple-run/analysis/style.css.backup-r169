@import url('https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@400;500;600;700;800&family=Outfit:wght@400;500;600;700;800&display=swap');
:root{font-family:'Outfit','Noto Sans SC',sans-serif;color:#f6ecd0;background:#131a17;font-synthesis:none}*{box-sizing:border-box}body{margin:0;min-width:320px}button{font:inherit;cursor:pointer}.app{min-height:100dvh;display:flex;align-items:center;justify-content:center;gap:clamp(35px,7vw,130px);padding:22px 5vw;background:radial-gradient(circle at 50% 15%,#354b3e 0,#17241d 42%,#0c1512 100%)}.frame{position:relative;width:min(440px,95vw,calc((100dvh - 44px)*.6));height:min(calc(100dvh - 44px),733px);min-height:500px;overflow:hidden;border:7px solid #7c7563;border-radius:30px;background:#536c5e;box-shadow:0 0 0 2px #322d25,0 32px 85px #0009,0 0 90px #a0905b28}canvas{display:block;width:100%;height:100%;touch-action:none}.shade{position:absolute;inset:0;pointer-events:none;background:linear-gradient(#17251db8 0%,transparent 24%,transparent 69%,#0a1516a8 100%)}.hud{position:absolute;z-index:2;left:20px;right:20px;top:17px;display:flex;align-items:center;justify-content:space-between}.brand{display:flex;align-items:center;gap:8px;font-weight:800;letter-spacing:.08em;font-size:16px;text-shadow:0 2px 8px #111}.brand-mark{font-size:27px;color:#f5bf5d;text-shadow:0 0 16px #f4af3b}.brand small{display:block;color:#edce91;font-size:7px;font-weight:700;letter-spacing:.24em;margin-top:1px}.icon-button{width:40px;height:40px;border-radius:50%;border:1px solid #e9d3a17d;background:#1723199c;color:#f2d89e;font-size:18px}.hud-actions{display:flex;gap:7px}.stats{position:absolute;z-index:2;top:75px;left:20px;right:20px;display:flex;justify-content:space-around;align-items:center;padding:11px 4px;border:1px solid #d9c88b6b;border-radius:14px;background:#1c281ecf;box-shadow:0 8px 25px #1118;backdrop-filter:blur(7px)}.stats div{text-align:center;min-width:65px}.stats small{display:block;color:#d0bd8f;font-size:10px;font-weight:700;letter-spacing:.1em}.stats strong{font-size:24px;line-height:1.25;color:#fff1c5}.stats span{font-size:10px;color:#d0bd8f}.stats i{height:27px;width:1px;background:#d7c78c55}.hint{position:absolute;z-index:2;top:30%;left:50%;transform:translateX(-50%) translateY(-8px);padding:10px 14px;min-width:max-content;border-radius:100px;background:#152018d9;border:1px solid #f0ce87a3;color:#f5e0aa;font-size:12px;font-weight:700;opacity:0;transition:opacity .2s,transform .2s;pointer-events:none}.hint.visible{opacity:1;transform:translateX(-50%) translateY(0)}.turn-cue{position:absolute;z-index:3;top:30%;left:50%;transform:translateX(-50%);display:flex;flex-direction:column;align-items:center;width:205px;padding:10px;background:#6c2e1ee8;border:2px solid #ffc868;border-radius:15px;box-shadow:0 6px 30px #160f09a8;text-align:center;animation:pulse .65s infinite alternate}.turn-cue span{font-size:45px;line-height:1;color:#ffe29f}.turn-cue strong{font-size:19px}.turn-cue small{font-size:10px;color:#ffdfae}@keyframes pulse{to{transform:translateX(-50%) scale(1.04)}}.controls{position:absolute;z-index:3;left:15px;right:15px;bottom:38px;display:flex;justify-content:space-between}.controls>div{display:flex;gap:8px}.controls button{width:56px;height:56px;border-radius:16px;border:1px solid #efdbac9c;background:#1a2a23c4;color:#ffe0a2;font-size:27px;box-shadow:0 5px 13px #07100eb3;touch-action:none}.controls button:active{background:#735934;transform:translateY(2px)}.bottom-note{position:absolute;left:0;right:0;bottom:12px;text-align:center;font-size:8px;font-weight:800;letter-spacing:.22em;color:#ddcca1;text-shadow:0 1px 4px #000}.bottom-note span{color:#ffcf68}.overlay{position:absolute;z-index:5;inset:0;display:grid;place-items:center;background:linear-gradient(165deg,#10241bbb,#19201560 50%,#07100ce0);backdrop-filter:blur(4px)}.hidden{display:none!important}.card{width:calc(100% - 54px);max-width:355px;padding:24px 22px 27px;text-align:center;border:1px solid #e0c38578;border-radius:22px;background:linear-gradient(160deg,#26392ddf,#17281df2);box-shadow:0 24px 55px #06120de0,0 1px 0 #fff3 inset}.crest{font-size:36px;color:#f1b950}.kicker{font-size:10px;font-weight:800;letter-spacing:.22em;color:#e8c47c;margin:5px 0 12px}.card h1{font-size:clamp(54px,9vh,83px);line-height:.95;letter-spacing:.04em;margin:10px 0 23px;text-shadow:0 4px 0 #142219,0 6px 16px #0009}.card h1 em,.side h2 em{font-style:normal;color:#eab854}.card h2{font-size:47px;margin:12px 0 18px}.lead{font-size:13px;color:#d7d2b5;line-height:1.9;margin:0 0 24px}.primary{width:100%;min-height:52px;padding:13px 18px;border:0;border-radius:10px;background:linear-gradient(#f5ce71,#d99a37);color:#322515;font-size:16px;font-weight:800;letter-spacing:.1em;box-shadow:0 5px 0 #90652e,0 9px 18px #0006}.primary span{float:right;font-size:22px;line-height:1}.primary:active{transform:translateY(4px);box-shadow:0 1px 0 #90652e}.secondary{margin-top:20px;background:none;border:0;color:#e7d5a6;text-decoration:underline;font-size:13px}.guide{display:flex;justify-content:center;flex-wrap:wrap;gap:9px 13px;margin-top:26px;color:#c1b18c;font-size:10px}.result{display:grid;grid-template-columns:repeat(3,1fr);gap:5px;padding:19px 0;margin:20px 0;border-top:1px solid #b9a77955;border-bottom:1px solid #b9a77955}.result small{display:block;color:#c9b887;font-size:10px}.result strong{display:block;color:#ffe3a2;font-size:17px;margin-top:5px}.side{max-width:430px;color:#d0d1ba}.eyebrow{color:#dfb966;font-size:11px;font-weight:800;letter-spacing:.24em}.side h2{font-size:clamp(38px,4vw,58px);line-height:1.3;color:#fff1ce;margin:20px 0}.side>p:not(.eyebrow){font-size:15px;line-height:2;color:#aebcad;margin-bottom:36px}.key-row{display:flex;align-items:center;gap:8px;margin:14px 0;font-size:12px;color:#d9d6be}.key-row span{margin-left:9px}kbd{display:inline-grid;place-items:center;width:38px;height:36px;border:1px solid #9d956b;border-bottom-width:3px;border-radius:7px;color:#f1ce8a;background:#263629;font:700 18px 'Outfit',sans-serif}.line{height:1px;background:#8a8c6a55;margin:38px 0 20px}.edition{font-size:10px;letter-spacing:.19em;color:#9f9c73}@media(max-width:850px){.app{padding:0}.frame{width:100vw;height:100dvh;min-height:0;border:0;border-radius:0;box-shadow:none}.side{display:none}.hud{top:calc(17px + env(safe-area-inset-top))}.stats{top:calc(75px + env(safe-area-inset-top))}.controls{bottom:calc(38px + env(safe-area-inset-bottom))}.bottom-note{bottom:calc(12px + env(safe-area-inset-bottom))}.turn-cue{top:calc(168px + env(safe-area-inset-top))!important}}@media(max-height:580px){.card{padding:16px}.card h1{font-size:47px;margin:7px}.lead{margin-bottom:13px}.guide{margin-top:14px}}
.turn-cue.ready{background:#2c6a3ee8;border-color:#a8e88d;animation:none;box-shadow:0 0 0 3px #a9ef8f44,0 6px 30px #160f09a8}
.turn-cue.ready strong{color:#dcffc9}
.turn-cue.ready small{color:#dfffc9}
.death-art{display:block;width:min(88%,330px);height:auto;margin:-8px auto 2px;filter:drop-shadow(0 10px 22px #0008)}
.turn-cue{top:168px!important;bottom:auto!important;width:auto;min-width:0;padding:7px 15px;gap:2px;border-radius:14px}.turn-cue span{font-size:30px}.turn-cue strong{font-size:15px}.turn-cue small{font-size:9px}
@keyframes pulse{from{transform:translateX(-50%) scale(1)}to{transform:translateX(-50%) scale(1.04)}}
.turn-cue{top:auto!important;bottom:112px!important}
.turn-cue{top:160px!important;bottom:auto!important;flex-direction:row;gap:8px;padding:5px 14px!important;border-radius:100px!important;align-items:center}.turn-cue span{font-size:26px!important}.turn-cue strong{font-size:14px!important}.turn-cue small{display:none}
.multi{position:absolute;z-index:2;top:150px;left:20px;padding:4px 11px;border-radius:100px;background:linear-gradient(#f6cf74,#dc9c36);color:#3a2a12;font-weight:900;font-size:15px;letter-spacing:.04em;box-shadow:0 4px 12px #0007,0 0 0 2px #f6cf7444;pointer-events:none}
.multi.pop{animation:multiPop .32s ease-out}
@keyframes multiPop{0%{transform:scale(.7)}55%{transform:scale(1.18)}100%{transform:scale(1)}}

/* ---- original UI art (from egUI_Buttons2x atlas) ---- */
.menu-logo{display:block;width:100%;max-width:272px;margin:2px auto 10px;filter:drop-shadow(0 6px 12px rgba(0,0,0,.55))}
.menu-tag{margin:2px 0 8px;font-size:11px;letter-spacing:.28em;text-transform:uppercase;color:#e6c07a;opacity:.92}
.play-btn{display:flex;align-items:center;justify-content:center;gap:8px}
.play-art{height:26px;width:auto;filter:drop-shadow(0 2px 3px rgba(0,0,0,.45))}
.pause-art{display:block;width:176px;margin:0 auto 4px;filter:drop-shadow(0 4px 8px rgba(0,0,0,.5))}

/* ---- power-up badge ---- */
.power{position:absolute;z-index:2;top:150px;left:78px;padding:4px 10px;border-radius:100px;background:#101812d8;color:#f2e6c8;font-weight:800;font-size:12px;letter-spacing:.02em;border:2px solid #ffffff44;pointer-events:none;transition:opacity .2s}
.power{top:188px!important;left:20px!important}

/* ---- original menu word-art buttons + panels ---- */
.menu-actions{display:flex;gap:10px;justify-content:center;align-items:center;margin-top:16px;flex-wrap:wrap}
.menu-art-btn{background:none;border:0;padding:4px 2px;opacity:.95;filter:drop-shadow(0 3px 7px rgba(0,0,0,.55));transition:transform .12s,opacity .12s}
.menu-art-btn img{display:block;height:17px;width:auto}
.menu-art-btn:active{transform:translateY(2px) scale(.97);opacity:.8}
.panel-card{max-width:342px}
.panel-title{display:block;height:32px;width:auto;margin:2px auto 12px;filter:drop-shadow(0 4px 8px #0008)}
.panel-body{text-align:left;margin:2px 0 18px;max-height:42vh;overflow:auto}
.switch-row{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:11px 2px;border-bottom:1px solid #ffffff14;font-size:13px;color:#e9dfc2}
.switch-row span small{display:block;font-size:10px;color:#9fb39f;margin-top:2px}
.switch{appearance:none;-webkit-appearance:none;flex:0 0 auto;width:46px;height:26px;border-radius:100px;background:#2b3a30;border:1px solid #ffffff33;position:relative;cursor:pointer;transition:background .15s;margin:0}
.switch:checked{background:#4d8a5c}
.switch::after{content:'';position:absolute;top:2px;left:2px;width:20px;height:20px;border-radius:50%;background:#f5e6c0;transition:transform .15s}
.switch:checked::after{transform:translateX(20px)}
.stat-row{display:flex;justify-content:space-between;align-items:baseline;padding:10px 2px;border-bottom:1px solid #ffffff12;font-size:13px;color:#d9d2b6}
.stat-row b{color:#ffe6ac;font-size:16px}
.store-row{display:flex;justify-content:space-between;align-items:center;gap:10px;padding:10px 2px;border-bottom:1px solid #ffffff12;font-size:13px;color:#e6dcbe}
.store-row small{display:block;font-size:10px;color:#9fb39f;margin-top:2px}
.tag{font-size:10px;font-weight:800;letter-spacing:.08em;padding:3px 8px;border-radius:100px;background:#ffffff14;color:#c8bb95;border:1px solid #ffffff22;white-space:nowrap}
.tag.owned{background:#4d8a5c33;color:#bfe9c8;border-color:#7fd49a55}
.panel-note{margin:10px 0 0;font-size:10px;line-height:1.7;color:#9fb39f;text-align:center}
.menu-actions{gap:8px!important;margin-top:14px!important}

/* ---- contextual action prompt (which move clears the next obstacle) ---- */
.action-cue{position:absolute;left:50%;bottom:126px;transform:translateX(-50%);z-index:3;padding:6px 14px;border-radius:100px;background:#0d1712e6;color:#ffe9b8;font-weight:800;font-size:13px;letter-spacing:.06em;border:2px solid #ffd37a88;box-shadow:0 6px 16px rgba(0,0,0,.55);pointer-events:none}

/* ---- revive / menu buttons on the result screen ---- */
.revive-row{margin:10px 0 4px;display:flex;flex-direction:column;align-items:center;gap:6px}
.revive{background:linear-gradient(180deg,#e8c778,#c9963c)!important;color:#221a08!important;border:1px solid #8a6421!important;box-shadow:0 6px 18px rgba(0,0,0,.5),inset 0 1px 0 rgba(255,255,255,.5)!important}
.revive .cost{display:inline-flex;align-items:center;gap:4px;margin-left:8px;padding:1px 8px;border-radius:100px;background:#3a2a0d;color:#ffd98d;font-size:13px;font-weight:800}
.revive.disabled{filter:grayscale(.75);opacity:.6;pointer-events:none}
.revive-note{margin:0;font-size:11px;letter-spacing:.04em;color:#cdbfa0;opacity:.85}
.ghost{margin-top:8px;padding:8px 16px;border-radius:10px;font:inherit;font-weight:700;font-size:13px;letter-spacing:.04em;background:rgba(12,20,15,.55)!important;border:1px solid rgba(230,192,122,.45)!important;color:#e6c07a!important;box-shadow:none!important;cursor:pointer}

/* ---- character store ---- */
.store-btn{padding:6px 12px;border-radius:9px;border:1px solid rgba(230,192,122,.5);background:rgba(230,192,122,.16);color:#f0dcae;font:inherit;font-weight:700;font-size:12px;cursor:pointer}
.store-btn.buy::before{content:"◆ ";color:#ffd24a}
.store-btn.disabled{opacity:.45;cursor:not-allowed}
.store-btn.equip{background:transparent}

/* ---- character avatars in store ---- */
.store-row{display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:10px}
.char-av{width:42px;height:42px;border-radius:10px;flex:none;background-color:#22302a;background-position:center;background-size:cover;background-repeat:no-repeat;border:1px solid rgba(255,255,255,.14);box-shadow:inset 0 0 0 1px rgba(0,0,0,.25)}
.char-av.rune{display:grid;place-items:center;color:#e6c07a;font-size:16px}
.char-meta{min-width:0}

/* ---- death vignette ---- */
.death-vignette{position:absolute;inset:0;z-index:4;pointer-events:none;opacity:0;transition:opacity .4s ease;background:radial-gradient(circle at 50% 46%,transparent 24%,rgba(24,10,5,.45) 70%,rgba(8,3,2,.86) 100%)}
.death-vignette.on{opacity:1}
.result{grid-template-columns:repeat(4,1fr)!important}

/* ---- stumble impact flash ---- */
.impact-flash{position:absolute;inset:0;z-index:4;pointer-events:none;opacity:0;background:radial-gradient(circle at 50% 56%,rgba(255,150,80,.6),rgba(130,28,10,.62) 66%,rgba(24,5,2,.72) 100%);transition:opacity .16s linear}

/* ---- revive countdown + new best ---- */
.revive-meter{height:6px;margin:9px 2px 5px;border-radius:3px;background:rgba(0,0,0,.5);border:1px solid rgba(255,255,255,.16);overflow:hidden}
.revive-meter i{display:block;height:100%;width:100%;background:linear-gradient(90deg,#f8d67c,#d99a37);transition:width .1s linear}
.new-best{display:inline-block;margin:0 0 8px;padding:3px 11px;border-radius:100px;background:linear-gradient(#ffe08a,#e2a33c);color:#3a2a12;font-size:11px;font-weight:900;letter-spacing:.1em;box-shadow:0 3px 10px #0006}
/* Original-style minimal HUD: floating numbers instead of a stat card. */
.stats{top:72px;background:none;border:0;box-shadow:none;backdrop-filter:none;padding:0 2px;align-items:flex-start}
.stats i{display:none}
.stats div{min-width:0}
.stats small{color:#f0dfae;font-size:9px;letter-spacing:.2em;text-shadow:0 1px 8px #000c,0 0 2px #000a}
.stats strong{font-size:29px;color:#fff;text-shadow:0 2px 12px #000d,0 0 3px #000b}
.stats div:first-child strong{color:#ffe9b4;font-size:31px}
.stats span{color:#f0dfae;text-shadow:0 1px 8px #000c}
#coins{color:#ffd76a}
.stats div:nth-child(1){order:2;flex:1;text-align:center}
.stats div:nth-child(2){order:1;text-align:left;min-width:72px}
.stats div:nth-child(3){order:3;text-align:right;min-width:72px}
.stats div:nth-child(1),.stats div:nth-child(2),.stats div:nth-child(3){order:0}
.stats div:nth-of-type(1){order:2;flex:1;text-align:center}
.stats div:nth-of-type(2){order:1;text-align:left;min-width:72px}
.stats div:nth-of-type(3){order:3;text-align:right;min-width:72px}
#coins::before{content:'◉';margin-right:5px;font-size:15px;color:#ffd76a;vertical-align:3px;text-shadow:0 0 8px #ffb84d99}

/* Original Temple Run power meter: coins fill a bar that grants a random power-up. */
.power-meter{position:absolute;z-index:2;left:20px;top:150px;width:104px;height:8px;border-radius:5px;background:#121a14cc;border:1px solid #e4cd8f88;box-shadow:0 2px 8px #0007;overflow:hidden}
.power-meter i{display:block;height:100%;width:0%;border-radius:4px;background:linear-gradient(90deg,#8fe06a,#ffd75e 55%,#ff9a3d);box-shadow:0 0 8px #ffd75e88;transition:width .18s linear}
.power-meter.full{border-color:#ffe9a8;box-shadow:0 0 14px #ffd75ecc}

.multi{top:170px}
.power{top:208px!important}
@media(max-width:850px){.power-meter{top:calc(150px + env(safe-area-inset-top))}}
#coins.pop{animation:coinPop .16s ease-out}
@keyframes coinPop{0%{transform:scale(1)}45%{transform:scale(1.22)}100%{transform:scale(1)}}
/* Original TR1 power meter sprites cropped from egUI_Buttons2x.png */
.power-meter{width:128px!important;height:16px!important;padding:2px 4px!important;box-sizing:border-box;
  background:url('/assets/ui/bar-track.png') center/100% 100% no-repeat!important;border:0!important;border-radius:0!important;box-shadow:none!important;overflow:visible!important}
#powerFill{height:100%!important;background:url('/assets/ui/bar-gold.png') left center/128px 100% no-repeat!important;
  border-radius:0!important;box-shadow:none!important;transition:width .18s linear}
.coin-ico{width:19px;height:19px;vertical-align:-4px;margin-right:5px;filter:drop-shadow(0 1px 2px #0009)}
#coins::before{content:none!important}
.gem-ico{width:14px;height:14px;vertical-align:-1px;margin-right:4px;filter:drop-shadow(0 1px 2px #0009)}
/* TR1-style score plate (top right) + bag button (bottom right) */
.hud-score{position:absolute;z-index:3;top:58px;right:12px;display:flex;flex-direction:column;align-items:flex-end;
  padding:7px 13px 8px;border-radius:12px;background:linear-gradient(180deg,#3a2c1bd9,#241a10e0);
  border:2px solid #b99a5f;box-shadow:0 6px 18px #0008,inset 0 1px 0 #ffffff1f;pointer-events:none;min-width:118px}
.hud-score .score-word{height:15px;width:auto;margin-bottom:1px;filter:drop-shadow(0 1px 2px #000a)}
.hud-score > strong{font-family:"Baskerville","Times New Roman",serif;font-size:31px;line-height:1;color:#ffe9a8;
  letter-spacing:.02em;text-shadow:0 2px 0 #0000007a,0 0 12px #ffca6a55}
.hud-score .score-sub{display:flex;gap:11px;margin-top:4px;font-size:13px;font-weight:800;color:#f2e2b8}
.hud-score .score-sub span{display:flex;align-items:center;gap:3px}
.hud-score .score-sub .coin-ico{width:15px;height:15px;margin:0}
.hud-score .score-sub .gem-ico{width:12px;height:12px;margin:0}
.hidden{display:none!important}
.bag-btn{position:absolute;z-index:3;right:10px;bottom:132px;width:62px;height:78px;padding:0;border:0;background:none;
  cursor:pointer;filter:drop-shadow(0 4px 10px #0009);display:none}
.bag-btn img{width:100%;height:100%;object-fit:contain}
.bag-btn:active{transform:scale(.95)}
@media(max-width:850px){.hud-score{top:calc(54px + env(safe-area-inset-top));right:8px;padding:6px 11px 7px;min-width:104px}
  .hud-score > strong{font-size:26px}.hud-score .score-word{height:13px}
  .bag-btn{width:52px;height:66px;bottom:calc(120px + env(safe-area-inset-bottom))}}
#panelOverlay{z-index:6}
.bag-btn{width:70px;height:88px}
@media(max-width:850px){.bag-btn{width:62px;height:78px;bottom:calc(126px + env(safe-area-inset-bottom))}}
/* original TR1 orange swipe arrows in the turn cue */
.turn-cue .cue-arrow{width:78px;height:auto;margin:2px auto 3px;display:block;filter:drop-shadow(0 2px 3px #0009)}
.turn-cue.ready .cue-arrow{width:60px;opacity:.9}
/* pause button restyled like the original carved plate */
#pauseBtn{width:44px;height:40px;border-radius:10px;border:2px solid #b99a5f;background:linear-gradient(180deg,#3a2c1bd9,#241a10e0);
  font-size:0;position:relative;box-shadow:0 4px 12px #0008,inset 0 1px 0 #ffffff22}
#pauseBtn::before,#pauseBtn::after{content:"";position:absolute;top:50%;transform:translateY(-50%);width:6px;height:18px;border-radius:2px;background:#f4ecd8;box-shadow:0 0 6px #ffdf9a66}
#pauseBtn::before{left:13px}
#pauseBtn::after{right:13px}
.turn-cue{width:236px!important}
.turn-cue strong{white-space:nowrap;font-size:17px!important}
.turn-cue small{white-space:nowrap;font-size:9px!important}
.turn-cue .cue-arrow{width:70px!important}
/* Original TR1 tutorial overlay (art cropped from Tutorial.png) */
.tutorial{position:absolute;inset:0;z-index:4;display:flex;flex-direction:column;align-items:center;justify-content:center;
  gap:7px;background:radial-gradient(circle at 50% 40%,#0f1c16e6,#0a1410f2);pointer-events:none;
  transition:opacity .45s ease}
.tutorial img{max-width:100%;-webkit-user-drag:none;filter:drop-shadow(0 3px 6px #000a)}
.tutorial .tut-ready{width:74%;max-width:290px}
.tutorial .tut-turn{width:78%;max-width:305px}
.tutorial .tut-row{display:flex;align-items:flex-start;gap:10px;justify-content:center;width:86%;max-width:330px}
.tutorial .tut-row img{width:calc(50% - 5px)}
.tutorial .tut-meter{width:72%;max-width:285px}
@media(max-width:850px){.tutorial{gap:6px}.tutorial .tut-ready{width:70%}.tutorial .tut-turn{width:74%}
  .tutorial .tut-row{width:82%}.tutorial .tut-meter{width:68%}}
.tutorial .tut-ready{height:17%;width:auto;max-width:86%}
.tutorial .tut-turn{height:21%;width:auto;max-width:88%}
.tutorial .tut-row{height:30%;width:auto;max-width:86%}
.tutorial .tut-row img{height:100%;width:auto}
.tutorial .tut-meter{height:14%;width:auto;max-width:80%}
/* bottom-right rail: original bag above original pause plate */
.right-rail{position:absolute;z-index:3;right:10px;bottom:calc(118px + env(safe-area-inset-bottom));display:flex;flex-direction:column;align-items:center;gap:9px}
.bag-btn{position:static!important;display:block!important;right:auto!important;bottom:auto!important}
#pauseBtn{width:46px!important;height:42px!important;border-radius:11px!important;border:2px solid #b99a5f!important;
  background:linear-gradient(180deg,#3a2c1bd9,#241a10e0)!important;box-shadow:0 4px 12px #0008,inset 0 1px 0 #ffffff22!important}
#pauseBtn::before,#pauseBtn::after{content:"";position:absolute;top:50%;transform:translateY(-50%);width:6px;height:18px;border-radius:2px;background:#f4ecd8;box-shadow:0 0 6px #ffdf9a66}
#pauseBtn::before{left:14px}
#pauseBtn::after{right:14px}
#pauseBtn{font-size:0!important;position:relative}
@media(max-width:850px){.right-rail{right:8px;bottom:calc(112px + env(safe-area-inset-bottom));gap:7px}
  .bag-btn{width:58px!important;height:72px!important}
  #pauseBtn{width:42px!important;height:38px!important}}
@media(max-width:850px){
  #pauseBtn{width:46px!important;height:40px!important}
  #pauseBtn::before{left:13px!important}
  #pauseBtn::after{right:13px!important}
}
/* Original PLAY! art inside the menu start button */
.play-btn{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:1px;min-height:66px;position:relative;padding:8px 18px}
.play-btn .play-art{height:31px;width:auto;filter:drop-shadow(0 2px 3px #00000055)}
.play-btn .play-cn{font-size:9px;letter-spacing:.22em;font-weight:800;color:#4a3418;opacity:.85}
.play-btn>span{position:absolute;right:16px;top:50%;transform:translateY(-50%);font-size:20px}
/* Upgrades section inside the STORE panel (original UPGRADES wordmark) */
.up-title{display:block;width:min(74%,230px);margin:16px auto 10px;filter:drop-shadow(0 2px 4px #0008)}
.up-row{align-items:center}
.up-meta{flex:1;display:flex;flex-direction:column;gap:4px;min-width:0}
.up-name{font-weight:800;font-size:13px;color:#f2e6c8;display:flex;flex-direction:column;gap:1px}
.up-name small{font-weight:600;font-size:10px;color:#c9bb95;letter-spacing:.02em}
.up-dots{display:flex;align-items:center;gap:4px}
.up-dot{width:7px;height:7px;border-radius:50%;background:#ffffff26;border:1px solid #ffffff33}
.up-dot.on{background:#ffd76a;border-color:#ffe6a6;box-shadow:0 0 6px #ffd76a88}
.up-dots em{font-style:normal;font-size:9px;color:#c9bb95;margin-left:3px;letter-spacing:.04em}
/* Objectives panel */
.obj-row{align-items:center}
.obj-meta{flex:1;display:flex;flex-direction:column;gap:4px;min-width:0}
.obj-name{font-weight:800;font-size:13px;color:#f2e6c8;display:flex;flex-direction:column;gap:1px}
.obj-name small{font-weight:600;font-size:10px;color:#c9bb95}
.obj-bar{display:block;height:5px;border-radius:100px;background:#ffffff1c;overflow:hidden}
.obj-bar i{display:block;height:100%;background:linear-gradient(90deg,#e7c46a,#fff3c4);border-radius:100px;transition:width .3s}
.obj-now{font-size:9px;color:#b8aa86;letter-spacing:.03em}
.obj-right{display:flex;flex-direction:column;align-items:flex-end;gap:4px;min-width:66px}
.obj-reward{display:flex;align-items:center;gap:3px;font-size:11px;font-weight:800;color:#ffd76a}
.obj-reward .gem-ico{width:12px;height:12px}
.obj-pct{font-size:10px;font-weight:800;color:#c9bb95}
.store-btn.claim{background:linear-gradient(#f6cf74,#dc9c36);color:#3a2a12;font-weight:900}
.menu-art-btn img{max-width:100%}
.store-btn.buy.gem{display:inline-flex;align-items:center;gap:4px;color:#ffd76a}
/* SHOP / UPGRADES tabs inside the STORE panel */
.store-tabs{display:flex;align-items:center;justify-content:center;gap:14px;margin:2px 0 10px}
.store-tab{background:none;border:0;padding:2px 4px 6px;cursor:pointer;opacity:.5;filter:grayscale(.25);border-bottom:2px solid transparent;transition:opacity .18s,border-color .18s}
.store-tab img{height:19px;width:auto;display:block;filter:drop-shadow(0 2px 3px #0007)}
.store-tab.on{opacity:1;filter:none;border-bottom-color:#ffd76a}
.store-tab:active{transform:translateY(1px)}
/* Original "NICE JOB!" milestone banner */
.milestone{position:absolute;z-index:4;left:50%;top:43%;transform:translateX(-50%);display:flex;flex-direction:column;align-items:center;gap:2px;pointer-events:none;text-align:center}
.milestone .nj-art{height:46px;width:auto;filter:drop-shadow(0 4px 10px #000a)}
.milestone span{font:800 22px/1 "Georgia",serif;color:#ffe6a3;letter-spacing:.06em;text-shadow:0 2px 0 #3a230e,0 0 14px #ffb84a88}
.milestone.hidden{display:none}
.milestone.pop .nj-art{animation:nj-pop .5s cubic-bezier(.2,1.6,.4,1) both}
.milestone.pop span{animation:nj-fade .6s ease both}
@keyframes nj-pop{0%{transform:scale(.5) rotate(-4deg);opacity:0}60%{transform:scale(1.08) rotate(1deg);opacity:1}100%{transform:scale(1) rotate(0);opacity:1}}
@keyframes nj-fade{0%{opacity:0;transform:translateY(6px)}100%{opacity:1;transform:none}}
/* Original TRY AGAIN! art on the end-screen restart button */
.tryagain-btn{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:1px;min-height:64px;position:relative;padding:8px 16px}
.tryagain-btn .tryagain-art{height:26px;width:auto;filter:drop-shadow(0 2px 3px #00000055)}
.tryagain-btn small{font-size:9px;letter-spacing:.2em;font-weight:800;color:#4a3418;opacity:.85}
.tryagain-btn>span{position:absolute;right:14px;top:50%;transform:translateY(-50%);font-size:19px}
/* original orange wings icon on the revive button */
.revive .revive-wings{height:26px;width:auto;margin-right:7px;vertical-align:-7px;filter:drop-shadow(0 2px 3px #00000055)}
.revive #reviveLabel{float:none!important;display:inline-block!important;font-size:17px;font-weight:800;vertical-align:-4px;margin-right:8px}
.revive .revive-wings{vertical-align:-8px}
/* Mobile: keep the game from scrolling / rubber-banding / text-selecting while swiping */
html,body{overscroll-behavior:none;touch-action:manipulation;-webkit-user-select:none;user-select:none;-webkit-tap-highlight-color:transparent}
body{position:fixed;inset:0;overflow:hidden}
.app{height:100dvh;min-height:0}
/* Portrait-only hint for phones held sideways */
.rotate-hint{display:none;position:fixed;inset:0;z-index:99;place-items:center;background:radial-gradient(circle at 50% 40%,#2b4136 0,#0c1512 70%);text-align:center}
.rotate-card{display:flex;flex-direction:column;align-items:center;gap:10px;color:#f4e3b4}
.rotate-icon{font-size:52px;color:#f0b74e;text-shadow:0 0 22px #f0a93b88}
.rotate-card strong{font-size:22px;letter-spacing:.12em}
.rotate-card small{font-size:10px;letter-spacing:.32em;color:#cdb98a}
@media (orientation:landscape) and (max-height:560px) and (max-width:1000px){.rotate-hint{display:grid}}
/* Original power-up icons in the HUD badge + activation toast */
.power .pw-ico{width:16px;height:16px;vertical-align:-3px;margin-right:5px}
.power-toast{position:absolute;z-index:4;left:50%;top:14%;transform:translateX(-50%);display:flex;align-items:center;gap:9px;
  padding:9px 16px;border-radius:100px;background:#142316ee;border:2px solid #ffd76a;box-shadow:0 8px 26px #000a;
  font-size:15px;font-weight:800;color:#ffe9b0;pointer-events:none;white-space:nowrap}
.power-toast.hidden{display:none}
.power-toast img{width:26px;height:26px;filter:drop-shadow(0 2px 3px #0008)}
.power-toast.pop{animation:ptPop .42s cubic-bezier(.2,1.5,.5,1)}
@keyframes ptPop{0%{opacity:0;transform:translateX(-50%) scale(.7)}100%{opacity:1;transform:translateX(-50%) scale(1)}}
/* Original parchment scroll buttons on the end screen (store / objectives) */
.end-rail{display:flex;justify-content:center;gap:16px;margin:12px 0 8px}
.scroll-btn{background:none;border:0;padding:0;cursor:pointer;width:86px;filter:drop-shadow(0 6px 12px #0008);transition:transform .16s,filter .16s}
.scroll-btn img{width:100%;height:auto;display:block}
.scroll-btn:active{transform:translateY(3px) scale(.97)}
.scroll-btn:hover{filter:drop-shadow(0 8px 16px #000c) brightness(1.06)}
/* Keep the end card compact now that it carries parchment scroll buttons */
#endOverlay .card{padding-top:14px!important;padding-bottom:16px!important}
#endOverlay .death-art{max-height:104px;width:auto;max-width:78%;margin:-2px auto 0}
#endOverlay .card h2{font-size:34px!important;margin:6px 0 8px!important}
#endOverlay .lead{margin-bottom:8px!important;line-height:1.5!important;font-size:12px!important}
#endOverlay .result{padding:10px 0!important;margin:8px 0 6px!important}
#endOverlay .revive-row{margin:4px 0 2px!important;gap:3px!important}
#endOverlay .revive{min-height:44px!important}
#endOverlay .tryagain-btn{min-height:52px!important;padding:5px 14px!important}
#endOverlay .tryagain-btn .tryagain-art{height:22px}
#endOverlay .end-rail{margin:6px 0 2px!important;gap:14px!important}
#endOverlay .scroll-btn{width:70px}
#endOverlay .ghost{margin-top:6px!important}
.store-btn.buy.gem::before{content:none!important}
/* Small hint shown until the browser allows audio (first user gesture). */
.audio-hint{margin:8px 0 0;font-size:11px;letter-spacing:.06em;color:#e8cf9a;opacity:.85;text-align:center;animation:audioHintPulse 2.4s ease-in-out infinite}
.audio-hint.hidden{display:none}
@keyframes audioHintPulse{0%,100%{opacity:.55}50%{opacity:.95}}
/* Lifetime / banked coin summaries */
.menu-coins{margin:10px 0 0;font-size:12px;letter-spacing:.08em;color:#d9c79c;text-align:center}
.menu-coins b{color:#ffd76a;font-weight:800}
.end-total{margin:2px 0 6px;font-size:11.5px;letter-spacing:.05em;color:#cdbfa0;text-align:center}
.end-total b{color:#ffd98d}
/* Run stats inside the pause card */
.pause-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin:14px 0 16px;padding:10px 6px;border-top:1px solid rgba(255,255,255,.12);border-bottom:1px solid rgba(255,255,255,.12)}
.pause-stats div{display:flex;flex-direction:column;gap:3px;align-items:center}
.pause-stats small{font-size:10px;letter-spacing:.08em;color:#cdbfa0;opacity:.85}
.pause-stats strong{font-size:17px;font-weight:800;color:#ffe0a0}
/* Sound toggle: musical note with a strike when muted */
#soundBtn.muted{color:#8d8570!important;position:relative}
#soundBtn.muted::after{content:"";position:absolute;left:50%;top:50%;width:22px;height:2px;background:#d8b877;transform:translate(-50%,-50%) rotate(-42deg);border-radius:2px;box-shadow:0 0 2px #0008}
/* LAN QR card in the desktop side panel */
.qr-card{display:flex;gap:14px;align-items:center;margin:16px 0 18px;padding:14px;border-radius:16px;background:linear-gradient(180deg,rgba(28,44,32,.72),rgba(18,30,24,.72));border:1px solid rgba(232,206,140,.28);box-shadow:0 12px 30px #00000033}
.qr-img{width:104px;height:104px;border-radius:8px;image-rendering:pixelated;box-shadow:0 4px 12px #0006}
.qr-meta{display:flex;flex-direction:column;gap:5px;min-width:0}
.qr-meta strong{font-size:12.5px;letter-spacing:.04em;color:#f3e2b4}
.qr-meta span{font-size:11px;line-height:1.45;color:#cdbfa0;opacity:.9}
.qr-meta code{font-size:10.5px;letter-spacing:.02em;color:#ffd98d;background:#00000045;border:1px solid #ffffff22;border-radius:6px;padding:3px 6px;user-select:all}
@media (max-width:850px){.qr-card{display:none}}
.tut-tip{margin:10px 0 0;font-size:12px;letter-spacing:.16em;color:#ffe9b8;text-shadow:0 2px 6px #000a;animation:tutPulse 1.6s ease-in-out infinite}
@keyframes tutPulse{0%,100%{opacity:.65}50%{opacity:1}}
.mini-btn{padding:7px 12px;border-radius:999px;background:linear-gradient(180deg,#e8c778,#c9963c);color:#221a08;border:1px solid #8a6421;font-weight:800;font-size:11px;letter-spacing:.14em;cursor:pointer}
.mini-btn:active{transform:translateY(2px)}
/* Store: per-character voice preview */
.char-voice{width:22px;height:22px;flex:0 0 auto;margin:0 6px 0 -2px;border-radius:50%;border:1px solid #8d7c52;background:#2b2a1ecc;color:#f0d79a;font-size:12px;line-height:1;display:grid;place-items:center;cursor:pointer;font-family:inherit}
.char-voice:hover{background:#3c3927;border-color:#c9ad72}
.char-voice:active{transform:scale(.92)}
/* Keep store rows on one line after adding the voice preview button */
.store-row{display:flex!important;align-items:center!important;gap:8px!important;flex-wrap:nowrap!important}
.store-row .char-av{flex:0 0 34px}
.store-row .char-meta{flex:1 1 auto;min-width:0;line-height:1.25}
.store-row .char-meta small{display:block;font-size:10px;opacity:.7}
.store-row > :last-child{flex:0 0 auto}
/* Original gold numerals (FontAtlas2x) for HUD score / coins */
.num{display:inline-flex!important;align-items:flex-end;gap:1px;line-height:1}
.num img{display:block;width:auto;filter:drop-shadow(0 2px 2px #0006);margin:0}
.num.num-lg img{height:30px}
.num.num-sm img{height:15px}
.num.num-md img{height:21px}
#score.num{justify-content:center;width:100%}
.num span{font-size:.62em;font-weight:800;color:#f4dda2;letter-spacing:.02em}
#coins.num{gap:0}
/* On phone widths keep the big gold numerals inside the score plate */
@media(max-width:850px){.num.num-lg img{height:26px}.num.num-lg{gap:0}}
/* numHTML inside templates */
.num .num-img{height:15px;width:auto;display:inline-block;vertical-align:-2px;margin:0 .5px}
.num.num-sm .num-txt{font-size:10px;font-weight:700;color:#e9d49b;margin-left:1px}
.stat-row b .num .num-img{height:14px;vertical-align:-2px}
.store-btn .num .num-img{height:13px;vertical-align:-2px}
.store-btn .num .num-txt{font-size:11px}
/* Boost speed lines: edge-only streaks while the boost power-up is active */
.speedlines{position:absolute;inset:0;z-index:2;pointer-events:none;opacity:0;transition:opacity .18s ease;
  background:repeating-linear-gradient(90deg,transparent 0 24px,rgba(255,240,205,.16) 24px 26px);
  -webkit-mask-image:radial-gradient(ellipse at 50% 46%,transparent 40%,#000 86%);
  mask-image:radial-gradient(ellipse at 50% 46%,transparent 40%,#000 86%)}
.speedlines.on{opacity:.85;animation:streakMove .32s linear infinite}
@keyframes streakMove{from{background-position:0 0}to{background-position:48px 0}}
@media(prefers-reduced-motion:reduce){.speedlines.on{animation:none;opacity:.5}}
/* Collected coins/gems physically fly into the HUD counter */
.fly-coin{position:fixed;width:24px;height:24px;margin:-12px 0 0 -12px;z-index:9;pointer-events:none;
  filter:drop-shadow(0 0 5px #ffcf5a);transition:transform .38s cubic-bezier(.35,0,.55,1),opacity .38s ease-out}
/* Original gold arrow art on the touch/mouse control pads */
.controls button img{display:block;margin:0 auto;filter:drop-shadow(0 1px 1px #000a)}
.controls #leftBtn img,.controls #rightBtn img{width:30px;height:auto}
.controls #slideBtn img,.controls #jumpBtn img{height:34px;width:auto}
.controls button{padding:0!important;display:flex!important;align-items:center!important;justify-content:center!important}
@media(max-width:850px){
  .controls #leftBtn img,.controls #rightBtn img{width:26px}
  .controls #slideBtn img,.controls #jumpBtn img{height:30px}
}
/* Warm edge flash when a turn is completed cleanly */
.turn-glow{position:absolute;inset:0;z-index:4;pointer-events:none;opacity:0;
  background:radial-gradient(ellipse at 50% 55%,rgba(255,214,150,0) 42%,rgba(255,196,110,.32) 78%,rgba(255,170,70,.55) 100%);
  mix-blend-mode:screen}
/* Control pads: tactile press feedback */
.controls button{transition:transform .09s ease,box-shadow .09s ease,background .09s ease}
.controls button.hit,.controls button:active{transform:scale(.92);background:radial-gradient(circle at 50% 40%,#ffe0a0cc,#c99a4a55 60%,#0000 72%)!important;box-shadow:inset 0 0 16px #000a,0 0 12px #ffcf7a66}
/* Every UI button reacts on press (menus, store rows, overlays) */
button{transition:transform .1s ease,filter .1s ease,box-shadow .1s ease}
button.hit{transform:scale(.96);filter:brightness(1.1)}
button.primary.hit,button.play-btn.hit{box-shadow:0 0 18px #ffcf7a88,inset 0 0 12px #fff4}
.menu-art-btn.hit{filter:brightness(1.35) drop-shadow(0 0 6px #ffcf7a)}
.store-btn.hit{filter:brightness(1.2)}
/* Long scores must stay inside the HUD plate */
.num.num-lg.long img{height:23px}
.num.num-lg.longer img{height:19px}
/* Milestone banner: gold plaque that pops in and floats above the road */
.milestone{top:41%!important;padding:12px 26px 10px!important;gap:6px!important;
  background:linear-gradient(180deg,#2b2013ee,#150f08ee);border:2px solid #d9b375;border-radius:16px;
  box-shadow:0 12px 30px #000b,inset 0 0 22px #ffce7a26,0 0 0 1px #0006;animation:msPop .34s cubic-bezier(.2,1.5,.4,1)}
.milestone.pop{animation:msPop .34s cubic-bezier(.2,1.5,.4,1)}
.milestone .nj-art{height:42px!important;filter:drop-shadow(0 3px 0 #3a230e) drop-shadow(0 5px 12px #000a)}
.milestone #milestoneText{display:flex!important;align-items:baseline;justify-content:center;gap:2px}
.milestone #milestoneText .unit{margin-left:4px;font:700 15px/1 Georgia,serif;color:#ffe6a3;letter-spacing:.04em;text-shadow:0 2px 0 #3a230e}
@keyframes msPop{0%{transform:translateX(-50%) scale(.62);opacity:0}60%{transform:translateX(-50%) scale(1.06);opacity:1}100%{transform:translateX(-50%) scale(1);opacity:1}}

/* Edge-of-screen turn arrow: slides in when a junction is close and not yet confirmed */
.turn-edge{position:absolute;top:44%;z-index:3;display:flex;align-items:center;gap:6px;pointer-events:none;
  padding:6px 10px;border-radius:14px;background:#2c1d13e0;border:1.5px solid #ffcf7a;box-shadow:0 0 18px #ff9d3c88;
  opacity:0;transition:opacity .18s ease,transform .22s ease;font-size:12px;font-weight:800;color:#ffdf9b;letter-spacing:.06em}
.turn-edge.left{left:-6px;transform:translateX(-26px)}
.turn-edge.right{right:-6px;transform:translateX(26px)}
.turn-edge.show{opacity:1;transform:translateX(0)}
.turn-edge img{width:26px;height:auto;filter:drop-shadow(0 0 4px #ffb44a)}
.turn-edge.ready{background:#1e3a1ee0;border-color:#a8e88d;color:#d7ffc0;box-shadow:0 0 18px #7ad06a88}
@media(max-width:850px){.power-toast{top:64px}}
/* Store 3D character preview */
.char-preview{position:relative;height:172px;margin:2px 0 8px;border-radius:12px;overflow:hidden;
  background:radial-gradient(120% 90% at 50% 20%,#3a4a3c 0%,#1b241d 60%,#11170f 100%);
  border:1px solid #7d6a4633;box-shadow:inset 0 0 34px #0009}
.char-preview canvas{display:block;width:100%;height:100%}
.char-preview .cp-name{position:absolute;left:10px;bottom:8px;font-size:12px;letter-spacing:.14em;
  color:#f4e2b6;text-shadow:0 1px 3px #000c;text-transform:uppercase}
.char-preview .cp-hint{position:absolute;right:10px;bottom:8px;font-size:10px;letter-spacing:.1em;color:#f4e2b699}
.char-preview .cp-stats{position:absolute;left:10px;top:8px;display:flex;gap:6px}
.char-preview .cp-stats span{font-size:10px;letter-spacing:.06em;padding:2px 7px;border-radius:999px;
  background:#0d140fcc;border:1px solid #d9b36a55;color:#f0dcae}
.store-row.previewing{background:#ffd98a14;box-shadow:inset 0 0 0 1px #ffd98a33}
.store-row .char-av{cursor:pointer}
/* Panel bodies: keep the last row readable instead of slicing it in half */
.panel-body{max-height:49vh;overflow-y:auto;padding-bottom:28px;scrollbar-width:thin;
  -webkit-mask-image:linear-gradient(180deg,#000 calc(100% - 18px),transparent);
  mask-image:linear-gradient(180deg,#000 calc(100% - 18px),transparent)}
.panel-body::-webkit-scrollbar{width:5px}
.panel-body::-webkit-scrollbar-thumb{background:#f2d38a66;border-radius:3px}
/* Panel open transition */
#panelOverlay .panel-card{transform-origin:50% 42%;animation:none}
#panelOverlay:not(.hidden) .panel-card{animation:panelIn .26s cubic-bezier(.2,.9,.25,1.05) both}
@keyframes panelIn{0%{opacity:0;transform:translateY(14px) scale(.96)}100%{opacity:1;transform:none}}
#panelOverlay:not(.hidden){animation:panelFade .2s ease both}
@keyframes panelFade{0%{opacity:0}100%{opacity:1}}
/* Store list: keep the character rows comfortable inside the scroll area */
.char-row{min-height:52px}
.panel-body .char-row:last-child{margin-bottom:2px}
/* Panel close transition */
#panelOverlay.closing{animation:panelFadeOut .16s ease both}
#panelOverlay.closing .panel-card{animation:panelOut .17s cubic-bezier(.4,0,.7,.4) both}
@keyframes panelFadeOut{0%{opacity:1}100%{opacity:0}}
@keyframes panelOut{0%{opacity:1;transform:none}100%{opacity:0;transform:translateY(10px) scale(.97)}}
/* Store badge grading */
.store-row .state-badge.owned{background:#2f5c3bcc;border-color:#9fe0a8;color:#d8f7d0}
.store-row .state-badge.unlocked{background:#54502acc;border-color:#e8d48a;color:#f7ecc8}
.store-row .state-badge.locked{background:#3a2a2acc;border-color:#b98c8c;color:#f0c9c9}
/* Store button/badge grading: equipped (green), affordable (gold), locked (muted red) */
.store-row .tag.owned{background:#2f5c3bcc;border-color:#9fe0a8;color:#d8f7d0}
.store-row .store-btn.buy{background:#3a3322cc;border-color:#e2c07a;color:#f7e5bd;box-shadow:inset 0 0 10px #ffcf7a22}
.store-row .store-btn.buy.disabled{opacity:.62;border-color:#9a6a5a;color:#e0b0a8;background:#33262acc;filter:saturate(.5) brightness(.85)}
.store-row .store-btn.equip{background:#2f5c3bcc;border-color:#9fe0a8;color:#dcf7d4}
/* Upgrades: segmented level pips + effect preview */
.up-row .up-meta{gap:5px}
.up-row .up-dots .up-dot{width:20px;height:7px;border-radius:3px;background:#3a3a2a;border:1px solid #6b5c3a}
.up-row .up-dots .up-dot.on{background:linear-gradient(180deg,#ffe9a8,#d8a944);border-color:#f2d38a;box-shadow:0 0 6px #ffcf7a66}
.up-row .up-effect{display:block;font-size:10px;color:#c8d6bd;letter-spacing:.02em;margin-top:2px}
.up-row .up-effect b{color:#f2d38a}
.up-row.max{background:linear-gradient(90deg,#2f5c3b22,#0000);border-left:2px solid #9fe0a8}
.up-row.max .up-name small{color:#a8dcb0}
/* "NEW" badge for recently added characters */
.char-name{display:inline-flex;align-items:center;gap:6px}
.new-tag{font-style:normal;font-size:9px;letter-spacing:.12em;padding:1px 5px;border-radius:7px;
  background:linear-gradient(180deg,#ff9a5a,#d64a2a);color:#fff6e8;box-shadow:0 0 8px #ff7a3a66}
@media(max-width:850px){.power-meter{top:calc(116px + env(safe-area-inset-top))!important}}
/* Keep the four menu word-arts on a single row on every viewport. */
.menu-actions{display:flex;flex-wrap:nowrap;justify-content:center;gap:6px;align-items:center}
.menu-actions img{height:15px;width:auto}
/* Last-metres pulse: the edge arrow throbs when the junction is imminent. */
.turn-edge.urgent{animation:edgeGlow .42s ease-in-out infinite alternate}
@keyframes edgeGlow{from{box-shadow:0 0 14px #ff9d3c66;filter:brightness(1)}to{box-shadow:0 0 28px #ffb44acc;filter:brightness(1.3)}}
