import * as THREE from 'three';
import { RoundedBoxGeometry } from 'three/addons/geometries/RoundedBoxGeometry.js';
import { OBJLoader } from 'three/addons/loaders/OBJLoader.js';
import './style.css';

const $ = (id) => document.getElementById(id);
const asset=(name)=>`${import.meta.env.BASE_URL}assets/apk/${name}`;
let audioContext, muted=false;
function tone(frequency,duration=.1,type='sine',volume=.05){
  if(muted)return;
  try{
    audioContext ||= new (window.AudioContext||window.webkitAudioContext)();
    if(audioContext.state==='suspended')audioContext.resume();
    const oscillator=audioContext.createOscillator(),gain=audioContext.createGain();
    oscillator.type=type;oscillator.frequency.setValueAtTime(frequency,audioContext.currentTime);
    gain.gain.setValueAtTime(volume,audioContext.currentTime);
    gain.gain.exponentialRampToValueAtTime(.001,audioContext.currentTime+duration);
    oscillator.connect(gain).connect(audioContext.destination);
    oscillator.start();oscillator.stop(audioContext.currentTime+duration);
  }catch{}
}
const canvas = $('scene');
const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, powerPreference: 'high-performance' });
renderer.setPixelRatio(Math.min(devicePixelRatio || 1, 2));
renderer.outputColorSpace = THREE.SRGBColorSpace;
renderer.toneMapping = THREE.ACESFilmicToneMapping;
renderer.toneMappingExposure = 1.35;
renderer.shadowMap.enabled = true;
renderer.shadowMap.type = THREE.PCFSoftShadowMap;
const scene = new THREE.Scene();
scene.background = new THREE.Color(0x899786);
scene.fog = new THREE.FogExp2(0x87998a, 0.017);
const camera = new THREE.PerspectiveCamera(60, 1, .1, 190);
camera.position.set(0, 5.8, 11.5);
camera.lookAt(0, 1.4, -15);
scene.add(new THREE.HemisphereLight(0xcadad0, 0x56442e, 2.15));
const sun = new THREE.DirectionalLight(0xffd59a, 3.1);
sun.position.set(-12, 22, -24);
sun.castShadow = true;
sun.shadow.mapSize.set(1024, 1024);
sun.shadow.camera.left = -20; sun.shadow.camera.right = 20;
sun.shadow.camera.top = 25; sun.shadow.camera.bottom = -25;
sun.shadow.camera.near = 1; sun.shadow.camera.far = 70;
scene.add(sun);
const fill = new THREE.DirectionalLight(0x8ac5b2, 1.1); fill.position.set(10, 8, 8); scene.add(fill);
const material = (color, options={}) => new THREE.MeshStandardMaterial({color,roughness:.86,...options});
const mats = {
  stone:material(0x837c65), edge:material(0xb7a98a), seam:material(0x544c3c),
  moss:material(0x496f4c), leaf:material(0x3c7451,{side:THREE.DoubleSide}),
  darkLeaf:material(0x254d3f), bark:material(0x554a34), gold:material(0xf5bb43,{metalness:.72,roughness:.25,emissive:0x6b4309,emissiveIntensity:.3}),
  goldLight:material(0xffdf7d,{emissive:0x9b6118,emissiveIntensity:.5}),
  red:material(0xae4135), fire:material(0xff8334,{emissive:0xff6820,emissiveIntensity:2}),
  black:material(0x1a231c), skin:material(0xb87751), shirt:material(0xd6b388), pants:material(0x554839),
  belt:material(0x433025), hair:material(0x34291f), eye:material(0x161713),
};
const textureLoader=new THREE.TextureLoader();
const roadAtlas=textureLoader.load(asset('wallTexture.png'));roadAtlas.colorSpace=THREE.SRGBColorSpace;
roadAtlas.offset.set(0,.755);roadAtlas.repeat.set(.5,.235);
const wallStoneAtlas=textureLoader.load(asset('wallTexture.png'));wallStoneAtlas.colorSpace=THREE.SRGBColorSpace;
wallStoneAtlas.offset.set(.5,.755);wallStoneAtlas.repeat.set(.24,.235);
const roadTextureMat=material(0xffffff,{map:roadAtlas,side:THREE.DoubleSide});
const ancientStone=material(0xe3d6b7,{map:wallStoneAtlas});
const barkAtlas=textureLoader.load(asset('treeTexture.png'));barkAtlas.colorSpace=THREE.SRGBColorSpace;
barkAtlas.offset.set(.72,.53);barkAtlas.repeat.set(.25,.45);
const originalBark=material(0xc6b597,{map:barkAtlas});
const geo = {
  box:new THREE.BoxGeometry(1,1,1), sphere:new THREE.SphereGeometry(1,12,8),
  cyl:new THREE.CylinderGeometry(1,1,1,12), cone:new THREE.ConeGeometry(1,1,7),
  coin:new THREE.TorusGeometry(.31,.085,7,16),
};
function mesh(parent, geometry, mat, x=0,y=0,z=0,sx=1,sy=1,sz=1){
  const o=new THREE.Mesh(geometry,mat);o.position.set(x,y,z);o.scale.set(sx,sy,sz);parent.add(o);return o;
}
function rand(seed){const v=Math.sin(seed*128.13+21.4)*43758.5453;return v-Math.floor(v)}
const TILE=12, TILE_COUNT=12, lanes=[-2.35,0,2.35], PLAYER_Z=3;
const pathSegments=[{start:0,end:Infinity,x:0,z:PLAYER_Z,heading:0}];
function pathAt(distance,side=0){
  let segment=pathSegments[0];
  for(const candidate of pathSegments){if(distance>=candidate.start)segment=candidate;else break}
  const travel=distance-segment.start,fade=Number.isFinite(segment.end)?Math.min(1,Math.max(0,(segment.end-distance)/25)):1;
  const wave=3*(1-Math.cos(travel/25))*fade;
  const slope=3*Math.sin(travel/25)/25*fade;
  const lateral=side+wave,heading=segment.heading-Math.atan(slope);
  return {x:segment.x-Math.sin(segment.heading)*travel+Math.cos(segment.heading)*lateral,
    z:segment.z-Math.cos(segment.heading)*travel-Math.sin(segment.heading)*lateral,heading};
}
function placeOnPath(group,distance,side=0){const point=pathAt(distance,side);group.position.x=point.x;group.position.z=point.z;group.rotation.y=point.heading}
function addPathTurn(at,direction){
  const last=pathSegments[pathSegments.length-1];last.end=at;const point=pathAt(at);
  pathSegments.push({start:at,end:Infinity,x:point.x,z:point.z,heading:last.heading-direction*Math.PI/2});
}
const world=new THREE.Group();scene.add(world);
const tiles=[];
function createTree(parent,x,z,seed){
  const h=3.1+rand(seed)*3.6;
  const trunk=mesh(parent,geo.cyl,originalBark,x,h*.42,z,.2,h*.85,.2);trunk.castShadow=true;
  for(let i=0;i<4;i++){
    const crown=mesh(parent,geo.sphere,i%2?mats.leaf:mats.darkLeaf,x+(rand(seed+i+4)-.5)*1.8,h*.7+i*.38,z+(rand(seed+i+15)-.5)*1.5,1.5-i*.13,.85,1.2);
    crown.castShadow=i===0;
  }
  for(let i=0;i<3;i++){
    const vine=mesh(parent,geo.cyl,mats.moss,x+(i-1)*.7,h*.57,z+.45,.025,1.8,.025);vine.rotation.z=(i-1)*.25;
  }
}
function createTorch(parent,x,z){
  mesh(parent,geo.cyl,mats.seam,x,1.15,z,.13,2.3,.13).castShadow=true;
  mesh(parent,geo.cyl,mats.edge,x,2.25,z,.32,.21,.32);
  const flame=mesh(parent,geo.cone,mats.fire,x,2.6,z,.24,.6,.24);flame.rotation.z=Math.PI;
  return flame;
}
const flames=[];
for(let i=0;i<TILE_COUNT;i++){
  const group=new THREE.Group();group.pathDistance=-9+i*TILE;placeOnPath(group,group.pathDistance);world.add(group);
  const road=mesh(group,new RoundedBoxGeometry(8.3,.65,TILE+.12,2,.08),mats.stone,0,-.38,0);road.receiveShadow=true;
  const paving=mesh(group,new THREE.PlaneGeometry(8.05,TILE),roadTextureMat,0,-.035,0);paving.rotation.x=-Math.PI/2;paving.receiveShadow=true;
  for(const x of [-4.2,4.2]){
    const rim=mesh(group,geo.box,mats.edge,x,.03,0,.28,.48,TILE);rim.castShadow=true;
    for(const dz of [-4.5,-1.5,1.5,4.5]) mesh(group,geo.box,mats.seam,x*1.04,-.2,dz,.25,.75,.13);
  }
  for(const x of [-1.18,1.18]) mesh(group,geo.box,mats.seam,x,-.036,0,.048,.015,TILE);
  for(let j=0;j<8;j++){
    const x=(rand(i*42+j+2)-.5)*7.4;
    const z=(rand(i*42+j+12)-.5)*TILE;
    mesh(group,geo.box,j%3?mats.edge:mats.moss,x,-.038,z,.3+rand(j+i)*.6,.012,.06+rand(j+i+4)*.26).rotation.y=rand(j+i+7)*2;
  }
  const decor=new THREE.Group();group.decor=decor;group.add(decor);
  for(const side of [-1,1]){
    const x=side*(6.5+rand(i*11+side+10)*2.8);
    createTree(decor,x,-3,i*19+side+20);
    createTree(decor,x+side*2.3,3,i*17+side+31);
    const column=mesh(decor,geo.cyl,ancientStone,side*5.35,1.4,0,.6,2.8,.6);column.castShadow=true;
    mesh(decor,geo.box,mats.edge,side*5.35,2.85,0,1.55,.33,1.55);
    mesh(decor,geo.box,mats.moss,side*5.35,.15,0,1.25,.3,1.25);
    if(i%2===0)flames.push(createTorch(decor,side*4.85,3));
  }
  tiles.push(group);
}
const undergrowth=mesh(scene,geo.box,material(0x314c3d),0,-2,-60,190,2,180);undergrowth.receiveShadow=true;
const junction=new THREE.Group();junction.visible=false;scene.add(junction);
mesh(junction,geo.box,mats.stone,0,-.38,0,20,.65,7).receiveShadow=true;
for(const x of [-9.8,9.8]) mesh(junction,geo.box,mats.edge,x,.02,0,.28,.45,7);
for(const x of [-1.18,1.18]) mesh(junction,geo.box,mats.seam,x,-.03,0,.05,.015,7);
for(const side of [-1,1]){
  const marker=mesh(junction,geo.box,mats.gold,side*5.8,.18,0,.75,.22,.75);
  marker.rotation.y=Math.PI/4;
}
const enemy=new THREE.Group();scene.add(enemy);
const enemyFallback=new THREE.Group();enemy.add(enemyFallback);
for(const side of [-1,1]){
  mesh(enemyFallback,geo.sphere,mats.black,side*.65,1.1,0,.72,.88,.62).castShadow=true;
  mesh(enemyFallback,geo.sphere,mats.black,side*.65,2.04,-.22,.51,.45,.47);
  mesh(enemyFallback,geo.sphere,mats.fire,side*.65-.15,2.12,.23,.07,.08,.04);
  mesh(enemyFallback,geo.sphere,mats.fire,side*.65+.15,2.12,.23,.07,.08,.04);
}
new OBJLoader().load(asset('mesh-96-enemy.obj'),model=>{
  const tex=textureLoader.load(asset('texture-53-enemyTexture.png'));tex.colorSpace=THREE.SRGBColorSpace;tex.flipY=false;
  model.traverse(part=>{if(part.isMesh){part.material=new THREE.MeshStandardMaterial({map:tex,emissiveMap:tex,emissive:0x777777,emissiveIntensity:.42,roughness:1,side:THREE.DoubleSide});part.castShadow=true}});
  model.rotation.x=-Math.PI/2;model.scale.set(.12,.12,.18);
  enemy.add(model);enemyFallback.visible=false;
},undefined,()=>console.warn('Original enemy model unavailable; using fallback'));

// Keep a simple fallback if the extracted character cannot be loaded.
const player=new THREE.Group();player.position.set(0,0,PLAYER_Z);scene.add(player);
const body=new THREE.Group();player.add(body);
mesh(body,geo.box,mats.pants,0,.67,0,.73,.68,.48).castShadow=true;
mesh(body,geo.box,mats.shirt,0,1.42,0,1.05,1.02,.62).castShadow=true;
mesh(body,geo.box,mats.belt,0,1.05,.34,.95,.17,.12);
mesh(body,geo.sphere,mats.skin,0,2.22,.04,.46,.52,.43).castShadow=true;
mesh(body,geo.sphere,mats.hair,0,2.63,-.1,.49,.2,.44);
mesh(body,geo.box,mats.hair,0,2.35,-.36,.85,.22,.17);
for(const side of [-1,1]) mesh(body,geo.sphere,mats.eye,side*.16,2.3,.43,.045,.045,.03);
const limbs=[];
for(const side of [-1,1]){
  const arm=new THREE.Group();arm.position.set(side*.62,1.82,0);body.add(arm);
  mesh(arm,geo.cyl,mats.shirt,0,-.34,0,.17,.75,.18).rotation.z=side*.22;
  mesh(arm,geo.sphere,mats.skin,side*.08,-.75,.04,.15,.17,.15);
  const leg=new THREE.Group();leg.position.set(side*.23,.57,0);body.add(leg);
  mesh(leg,geo.cyl,mats.pants,0,-.25,0,.2,.55,.22);
  mesh(leg,geo.box,mats.belt,0,-.56,.14,.35,.2,.55);
  limbs.push({arm,leg,side});
}
const originalMeshes=[];
new OBJLoader().load(asset('mesh-90-player.obj'),model=>{
  const tex=textureLoader.load(asset('texture-63-playerTexture.png'));
  tex.colorSpace=THREE.SRGBColorSpace;tex.flipY=false;
  model.traverse(part=>{
    if(!part.isMesh)return;
    part.material=new THREE.MeshStandardMaterial({map:tex,roughness:.96,side:THREE.DoubleSide});
    part.castShadow=true;
    originalMeshes.push({geometry:part.geometry,base:part.geometry.attributes.position.array.slice()});
  });
  model.scale.setScalar(.27);
  model.position.y=1.46;
  model.rotation.y=Math.PI;
  body.add(model);
  for(const limb of limbs){limb.arm.visible=false;limb.leg.visible=false}
  for(const child of body.children)if(child!==model)child.visible=false;
},undefined,()=>console.warn('Original runner model unavailable; using geometric fallback'));
function animateOriginalRunner(time){
  for(const {geometry,base} of originalMeshes){
    const positions=geometry.attributes.position.array;
    for(let i=0;i<base.length;i+=3){
      let x=base[i],y=base[i+1],z=base[i+2];
      const side=Math.sign(x)||1;
      if(Math.abs(x)>1.5&&y>1.8){
        const px=side*1.5,py=2.9,angle=-side*1.5;
        const dx=x-px,dy=y-py;
        x=px+dx*Math.cos(angle)-dy*Math.sin(angle);
        y=py+dx*Math.sin(angle)+dy*Math.cos(angle);
        const swing=Math.sin(time*15+(side>0?0:Math.PI))*.24;
        const armY=y-2.9;
        y=2.9+armY*Math.cos(swing)-z*Math.sin(swing);
        z=armY*Math.sin(swing)+z*Math.cos(swing);
      }else if(y< -2.3&&Math.abs(x)>.45){
        const swing=Math.sin(time*15+(side>0?Math.PI:0))*.32;
        const legY=y+2.3;
        y=-2.3+legY*Math.cos(swing)-z*Math.sin(swing);
        z=legY*Math.sin(swing)+z*Math.cos(swing);
      }
      positions[i]=x;positions[i+1]=y;positions[i+2]=z;
    }
    geometry.attributes.position.needsUpdate=true;
    geometry.computeVertexNormals();
  }
}
const shadow=mesh(scene,new THREE.CircleGeometry(.62,20),new THREE.MeshBasicMaterial({color:0x151d13,transparent:true,opacity:.35,depthWrite:false}),0,.015,PLAYER_Z,1,1,1);
shadow.rotation.x=-Math.PI/2;

function createObstacle(kind,lane,pathDistance){
  const group=new THREE.Group();placeOnPath(group,pathDistance,lanes[lane]);scene.add(group);
  if(kind==='hurdle'){
    for(const x of [-.72,.72]) mesh(group,geo.box,mats.seam,x,.44,0,.23,.9,.3).castShadow=true;
    mesh(group,geo.box,mats.red,0,.95,0,1.8,.26,.34).castShadow=true;
    mesh(group,geo.box,mats.edge,0,.56,0,1.8,.2,.34);
  }else if(kind==='arch'){
    for(const x of [-.83,.83]) mesh(group,geo.box,mats.stone,x,1.6,0,.35,3.2,.55).castShadow=true;
    mesh(group,geo.box,mats.stone,0,2.47,0,2.05,1.2,.67).castShadow=true;
    for(const x of [-.35,0,.35]) mesh(group,geo.cone,mats.edge,x,1.55,.37,.13,.55,.13).rotation.z=Math.PI;
  }else if(kind==='gap'){
    mesh(group,geo.box,mats.black,0,-.012,0,2.2,.045,3.1);
    for(const dz of [-1.58,1.58]) mesh(group,geo.box,mats.edge,0,.05,dz,2.3,.14,.13);
  }else{
    mesh(group,new RoundedBoxGeometry(1.7,2,1.1,2,.13),mats.stone,0,1,0).castShadow=true;
    mesh(group,geo.box,mats.moss,0,1.78,.58,1.45,.24,.08);
  }
  return {kind,lane,group,pathDistance,passed:false};
}
function createCoin(lane,pathDistance){
  const group=new THREE.Group();placeOnPath(group,pathDistance,lanes[lane]);group.position.y=1.3;scene.add(group);
  mesh(group,geo.coin,mats.gold).rotation.y=Math.PI/2;
  mesh(group,geo.sphere,mats.goldLight,0,0,0,.12,.12,.035);
  return {lane,group,pathDistance,taken:false};
}
const storeKey='atb_temple_run_best';
const RUN_SPEED=16;
let best=0;try{best=Number(localStorage.getItem(storeKey))||0}catch{}
$('best').textContent=best;
let state='menu', distance=0, coins=0, speed=RUN_SPEED, lane=1, laneX=0;
let jumpY=0, jumpV=0, sliding=0, runTime=0, nextSpawn=16, nextTurn=210, turnDirection=0, turnTaken=false, turnFlash=0;
let chaseGap=3.5,stumbleCooldown=0,turnCount=0,lastTurnDistance=-Infinity;
let death=null;
let obstacles=[],coinItems=[],previous=performance.now(),hintTimeout=0;
const show=(id,on)=>$(id).classList.toggle('hidden',!on);
function setHint(value,duration=1.2){$('hint').textContent=value;$('hint').classList.add('visible');hintTimeout=duration}
function clearObjects(){for(const item of [...obstacles,...coinItems])scene.remove(item.group);obstacles=[];coinItems=[]}
function reset(){
  tone(480,.12,'triangle');
  clearObjects();distance=0;coins=0;speed=RUN_SPEED;lane=1;laneX=0;jumpY=0;jumpV=0;sliding=0;runTime=0;death=null;
  nextSpawn=16;nextTurn=210;turnDirection=0;turnTaken=false;turnFlash=0;turnCount=0;lastTurnDistance=-Infinity;chaseGap=3.5;stumbleCooldown=0;
  pathSegments.length=1;Object.assign(pathSegments[0],{start:0,end:Infinity,x:0,z:PLAYER_Z,heading:0});
  tiles.forEach((tile,i)=>{tile.pathDistance=-9+i*TILE;placeOnPath(tile,tile.pathDistance)});
  for(let i=0;i<6;i++)coinItems.push(createCoin(1,15+i*2.7));
  player.position.set(0,0,PLAYER_Z);body.position.y=0;body.scale.y=1;body.rotation.set(0,0,0);enemy.scale.setScalar(1);shadow.material.opacity=.33;
  $('distance').textContent='0';$('coins').textContent='0';show('menu',false);show('pauseOverlay',false);show('endOverlay',false);show('turnCue',false);
  state='playing';setHint('向左或向右换道 · 向上跳跃 · 向下滑铲',2.8);
}
function finishDeath(){
  if(state!=='dying')return;
  state='ended';best=Math.max(best,Math.floor(distance));
  try{localStorage.setItem(storeKey,String(best))}catch{}
  $('best').textContent=best;$('endDistance').textContent=`${Math.floor(distance)} m`;$('endCoins').textContent=coins;$('endBest').textContent=`${best} m`;
  $('endReason').textContent=death.reason;show('endOverlay',true);
}
function end(reason,kind='impact'){
  if(state!=='playing')return;
  state='dying';death={reason,kind,elapsed:0,duration:kind==='fall'?1.55:kind==='caught'?1.4:1.25,
    pitch:body.rotation.x,roll:body.rotation.z,height:player.position.y,gap:chaseGap};
  tone(180,.32,'sawtooth',.025);
  show('turnCue',false);$('hint').classList.remove('visible');
}
function updateDeath(dt){
  death.elapsed+=dt;
  const progress=Math.min(1,death.elapsed/death.duration),ease=1-(1-progress)**2;
  if(death.kind==='fall'){
    player.position.y=death.height-6*progress;
    body.rotation.x=THREE.MathUtils.lerp(death.pitch,-.55,ease);
    body.rotation.z=THREE.MathUtils.lerp(death.roll,.35,ease);
    shadow.material.opacity=.33*(1-progress);
    camera.position.y=THREE.MathUtils.lerp(camera.position.y,4.2,Math.min(1,dt*2));
  }else{
    const caught=death.kind==='caught';
    player.position.y=THREE.MathUtils.lerp(death.height,0,ease);
    body.rotation.x=THREE.MathUtils.lerp(death.pitch,caught?.65:-1.35,ease);
    body.rotation.z=THREE.MathUtils.lerp(death.roll,caught?-.8:.38,ease);
    body.position.y=-.16*ease;
    chaseGap=THREE.MathUtils.lerp(death.gap,caught?.25:2.2,ease);
    placeOnPath(enemy,distance-chaseGap,Math.sin(runTime*5)*.3);
    enemy.position.y=.08+Math.sin(progress*Math.PI)*.35;
    enemy.scale.setScalar(1+Math.sin(progress*Math.PI)*.12);
  }
  if(progress>=1)finishDeath();
}
function pause(){if(state==='playing'){state='paused';show('pauseOverlay',true)}else if(state==='paused'){state='playing';show('pauseOverlay',false);previous=performance.now()}}
function stumbleOrCatch(){
  if(stumbleCooldown>0){chaseGap=1.2;end('追逐者抓住了你。','caught')}
  else{stumbleCooldown=8;chaseGap=2.5;setHint('绊倒了！追逐者靠近了',1.6);tone(135,.28,'sawtooth',.05)}
}
function move(dir){
  if(state!=='playing')return;
  const cueActive=turnDirection!==0 && distance>nextTurn-6 && distance<nextTurn+4;
  if(cueActive){
    if(dir===turnDirection){turnTaken=true;turnDirection=0;turnFlash=1;turnCount++;lastTurnDistance=nextTurn;nextTurn+=210+Math.floor(rand(nextTurn)*70);show('turnCue',false);setHint('漂亮的转弯！',1);tone(620,.16,'triangle')}
    else end('转弯方向错了，撞上了遗迹墙壁。');
    return;
  }
  lane=Math.max(0,Math.min(2,lane+dir));
  tone(280,.055,'sine',.018);
}
function jump(){if(state!=='playing')return;if(jumpY<=.02 && jumpV<=0){jumpV=8.8;sliding=0;setHint('跳！',.35);tone(410,.13,'triangle',.04)}}
function slide(){if(state!=='playing')return;if(jumpY<.12){sliding=.95;setHint('滑铲！',.35);tone(180,.12,'triangle',.025)}else jumpV=-8}
function spawnWave(){
  const seed=Math.floor(nextSpawn),kind=['hurdle','arch','block','gap'][Math.floor(rand(seed)*4)];
  const obstacleLane=Math.floor(rand(seed+22)*3);
  obstacles.push(createObstacle(kind,obstacleLane,distance+83));
  const safeLane=(obstacleLane+1+Math.floor(rand(seed+50)*2))%3;
  for(let i=0;i<5;i++)coinItems.push(createCoin(safeLane,distance+79+i*2.6));
  if(rand(seed+75)>.72)for(let i=0;i<3;i++)coinItems.push(createCoin(obstacleLane,distance+91+i*2.6));
  nextSpawn+=22+rand(seed+8)*10;
}
function update(dt){
  if(state==='dying'){updateDeath(dt);return}
  if(state!=='playing')return;
  runTime+=dt;distance+=speed*dt;
  while(distance>=nextSpawn)spawnWave();
  if(distance>nextTurn-48 && turnDirection===0 && !turnTaken){
    turnDirection=rand(Math.floor(nextTurn))>.5?1:-1;
    addPathTurn(nextTurn,turnDirection);
    $('turnArrow').textContent=turnDirection<0?'↰':'↱';$('turnText').textContent=turnDirection<0?'前方左转':'前方右转';show('turnCue',true);
  }
  if(turnDirection!==0 && distance>nextTurn+4)end('错过路口，前方没有路了。');
  if(turnTaken && distance>nextTurn-190)turnTaken=false;
  junction.visible=turnDirection!==0||distance<lastTurnDistance+14;
  if(junction.visible)placeOnPath(junction,turnDirection!==0?nextTurn:lastTurnDistance);
  turnFlash=Math.max(0,turnFlash-dt*1.8);
  for(const tile of tiles){
    if(tile.pathDistance<distance-20)tile.pathDistance+=TILE*TILE_COUNT;
    placeOnPath(tile,tile.pathDistance);
    tile.decor.visible=!pathSegments.slice(1).some(segment=>Math.abs(tile.pathDistance-segment.start)<38);
  }
  laneX=THREE.MathUtils.damp(laneX,lanes[lane],12,dt);
  placeOnPath(player,distance,laneX);
  jumpV-=23*dt;jumpY=Math.max(0,jumpY+jumpV*dt);if(jumpY===0&&jumpV<0)jumpV=0;
  sliding=Math.max(0,sliding-dt);
  player.position.y=jumpY;
  body.scale.y=THREE.MathUtils.damp(body.scale.y,sliding>0?.54:1,14,dt);
  body.rotation.z=THREE.MathUtils.damp(body.rotation.z,(lanes[lane]-laneX)*-.12,8,dt);
  body.rotation.x=sliding>0?-.23:Math.sin(runTime*15)*.045;
  for(const {arm,leg,side} of limbs){arm.rotation.x=Math.sin(runTime*15+side*Math.PI)*.62;leg.rotation.x=Math.sin(runTime*15+side*Math.PI+Math.PI)*.65}
  if(originalMeshes.length)animateOriginalRunner(runTime);
  placeOnPath(shadow,distance,laneX);shadow.material.opacity=.33-Math.min(jumpY,2)*.1;shadow.scale.setScalar(1+jumpY*.22);
  stumbleCooldown=Math.max(0,stumbleCooldown-dt);chaseGap=THREE.MathUtils.damp(chaseGap,6.5,stumbleCooldown?0.12:0.3,dt);
  placeOnPath(enemy,distance-chaseGap,Math.sin(runTime*5)*.3);enemy.position.y=Math.sin(runTime*16)*.07;
  const cameraPoint=pathAt(distance-11,laneX*.12),ahead=pathAt(distance+12,laneX*.2),current=pathAt(distance,laneX*.2);
  const lookPoint={x:THREE.MathUtils.lerp(current.x,ahead.x,.22),z:THREE.MathUtils.lerp(current.z,ahead.z,.22)};
  camera.position.lerp(new THREE.Vector3(cameraPoint.x,5.8,cameraPoint.z),Math.min(1,dt*8));
  camera.lookAt(lookPoint.x,1.4,lookPoint.z);
  camera.rotateZ(turnFlash*(turnDirection<0?-.05:.05));
  for(const flame of flames){flame.scale.y=.52+Math.sin(runTime*15+flame.position.x)*.1;flame.rotation.y=runTime*2}
  for(let i=obstacles.length-1;i>=0;i--){
    const o=obstacles[i];placeOnPath(o.group,o.pathDistance,lanes[o.lane]);
    if(!o.passed && Math.abs(o.pathDistance-distance)<.85){
      o.passed=true;
      if(o.lane===lane){
        const escaped=(o.kind==='hurdle'||o.kind==='gap')?jumpY>.85:o.kind==='arch'?sliding>.1:false;
        if(!escaped){
          if(o.kind==='gap')end('掉进了断桥。','fall');
          else stumbleOrCatch();
        }
      }
    }
    if(o.pathDistance<distance-16){scene.remove(o.group);obstacles.splice(i,1)}
  }
  for(let i=coinItems.length-1;i>=0;i--){
    const c=coinItems[i];placeOnPath(c.group,c.pathDistance,lanes[c.lane]);c.group.position.y=1.3;c.group.children[0].rotation.y=runTime*3.5;
    if(!c.taken && c.lane===lane && Math.abs(c.pathDistance-distance)<.85 && jumpY<2.2){c.taken=true;coins++;$('coins').textContent=coins;tone(780+coins%4*90,.09,'sine',.04);scene.remove(c.group);coinItems.splice(i,1);continue}
    if(c.pathDistance<distance-16){scene.remove(c.group);coinItems.splice(i,1)}
  }
  if(hintTimeout>0){hintTimeout-=dt;if(hintTimeout<=0)$('hint').classList.remove('visible')}
  $('distance').textContent=Math.floor(distance);
}
function resize(){const rect=canvas.getBoundingClientRect();const w=Math.max(1,rect.width),h=Math.max(1,rect.height);renderer.setSize(w,h,false);camera.aspect=w/h;camera.fov=w/h<.7?65:58;camera.updateProjectionMatrix()}
new ResizeObserver(resize).observe(canvas);resize();
window.render_game_to_text=()=>JSON.stringify({state,distance:Math.floor(distance),coins,lane,jumpY,sliding,
  speed,nextTurn,turnDirection,turnCount,chaseGap,stumbleCooldown,death:death&&{kind:death.kind,progress:+Math.min(1,death.elapsed/death.duration).toFixed(2)},
  obstacles:obstacles.filter(o=>o.pathDistance>=distance-2&&o.pathDistance<distance+45).map(o=>({kind:o.kind,lane:o.lane,ahead:Math.round(o.pathDistance-distance)}))});
window.advanceTime=(ms)=>{const steps=Math.max(1,Math.ceil(ms/25)),step=Math.min(ms/steps/1000,.05);for(let i=0;i<steps;i++)update(step);renderer.render(scene,camera)};
if(import.meta.env.DEV)window.__templeDebug={
  jumpTo(value){clearObjects();distance=value;nextSpawn=value+100;update(0.001);const from=pathAt(distance-11),now=pathAt(distance),ahead=pathAt(distance+12);camera.position.set(from.x,5.8,from.z);camera.lookAt(THREE.MathUtils.lerp(now.x,ahead.x,.22),1.4,THREE.MathUtils.lerp(now.z,ahead.z,.22));renderer.render(scene,camera)},
  spawnObstacle(kind,ahead=5){obstacles.push(createObstacle(kind,lane,distance+ahead))},hit:stumbleOrCatch,end
};
function frame(now){const dt=Math.min(.05,(now-previous)/1000||0);previous=now;try{update(dt);renderer.render(scene,camera)}catch(error){console.error('Game frame failed',error);if(state==='playing')end('画面遇到问题，请重试。')}requestAnimationFrame(frame)}
requestAnimationFrame(frame);
$('startBtn').addEventListener('click',reset);$('restartBtn').addEventListener('click',reset);$('restartPauseBtn').addEventListener('click',reset);
$('pauseBtn').addEventListener('click',pause);$('resumeBtn').addEventListener('click',pause);
$('soundBtn').addEventListener('click',()=>{muted=!muted;$('soundBtn').textContent=muted?'♪̸':'♫';$('soundBtn').setAttribute('aria-label',muted?'开启声音':'关闭声音');if(!muted)tone(660,.08,'sine',.03)});
for(const [id,fn] of [['leftBtn',()=>move(-1)],['rightBtn',()=>move(1)],['jumpBtn',jump],['slideBtn',slide]])$(id).addEventListener('pointerdown',e=>{e.preventDefault();fn()});
window.addEventListener('keydown',e=>{
  if(['ArrowLeft','ArrowRight','ArrowUp','ArrowDown','Space'].includes(e.code))e.preventDefault();
  if(e.repeat)return;
  if(e.code==='Escape'||e.code==='KeyP'){pause();return}
  if((state==='menu'||state==='ended')&&(e.code==='Space'||e.code==='Enter')){reset();return}
  if(e.code==='ArrowLeft'||e.code==='KeyA')move(-1);
  else if(e.code==='ArrowRight'||e.code==='KeyD')move(1);
  else if(e.code==='ArrowUp'||e.code==='Space'||e.code==='KeyW')jump();
  else if(e.code==='ArrowDown'||e.code==='KeyS')slide();
});
let startX=0,startY=0;
canvas.addEventListener('pointerdown',e=>{startX=e.clientX;startY=e.clientY});
canvas.addEventListener('pointerup',e=>{
  if(state!=='playing')return;
  const dx=e.clientX-startX,dy=e.clientY-startY;
  if(Math.max(Math.abs(dx),Math.abs(dy))<28)return;
  if(Math.abs(dx)>Math.abs(dy))move(dx<0?-1:1);else if(dy<0)jump();else slide();
});
document.addEventListener('visibilitychange',()=>{if(document.hidden&&state==='playing')pause()});
