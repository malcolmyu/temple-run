const hallGateMat=new THREE.MeshStandardMaterial({map:facadeMat.map,color:0xa08a62,emissive:0x241c10,emissiveIntensity:.26,roughness:.95,metalness:.02});
function makeHall(tile){
  const root=tile.group||tile;
  const g=new THREE.Group();g.visible=false;root.add(g);tile.hall=g;
  const colMat=ancientStone;
  for(const side of [-1,1]){
    for(const z of [-3.4,3.4]){
      const c=mesh(g,geo.cyl,colMat,side*3.62,3.2,z,.58,6.4,.58);c.castShadow=true;
      mesh(g,geo.box,colMat,side*3.62,.18,z,.92,.36,.92).castShadow=true;
      mesh(g,geo.box,colMat,side*3.62,6.35,z,.88,.34,.88).castShadow=true;
    }
    for(const z of [-3.4,3.4]){
      const beam=mesh(g,geo.box,colMat,0,6.62,z,7.7,.56,.8);beam.castShadow=true;
      mesh(g,geo.box,mats.edge,0,6.3,z,7.9,.14,.9); // gold trim under the lintel
    }
    for(const z of [-3.4,3.4,0]){
      const pool=new THREE.Mesh(new THREE.PlaneGeometry(5.2,4.4),poolMat);
      pool.rotation.x=-Math.PI/2;pool.position.set(0,.045,z);pool.renderOrder=1;g.add(pool);
    }
    // Wall sconces with real flame sprites so the hall reads as a torch-lit colonnade.
    const f=createBrazier(g,side*3.05,0,0xcfe8ff);
    if(f){f.userData.base=.6;flames.push(f);g.userData.flames=[f]}
  }
  // One grand archway framing the middle of the colonnade.
  const hallIdx=Math.round((tile.pathDistance+9)/12);
  if(templeGateTemplate&&((hallIdx%60)+60)%60===21){
    const gate=templeGateTemplate.clone(true);
    gate.rotation.y=Math.PI;gate.scale.set(.19,.13,.1);
    gate.traverse(part=>{if(part.isMesh)part.material=hallGateMat});
    const wrap=new THREE.Group();wrap.add(gate);wrap.position.set(0,.02,0);g.add(wrap);
    // Watchful guardian faces carved into the columns, at eye level as you run past.
    for(const side of [-1,1]){
      const idol=new THREE.Group();idol.position.set(side*3.62,4.35,-.36);idol.rotation.y=Math.PI;idol.scale.setScalar(.62);g.add(idol);
      const stone=ancientStone;
      mesh(idol,geo.sphere,stone,0,0,0,2.1,2.5,1.7).castShadow=true;
      mesh(idol,new THREE.ConeGeometry(2.5,1.6,6),stone,0,1.6,0).castShadow=true;
      mesh(idol,geo.box,mats.gold,0,.9,-1.5,3.4,.5,.5);
      for(const sx of [-1,1]){
        mesh(idol,geo.sphere,mats.gold,sx*.72,.35,-1.35,.34,.26,.22);
        mesh(idol,geo.box,stone,sx*1.55,-.1,0,.7,1.9,.8).castShadow=true;
      }
      mesh(idol,geo.box,stone,0,-.9,-1.55,.9,.8,.5);
    }
  }
  // Carved frieze panels between the columns + gold ceiling trim.
  {
    const friezeTex=(()=>{const c=document.createElement('canvas');c.width=256;c.height=64;const g=c.getContext('2d');
      g.fillStyle='#4a4232';g.fillRect(0,0,256,64);
      g.fillStyle='#6a5f47';g.fillRect(0,4,256,56);
      g.fillStyle='#d9b36a';
      for(let x=16;x<256;x+=48){g.beginPath();g.arc(x,32,11,0,Math.PI*2);g.fill()}
      g.fillStyle='#40382a';for(let x=16;x<256;x+=48){g.beginPath();g.arc(x,32,5,0,Math.PI*2);g.fill()}
      g.strokeStyle='#d9b36a88';g.lineWidth=3;g.strokeRect(2,8,252,48);
      const t=new THREE.CanvasTexture(c);t.wrapS=THREE.RepeatWrapping;t.repeat.set(1.6,1);t.colorSpace=THREE.SRGBColorSpace;return t})();
    const friezeMat=new THREE.MeshStandardMaterial({map:friezeTex,color:0xbfae8a,roughness:.9,side:THREE.DoubleSide});
    for(const side of [-1,1])for(const z of [-3.3,3.3]){
      const f=new THREE.Mesh(new THREE.PlaneGeometry(6.2,1.15),friezeMat);
      f.position.set(side*3.58,5.5,z);f.rotation.y=side>0?-Math.PI/2:Math.PI/2;g.add(f);
    }
    // Wall sconces between the friezes, feeding the shared torch light pool.
    for(const side of [-1,1])for(const z of [-1.65,1.65]){
      const x=side*3.46;
      mesh(g,geo.box,mats.seam,x,4.32,z,.3,.14,.14).castShadow=false;
      mesh(g,geo.cyl,mats.edge,x,4.45,z,.16,.2,.16).castShadow=false;
      if(FX.flame){
        const fl=new THREE.Sprite(new THREE.SpriteMaterial({map:FX.flame,color:0xffc98a,transparent:true,opacity:.9,depthWrite:false,blending:THREE.AdditiveBlending}));
        fl.position.set(x,4.72,z);fl.scale.set(.6,.8,1);fl.renderOrder=2;fl.userData.flame=true;fl.userData.base=.45;
        g.add(fl);flames.push(fl);
      }
      const glow=makeFlameGlow(x,4.7,z,1.5);g.add(glow);
    }
  }
  // Enclosed stone ceiling so the hall reads as an interior, not an open colonnade.
  {
    const ceilMat=new THREE.MeshStandardMaterial({map:ancientStone.map,color:0x8a7a5e,side:THREE.DoubleSide,roughness:.95});
    const ceil=new THREE.Mesh(new THREE.PlaneGeometry(7.6,11.9),ceilMat);
    ceil.rotation.x=Math.PI/2;ceil.position.set(0,7.35,0);g.add(ceil);
    for(let z=-4.4;z<=4.4;z+=2.2){
      mesh(g,geo.box,colMat,0,7.2,z,7.4,.3,.42).castShadow=false;
    }
  }
  // Red ceremonial runner carpet down the middle of the hall.
  {
    const rug=new THREE.Mesh(new THREE.PlaneGeometry(2.7,11.9),rugMat);
    rug.rotation.x=-Math.PI/2;rug.position.set(0,.05,0);rug.receiveShadow=true;g.add(rug);
  }
  // Ceiling light shafts falling between the beams (additive, camera-facing-ish).
  if(shaftTex){
    const shaftMat=new THREE.MeshBasicMaterial({map:shaftTex,color:0xfff2d6,transparent:true,opacity:.3,depthWrite:false,blending:THREE.AdditiveBlending,side:THREE.DoubleSide});
    for(const x of [-1.9,1.9]){
      const sh=new THREE.Mesh(new THREE.PlaneGeometry(2.2,6.4),shaftMat);
      sh.position.set(x,3.3,0);sh.rotation.z=.12;sh.renderOrder=2;g.add(sh);
    }
  }
  for(const side of [-1,1]){
    const banner=new THREE.Mesh(new THREE.PlaneGeometry(1.35,3.1),bannerMat);
    banner.position.set(side*2.75,4.35,0);banner.castShadow=false;
    banner.userData.phase=side*1.7;g.add(banner);
    if(!g.userData.banners)g.userData.banners=[];
    g.userData.banners.push(banner);
  }
  return g;
}
function isCliffTile(d){const idx=Math.floor((d+9)/12);const m=((idx%48)+48)%48;return m>=6&&m<10&&!isBridgeTile(d)&&!nearTurnDistance(d,24)}
function makeCliff(tile){
  const root=tile.group||tile;
  const g=new THREE.Group();g.visible=false;root.add(g);tile.cliff=g;
  // Wooden guard posts + sagging ropes: the cliff path reads as a hanging walkway.
  for(const side of [-1,1]){
    for(const z of [-5.6,5.6]){
      const post=mesh(g,geo.box,mats.bark,side*3.98,2.0,z,.17,1.35,.17);post.castShadow=true;
      mesh(g,geo.box,mats.edge,side*3.98,2.72,z,.24,.12,.24);
    }
    for(const ry of [2.62,1.72]){
      const pts=[];
      for(let i=0;i<=6;i++){const t=i/6;pts.push(new THREE.Vector3(side*3.98,ry-Math.sin(t*Math.PI)*(ry>2?.26:.2),-5.6+t*11.2))}
      const rope=new THREE.Mesh(new THREE.TubeGeometry(new THREE.CatmullRomCurve3(pts),12,.04,5,false),ropeMat);
      g.add(rope);
    }
  }
  // Waterfall pouring into the chasm on alternating cliff tiles.
  if(!waterfallTex){
    const c=document.createElement('canvas');c.width=64;c.height=256;const g=c.getContext('2d');
    g.fillStyle='#8fd8d2';g.fillRect(0,0,64,256);
    for(let i=0;i<40;i++){
      const x=Math.random()*64,w=1+Math.random()*3,a=.06+Math.random()*.22;
      g.fillStyle=`rgba(255,255,255,${a})`;g.fillRect(x,0,w,256);
      g.fillStyle=`rgba(120,200,200,${a*.7})`;g.fillRect(x+1.5,0,w*.6,256);
    }
    waterfallTex=new THREE.CanvasTexture(c);waterfallTex.wrapS=waterfallTex.wrapT=THREE.RepeatWrapping;
    waterfallTex.repeat.set(1,2.2);waterfallTex.colorSpace=THREE.SRGBColorSpace;
  }
  {
    {
      for(const side of [-1,1]){
        const mat=new THREE.MeshBasicMaterial({map:waterfallTex,color:0xd8f6ff,transparent:true,opacity:.8,side:THREE.DoubleSide,depthWrite:false,blending:THREE.AdditiveBlending});
        const wf=new THREE.Mesh(new THREE.PlaneGeometry(2.6,17),mat);
        wf.position.set(side*7.2,4.2,-2);wf.rotation.y=side>0?-Math.PI/2:Math.PI/2;g.add(wf);
        const splash=makeFlameGlow(side*7.2,-2.6,-2,4.6);g.add(splash);
        for(let k=0;k<4;k++){
          const sp=new THREE.Sprite(mistTex?new THREE.SpriteMaterial({map:mistTex,transparent:true,opacity:.32,depthWrite:false}):new THREE.SpriteMaterial());
          sp.position.set(side*(6.9+rand(k+side*11)*1.0),1.7+rand(k+side*7)*.8,-2+(rand(k+side*3)-.5)*1.6);
          sp.scale.set(1.2+rand(k)*1.2,.9+rand(k+1)*.8,1);
          sp.userData.spray=true;sp.userData.baseY=sp.position.y;sp.userData.phase=rand(k+side);
          g.add(sp);
        }
        waterfalls.push(mat);
      }
    }
  }
  // Dark chasm either side of the cliff path plus jagged spires rising out of it.
  {
    const chasmMat=new THREE.MeshBasicMaterial({color:0x0a1614});
    for(const side of [-1,1]){
      const plane=new THREE.Mesh(new THREE.PlaneGeometry(26,12.2),chasmMat);
      plane.rotation.x=-Math.PI/2;plane.position.set(side*17,-1.55,0);g.add(plane);
      for(let i=0;i<3;i++){
        const h=4+rand(i+side*7)*7;
        const spire=new THREE.Mesh(new THREE.ConeGeometry(1.1+rand(i+side*3)*1.6,h,5),rockMat);
        spire.position.set(side*(9.5+rand(i+side*11)*7),-1.5+h/2,-4+i*4.2);
        spire.rotation.y=rand(i+side)*6.28;g.add(spire);
      }
    }
  }
  for(const side of [-1,1]){
    for(let z=-5;z<=5;z+=2){
      const rock=rockTemplate.clone(true);
      const scl=.075+rand(z+side*13)*.035;
      rock.scale.setScalar(scl);
      rock.position.set(side*(8.2+rand(z)*1.6),-.6,z+rand(z*3)*1.1);
      rock.rotation.y=rand(z+side)*Math.PI*2;
      g.add(rock);
    }
    for(let i=0;i<3;i++){
      const m=new THREE.Sprite(mistMat.clone());m.material.opacity=.1+rand(i+side*31)*.08;
      m.position.set(side*(5.2+rand(i+side)*2.4),.3+rand(i*7+side)*1.1,-4+i*4);
      m.scale.set(3.4+rand(i+side*5)*2.2,1.2+rand(i)*.8,1);
      m.userData.mist=true;m.userData.baseY=m.position.y;m.userData.rise=.25+rand(i+side*9)*.3;g.add(m);
      for(let k=0;k<2;k++){
        const cm=new THREE.Sprite(mistMat.clone());
        cm.material.opacity=.1+rand(k+side*17)*.08;
        cm.position.set(side*(7.5+rand(k+side*5)*5),-.4+rand(k+side*3)*.5,-4.5+k*6.2);
        cm.scale.set(7.5+rand(k+side)*3.5,2.6+rand(k)*1.4,1);
        cm.userData.mist=true;cm.userData.baseY=cm.position.y;cm.userData.rise=.18+rand(k+side*4)*.22;cm.userData.chasm=true;
        g.add(cm);
      }
    }
  }
  return g;
}
for(let i=0;i<TILE_COUNT;i++){
  const group=new THREE.Group();group.pathDistance=-9+i*TILE;placeOnPath(group,group.pathDistance);world.add(group);
  const surface=new THREE.Group();group.surface=surface;group.add(surface);
  const decor=new THREE.Group();group.decor=decor;group.add(decor);
  if(i%2===0){addLightShaft(group,-3.1+rand(i*7)*.8,-6,i);addLightShaft(group,2.9+rand(i*9)*.8,7,i+1)}
  for(const side of [-1,1]){
    const x=side*(6.5+rand(i*11+side+10)*2.8);
    createTree(decor,x,-3,i*19+side+20);
    createTree(decor,x+side*2.3,3,i*17+side+31);
    // Broken ruin columns just above the low corridor walls (they used to poke up too high and
    // read as pale slabs floating next to the road after the walls were lowered).
    const column=mesh(decor,geo.cyl,ancientStone,side*5.35,.95,0,.6,1.9,.6);column.castShadow=true;
    mesh(decor,geo.box,ancientStone,side*5.35,1.98,0,1.1,.24,1.1);
    mesh(decor,geo.box,mats.moss,side*5.35,.12,0,1.2,.26,1.2);
    if(i%2===0)flames.push(createTorch(decor,side*4.85,3));
  }
  // Hanging jungle vines draped over the corridor (original TR1 look).
  if(i%2===0){
    const vineMat=material(0x4f7040,{roughness:.92});
    const vineMatLight=material(0x64854c,{roughness:.9});
    for(let v=0;v<2;v++){
      const seed=i*29+v*13;
      const sag=.8+rand(seed)*1.1;
      const curve=new THREE.CatmullRomCurve3([
        new THREE.Vector3(-6.0-rand(seed+1)*.8,9.9+rand(seed+2)*.8,v*2.4-TILE*.5+rand(seed+3)*1.4),
        new THREE.Vector3(-2.0,9.9-sag*.55,v*2.4-TILE*.5+.6),
        new THREE.Vector3(1.5,9.9-sag,v*2.4-TILE*.5),
        new THREE.Vector3(5.2+rand(seed+4)*.9,9.9-sag*.4,v*2.4-TILE*.5+.3),
      ]);
      const tube=new THREE.Mesh(new THREE.TubeGeometry(curve,16,.13,5,false),vineMat);
      tube.castShadow=true;decor.add(tube);
      for(let b=0;b<7;b++){
        const pt=curve.getPoint(b/6);
        const leaf=mesh(decor,geo.sphere,b%2?mats.darkLeaf:mats.leaf,pt.x+(rand(seed+b*3)-.5)*.5,pt.y+(rand(seed+b*5)-.4)*.35,pt.z+(rand(seed+b*7)-.5)*.5,.42+rand(seed+b*11)*.3,.26+rand(seed+b*13)*.18,.34+rand(seed+b*17)*.24);
        leaf.castShadow=false;
      }
      for(let h=0;h<3;h++){
        const t=.25+h*.24;
        const pt=curve.getPoint(t);
        const len=.9+rand(seed+h*7)*1.7;
        const strand=new THREE.Mesh(new THREE.TubeGeometry(new THREE.CatmullRomCurve3([
          pt.clone(),
          new THREE.Vector3(pt.x+.25,pt.y-len*.55,pt.z+.18),
          new THREE.Vector3(pt.x+.1,pt.y-len,pt.z-.2),
        ]),6,.07,4,false),vineMatLight);
        mesh(decor,geo.sphere,mats.darkLeaf,pt.x+.1,pt.y-len-.08,pt.z-.2,.3,.2,.26);
        strand.castShadow=false;decor.add(strand);
      }
    }
  }
  tiles.push(group);
  makeBridge(group);
}
function buildProcRoadSurface(surface){
  const road=mesh(surface,new RoundedBoxGeometry(8.3,.65,TILE+.12,2,.08),mats.stone,0,-.38,0);road.receiveShadow=true;
  const paving=mesh(surface,new THREE.PlaneGeometry(8.05,TILE),roadTextureMat,0,-.035,0);paving.rotation.x=-Math.PI/2;paving.receiveShadow=true;
  for(const x of [-4.2,4.2]){
    const rim=mesh(surface,geo.box,mats.edge,x,.03,0,.28,.48,TILE);rim.castShadow=true;
    for(const dz of [-4.5,-1.5,1.5,4.5]) mesh(surface,geo.box,mats.seam,x*1.04,-.2,dz,.25,.75,.13);
  }
  for(const x of [-1.18,1.18]) mesh(surface,geo.box,mats.seam,x,-.036,0,.048,.015,TILE);
}
function refreshRoadSurface(){
  tiles.forEach(tile=>{
    const surface=tile.surface;while(surface.children.length)surface.remove(surface.children[0]);
    if(roadTileTemplate){const tileMesh=roadTileTemplate.clone(true);tileMesh.position.y=ROAD_TILE_LIFT;surface.add(tileMesh);}
    else buildProcRoadSurface(surface);
    if(trackWallTemplate){
      for(const side of [-1,1]){
        const wall=trackWallTemplate.clone(true);
        wall.scale.setScalar(CORRIDOR_WALL_SCALE);
        wall.position.set(side*CORRIDOR_WALL_X,LOWWALL_SINK,0);
        wall.rotation.y=side>0?0:Math.PI;
        wall.userData.facade=true;
        surface.add(wall);
      }
      // Wall torches on the inner face of both temple walls.
      for(const side of [-1,1]){
        for(const z of [-3.3,3.3]){
          // Sconces sit on top of the ~1.36 m ruin wall (wall top = 6.78*.2 + LOWWALL_SINK).
          mesh(surface,geo.box,mats.seam,side*3.98,1.72,z,.14,.7,.14);
          mesh(surface,geo.box,mats.seam,side*3.9,1.38,z,.12,.12,.34);
          const flame=mesh(surface,geo.cone,mats.fire,side*3.86,2.06,z,.22,.54,.22);
          flames.push(flame);
        }
        // Jungle canopy spilling over the wall top.
        for(let i=0;i<4;i++){
          const z=-4.5+i*3;
          const leaf=mesh(surface,geo.sphere,i%2?mats.leaf:mats.darkLeaf,side*(5.6+rand(z+side)*1.1),1.55+rand(z*2+side)*.75,z,(1.4+rand(z)*.9),(.7+rand(z*3)*.35),(1.3+rand(z*5)*.8));
          leaf.castShadow=false;leaf.userData.facade=true;leaf.userData.sway=Math.random()*6.28;swayLeaves.push(leaf);
        }
        // Jungle canopy arching over the corridor edges (dense-forest feel).
        for(let i=0;i<2;i++){
          const z=-3.6+i*6.4;
          const leaf=mesh(surface,geo.sphere,i?mats.leaf:mats.darkLeaf,side*(4.6+rand(z+side)*2.6),8.6+rand(z*2+side*3)*2.8,z,(3.2+rand(z+side)*2.2),(1.5+rand(z*3)*.9),(2.6+rand(z*5+side)*1.6));
          leaf.castShadow=false;leaf.userData.facade=true;leaf.userData.sway=Math.random()*6.28;swayLeaves.push(leaf);
        }
        // Dense jungle right behind the low ruin walls (the original shows foliage, not a cliff).
        for(let i=0;i<4;i++){
          const z=-4.2+i*3.6;
          const bush=mesh(surface,geo.sphere,mats.darkLeaf,side*(10.6+rand(z+side*7)*3.0),1.0+rand(z*3+side)*2.0,z,(1.4+rand(z+side)*1.1),(1.0+rand(z*2)*.8),(1.3+rand(z*5+side)*.9));
          bush.castShadow=false;bush.userData.facade=true;bush.userData.sway=Math.random()*6.28;swayLeaves.push(bush);
        }
        // Inner canopy: branches hanging over the path so the corridor feels tunnelled by jungle.
        for(let i=0;i<2;i++){
          const z=-2.4+i*5.6;
          const leaf=mesh(surface,geo.sphere,i?mats.leaf:mats.darkLeaf,side*(2.4+rand(z*3+side)*1.9),7.3+rand(z+side*5)*2.2,z,(3.4+rand(z+side)*2.4),(1.1+rand(z*2)*.7),(2.2+rand(z*7+side)*1.4));
          leaf.castShadow=false;leaf.userData.facade=true;leaf.userData.sway=Math.random()*6.28;swayLeaves.push(leaf);
        }
        // Tall jungle trees and boulders beyond the temple walls for skyline depth.
        if(treeTemplate){
          for(let i=0;i<4;i++){
            const tree=treeTemplate.clone(true);
            const scl=.06+rand(tile.pathDistance+side*7+i)*.05;
            tree.scale.setScalar(scl);
            tree.position.set(side*(12+rand(tile.pathDistance+side+i)*13),0,-4.5+i*3.6+rand(i+tile.pathDistance)*1.2);
            tree.rotation.y=rand(tile.pathDistance+i)*Math.PI*2;
            tree.userData.facade=true;
            surface.add(tree);
          }
        }
        if(rockTemplate&&Math.abs(side)===1&&(tile.pathDistance%24>10)){
          const rock=rockTemplate.clone(true);
          rock.scale.setScalar(.07+rand(tile.pathDistance)*.03);
          rock.position.set(side*10.5,0,rand(tile.pathDistance)*3);
          rock.rotation.y=rand(tile.pathDistance*3)*Math.PI*2;
          rock.userData.facade=true;
          surface.add(rock);
        }
      }
    }
  });
}
refreshRoadSurface();
const floorWater=textureLoader.load(asset('leafTexture.png'));floorWater.colorSpace=THREE.SRGBColorSpace;
floorWater.wrapS=floorWater.wrapT=THREE.RepeatWrapping;floorWater.repeat.set(22,20);
const undergrowth=mesh(scene,geo.box,new THREE.MeshStandardMaterial({map:floorWater,color:0x27564b,roughness:.42,metalness:.12}),0,-2,-60,190,2,180);undergrowth.receiveShadow=true;
const junction=new THREE.Group();junction.visible=false;scene.add(junction);
let junctionHeading=0,junctionCorner={x:0,z:0};
const markerMat=new THREE.MeshStandardMaterial({color:0xf3c258,metalness:.62,roughness:.32,emissive:0x8a5811,emissiveIntensity:.55});
function buildJunction(dir){
  while(turnGuides.length){const g=turnGuides.pop();scene.remove(g)}
  while(junction.children.length)junction.remove(junction.children[0]);
  watchMonkeys.length=0;
  while(guardianHeads.length)guardianHeads.pop();
  while(guardianEyes.length){const e=guardianEyes.pop();if(e.parent)e.parent.remove(e)}
  while(junctionFlames.length){const f=junctionFlames.pop();const i=flames.indexOf(f);if(i>=0)flames.splice(i,1)}
  const padMat=material(0x8a8066,{map:pavementTexture});
  const padCX=-dir*2,padCZ=-2;
  // Two monkeys perched on the junction walls, just watching the runner go by.
  for(const [mx,mz,ry] of [[padCX-2.15,padCZ+2.15,0],[padCX+2.0,padCZ-2.2,Math.PI]]){
    const mk=makeMonkey(1.15);mk.position.set(mx,1.55,mz);mk.rotation.y=ry+dir*.3;
    junction.add(mk);watchMonkeys.push({g:mk,phase:Math.random()*6.28,base:ry+dir*.3});
  }

  const pad=mesh(junction,sharedGeo.junctionPad,padMat,padCX,-.37,padCZ);pad.receiveShadow=true;
  mesh(junction,sharedGeo.junctionBase,ancientStone,padCX,-2.3,padCZ).receiveShadow=true;
  const paving=mesh(junction,sharedGeo.junctionPaving,junctionPavingMat,padCX,-.028,padCZ);paving.rotation.x=-Math.PI/2;paving.receiveShadow=true;
  // Second paving quadrant: the corner needs two of the four quadrants of an 8x8 square.
  const qx=dir*2, qz=-2;
  mesh(junction,sharedGeo.quadBase,ancientStone,qx,-2.35,qz).receiveShadow=true;
  const paving2=mesh(junction,sharedGeo.quadPaving,junctionPavingMat,qx,-.028,qz);paving2.rotation.x=-Math.PI/2;paving2.receiveShadow=true;
  // Hanging temple banner on the dead-end wall, so the closed side reads as a gate.
  {
    const ban=new THREE.Mesh(new THREE.PlaneGeometry(2.3,4.4),bannerMat);
    ban.position.set(0,4.5,-6.42);ban.renderOrder=1;
    junction.add(ban);junction.userData.banner=ban;
    mesh(junction,geo.cyl,mats.gold,0,6.78,-6.42,.12,.1,.12);
  }
  // Painted chevrons on the approach: white-gold arrows on the road telling which way to turn.
  {
    const c=document.createElement('canvas');c.width=256;c.height=128;const g2=c.getContext('2d');
    g2.clearRect(0,0,256,128);
    g2.fillStyle='#f6e2a8';g2.strokeStyle='#6b5326';g2.lineWidth=6;
    for(let k=0;k<2;k++){
      const x=44+k*92;
      g2.beginPath();g2.moveTo(x,24);g2.lineTo(x+64,64);g2.lineTo(x,104);g2.lineTo(x+22,64);g2.closePath();g2.fill();g2.stroke();
    }
    const tex=new THREE.CanvasTexture(c);tex.colorSpace=THREE.SRGBColorSpace;
    for(const k of [8,15]){
      const m=new THREE.Mesh(new THREE.PlaneGeometry(4.4,2.2),new THREE.MeshStandardMaterial({map:tex,transparent:true,opacity:.92,roughness:.7,depthWrite:false}));
      m.rotation.x=-Math.PI/2;
      if(dir<0)m.rotation.z=Math.PI;
      m.position.y=.06;
      const wrapG=new THREE.Group();wrapG.add(m);wrapG.userData.turnGuide=true;
      placeOnPath(wrapG,nextTurn-k,0);
      scene.add(wrapG);turnGuides.push(wrapG);
    }
  }
  // Carved floor medallion on the corner pad: a sun-disc seal marking the turn.
  {
    const medTex=(()=>{const c=document.createElement('canvas');c.width=c.height=256;const g=c.getContext('2d');
      g.clearRect(0,0,256,256);
      g.strokeStyle='#e8cf96';g.lineWidth=10;g.beginPath();g.arc(128,128,104,0,Math.PI*2);g.stroke();
      g.strokeStyle='#c9ab6e';g.lineWidth=4;g.beginPath();g.arc(128,128,86,0,Math.PI*2);g.stroke();
      for(let i=0;i<16;i++){const a=i/16*Math.PI*2;g.strokeStyle=i%2?'#d8bd85':'#a98d5c';g.lineWidth=i%2?6:3;
        g.beginPath();g.moveTo(128+Math.cos(a)*52,128+Math.sin(a)*52);g.lineTo(128+Math.cos(a)*82,128+Math.sin(a)*82);g.stroke()}
      g.fillStyle='#f0d79c';g.beginPath();g.arc(128,128,34,0,Math.PI*2);g.fill();
      g.fillStyle='#8d7748';g.beginPath();g.arc(128,128,18,0,Math.PI*2);g.fill();
      const t=new THREE.CanvasTexture(c);t.colorSpace=THREE.SRGBColorSpace;return t})();
    const medMat=new THREE.MeshStandardMaterial({map:medTex,transparent:true,opacity:.92,roughness:.78,metalness:.15,depthWrite:false});
    const med=new THREE.Mesh(new THREE.PlaneGeometry(3.6,3.6),medMat);
    med.rotation.x=-Math.PI/2;med.rotation.z=dir>0?Math.PI/2:-Math.PI/2;
    med.position.set(padCX,.052,padCZ);med.renderOrder=1;
    junction.add(med);
  }
  // Temple plaza apron: the corner reads as paved ground instead of floating over jungle.
  {
    const apronMap=junctionPavingAtlas.clone();apronMap.needsUpdate=true;
    apronMap.repeat.set(.2457*14/4,.2714*14/12);
    const apronMat=new THREE.MeshStandardMaterial({map:apronMap,color:0x9e8f6e,roughness:.96,side:THREE.DoubleSide});
    const apron=mesh(junction,sharedGeo.apron,apronMat,0,-.06,-1);apron.rotation.x=-Math.PI/2;apron.receiveShadow=true;
    const curbMat=material(0x6f6147,{map:obstacleStoneAtlas,roughness:.97});
    for(const [cx,cz] of [[-dir*5.4+0,0.6],[dir*5.4,0.6],[-dir*5.4,-5.2],[dir*5.4,-5.2]]){
      mesh(junction,geo.box,curbMat,cx,.12,cz,.5,.34,.5).castShadow=true;
      mesh(junction,geo.cyl,curbMat,cx,.55,cz,.22,1.0,.22).castShadow=true;
      if(Math.abs(cx-dir*5.4)<.01&&cz>0) junctionFlames.push(createTorch(junction,cx+.9,cz));
    }
    // Standing braziers framing the exit road: warm gateposts for the turn.
    junctionFlames.push(createBrazier(junction,dir*3.75,padCZ+1.7));
    junctionFlames.push(createBrazier(junction,dir*3.75,padCZ-3.9));
    junctionFlames.forEach(f=>flames.push(f));
  }
  mesh(junction,geo.box,obstacleStone,-dir*4.5,.14,padCZ,.3,.5,5.0).castShadow=true;
  mesh(junction,geo.box,obstacleStone,padCX,.14,-4.5,5.0,.5,.3).castShadow=true;
  // Temple silhouette rising behind the dead end (the original turns end at a temple facade).
  if(templeGateTemplate){
    const t=templeGateTemplate.clone(true);
    t.scale.setScalar(.26);
    t.position.set(0,-.4,-11.6);
    t.rotation.y=Math.PI;
    junction.add(t);
  }
  // Big animated 3D turn arrow on the junction pad, pointing along the exit direction.
  {
    const arrowMat=material(0xffc247,{emissive:0xff9a12,emissiveIntensity:.75,roughness:.35,metalness:.3});
    const arrow=new THREE.Group();
    mesh(arrow,geo.box,arrowMat,0,.18,0,2.0,.16,.62);
    const head=mesh(arrow,geo.cone,arrowMat,1.25,.18,0,.82,1.15,.62);
    head.rotation.z=-Math.PI/2;head.castShadow=true;
    const gl=makeFlameGlow(.7,.55,0,3.6);arrow.add(gl);
    arrow.position.set(padCX,.38,padCZ+1.1);
    arrow.rotation.order='YXZ';
    arrow.rotation.y=dir<0?Math.PI:0;
    arrow.rotation.x=-.42;
    junction.add(arrow);
    junction.userData.arrow=arrow;
  }
  // Corner walls line up with the corridor facades (inner face at 4.0, height 7.0).
  const wallMat=junctionWallMat, WALL_H=7.0;
  if(trackWallTemplate){
    const sideFace=trackWallTemplate.clone(true);
    sideFace.scale.setScalar(CORRIDOR_WALL_SCALE);
    sideFace.position.set(-dir*CORRIDOR_WALL_X,0,-.6);
    sideFace.rotation.y=-dir>0?0:Math.PI;
    junction.add(sideFace);
  }else{
    mesh(junction,geo.box,wallMat,-dir*5.2,WALL_H/2+.35,-.6,2.4,WALL_H,10.4).castShadow=true;
    mesh(junction,geo.box,markerMat,-dir*4.42,WALL_H+.1,-.6,.06,.16,10.1);
    for(let i=-2;i<=2;i++) mesh(junction,geo.box,wallMat,-dir*5.2,WALL_H+.85,-5.2+i*2.3,1.16,.8,1.05).castShadow=true;
  }
  // Corner wing walls: the corridor facades are hidden within 10 m of a turn, so
  // continue the ruined temple walls around the corner. IMPORTANT: wings must start
  // outside the perpendicular road opening (|x|>4.2 / |z|>4.2) or they block the
  // outgoing corridor and the chase camera.
  {
    const wingH=1.9,wx=5.6,wingLen=9.2,wingFrom=4.9;
    const wingCenter=wingFrom+wingLen/2;
    // walls parallel to the incoming road (left/right of the incoming corridor)
    for(const sx of [dir,-dir]){
      mesh(junction,geo.box,junctionWallMat,sx*wx,wingH/2+.35,wingCenter,1.1,wingH,wingLen).castShadow=true;
      mesh(junction,geo.box,markerMat,sx*(wx-.58),wingH+.1,wingCenter,.06,.16,wingLen*.98);
    }
    // walls parallel to the outgoing road (both sides of the outgoing corridor)
    for(const sz of [1,-1]){
      mesh(junction,geo.box,junctionWallMat,dir*wingCenter,wingH/2+.35,sz*wx,wingLen,wingH,1.1).castShadow=true;
      mesh(junction,geo.box,markerMat,dir*wingCenter,wingH+.1,sz*(wx-.58),wingLen*.98,.16,.06);
    }
  }
  // Courtyard colonnade framing the turn: four tall columns at the plaza corners.
  {
    const colH=9.2,colR=.62;
    // Tall columns only behind the dead end: the chase camera swings past the entrance side
    // during a turn, so anything tall there would briefly block the view.
    for(const cx of [-6.4,6.4]){
      const cz=-6.6;
      const base=mesh(junction,geo.cyl,ancientStone,cx,.3,cz,colR*1.7,.6,colR*1.7);base.castShadow=true;
      const shaft=mesh(junction,geo.cyl,ancientStone,cx,.3+colH/2,cz,colR,colH,colR);shaft.castShadow=true;
      mesh(junction,geo.cyl,mats.edge,cx,colH*.55,cz,colR*1.03,.18,colR*1.03);
      const cap=mesh(junction,geo.box,ancientStone,cx,.3+colH+.12,cz,colR*2.5,.34,colR*2.5);cap.castShadow=true;
      mesh(junction,geo.box,markerMat,cx,.3+colH+.34,cz,colR*2.1,.12,colR*2.1);
      // Guardian beast crouched at the column base, facing the incoming runner.
      const gb=new THREE.Group();gb.position.set(cx>0?2.85:-2.85,.02,-5.75);gb.rotation.y=0;gb.userData.beast=true;junction.add(gb);
      mesh(gb,geo.box,ancientStone,0,.32,0,.62,.5,1.15).castShadow=true;          // body
      const headG=new THREE.Group();headG.position.set(0,.66,-.42);gb.add(headG);
      mesh(headG,geo.box,ancientStone,0,0,-.08,.44,.42,.5).castShadow=true;       // head
      guardianHeads.push({g:headG,base:0});
      mesh(headG,geo.box,ancientStone,0,.5-.66,-.74+.42,.3,.16,.24);              // muzzle
      for(const ex of [-1,1]){
        mesh(headG,geo.cone,ancientStone,ex*.16,.92-.66,-.46+.42,.12,.22,.12);   // ears
        mesh(gb,geo.box,ancientStone,ex*.22,.1,.38,.16,.2,.5);                     // paws
      }
      mesh(headG,geo.box,mats.gold,0,.62-.66,-.72+.42,.1,.06,.08);              // gilded eyes band
      for(const ex of [-1,1]){
        if(!FX.sparkle)continue;
        const eye=new THREE.Sprite(new THREE.SpriteMaterial({map:FX.sparkle,color:0xffd27a,transparent:true,opacity:.85,depthWrite:false,blending:THREE.AdditiveBlending}));
        eye.position.set(ex*.11,.66-.66,-.73+.42);eye.scale.set(.22,.22,1);eye.renderOrder=3;
        gb.add(eye);guardianEyes.push(eye);
      }
    }
    // Low fire pylons at the entrance: readable framing without occluding the turn camera.
    for(const cx of [-7.0,7.0]){
      const cz=3.2;
      mesh(junction,geo.box,ancientStone,cx,1.15,cz,.7,2.3,.7).castShadow=true;
      mesh(junction,geo.box,markerMat,cx,2.36,cz,.86,.12,.86);
      const f=createBrazier(junction,cx,cz);
      junctionFlames.push(f);
    }
  }
  // Low parapets sealing the open corners, continuing the road-tile rims.
  // gold chevrons painted on the floor pointing into the turn
  for(let i=0;i<3;i++){
    const chevron=mesh(junction,geo.cone,markerMat,dir*(1+i*1.4),.1,-.5,.5,.9,.5);
    chevron.rotation.z=-dir*Math.PI/2;
  }
  // Original temple facade closes the dead end, oriented so its decorated face looks at the player.
  if(trackWallTemplate){
    const face=trackWallTemplate.clone(true);
    face.scale.setScalar(CORRIDOR_WALL_SCALE);
    face.position.set(0,0,-8.3);
    face.rotation.y=Math.PI/2;
    junction.add(face);
  }
  flames.push(createTorch(junction,dir*4.35,-4.35),createTorch(junction,-dir*4.35,-4.35));
  junction.rotation.y=junctionHeading;
  junction.position.set(junctionCorner.x,0,junctionCorner.z);
}
const enemy=new THREE.Group();scene.add(enemy);
const enemyFallback=new THREE.Group();enemy.add(enemyFallback);
for(const side of [-1,1]){
