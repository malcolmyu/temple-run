  const grd=g.createRadialGradient(64,64,4,64,64,62);grd.addColorStop(0,'rgba(255,240,190,1)');grd.addColorStop(.35,'rgba(255,170,60,.75)');grd.addColorStop(1,'rgba(255,90,10,0)');
