const waterTex=(()=>{const c=document.createElement('canvas');c.width=c.height=128;const g=c.getContext('2d');
  g.fillStyle='#2f6b5f';g.fillRect(0,0,128,128);
  for(let i=0;i<90;i++){const x=Math.random()*128,y=Math.random()*128;g.strokeStyle=`rgba(180,230,210,${.04+Math.random()*.06})`;g.beginPath();g.moveTo(x,y);g.quadraticCurveTo(x+6,y-3,x+14,y);g.stroke()}
  const t=new THREE.CanvasTexture(c);t.wrapS=t.wrapT=THREE.RepeatWrapping;t.repeat.set(3,1.4);t.colorSpace=THREE.SRGBColorSpace;return t})();
