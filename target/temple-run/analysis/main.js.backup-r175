const bridgeWood=material(0x6b4a2c,{roughness:.9});
const ropeMat=material(0x35261a,{roughness:1});
function nearTurnDistance(d,m=22){return pathSegments.some((seg,i)=>i>0&&Math.abs(d-seg.start)<m)}
function isBridgeTile(d){const idx=Math.floor((d+9)/12);return ((idx%36)+36)%36<3&&!nearTurnDistance(d,24)}
const plankTex=(()=>{const c=document.createElement('canvas');c.width=128;c.height=128;const g=c.getContext('2d');
  g.fillStyle='#5c3f24';g.fillRect(0,0,128,128);
  for(let y=0;y<128;y+=16){
    g.fillStyle=`rgb(${104+Math.floor(Math.random()*22)},${72+Math.floor(Math.random()*16)},${42+Math.floor(Math.random()*12)})`;
    g.fillRect(0,y+1,128,14);
    g.fillStyle='rgba(30,18,8,.85)';g.fillRect(0,y,128,1.5);
    for(let i=0;i<14;i++){g.fillStyle=`rgba(40,26,12,${.06+Math.random()*.1})`;g.fillRect(Math.random()*128,y+2+Math.random()*11,6+Math.random()*26,1)}
  }
  const t=new THREE.CanvasTexture(c);t.wrapS=t.wrapT=THREE.RepeatWrapping;t.repeat.set(1.1,7.0);t.colorSpace=THREE.SRGBColorSpace;return t})();
const plankMat=new THREE.MeshStandardMaterial({map:plankTex,color:0xb98453,roughness:.94});
function makeBridgeLantern(parent,x,z){
  const g=new THREE.Group();g.position.set(x,0,z);parent.add(g);
  mesh(g,geo.box,mats.seam,0,1.0,0,.44,1.9,.44).castShadow=true;
  mesh(g,geo.box,mats.edge,0,2.02,0,.62,.12,.62);
  const glass=mesh(g,geo.box,material(0xffdc9a,{emissive:0xffb43a,emissiveIntensity:1.1,transparent:true,opacity:.92}),0,2.28,0,.4,.5,.4);
  mesh(g,geo.cone,mats.seam,0,2.72,0,.56,.4,.56);
  return g;
}
function makeBridge(tile){
  const root=tile.group||tile;
  const g=new THREE.Group();g.visible=false;root.add(g);tile.bridge=g;
  const water=new THREE.Mesh(new THREE.PlaneGeometry(26,12.4),bridgeWaterMat);
  water.rotation.x=-Math.PI/2;water.position.set(0,-1.32,0);g.add(water);
  // Wooden deck planks laid across the stone causeway, and side beams to hide the slab edge.
  const deck=new THREE.Mesh(new THREE.PlaneGeometry(7.7,11.9),plankMat);
  deck.rotation.x=-Math.PI/2;deck.position.set(0,.022,0);deck.receiveShadow=true;g.add(deck);
  for(const side of [-1,1]){
    mesh(g,geo.box,bridgeWood,side*3.78,-.12,0,.26,.3,11.9).castShadow=true;
    makeBridgeLantern(g,side*4.05,side*5.6);
  }
  for(const side of [-1,1]){
    // Sagging rope that hangs above the handrail, like the original rope bridge.
    const pts=[];
    for(let i=0;i<=6;i++){const t=i/6,z=-5.9+t*11.8;pts.push(new THREE.Vector3(side*3.55,2.05-Math.sin(t*Math.PI)*.38,z))}
    const rope=new THREE.Mesh(new THREE.TubeGeometry(new THREE.CatmullRomCurve3(pts),14,.045,6,false),ropeMat);
    rope.castShadow=false;g.add(rope);
  }
  for(const side of [-1,1]){
    for(let z=-5;z<=5;z+=2.5){
      mesh(g,geo.box,bridgeWood,side*3.55,1.05,z,.2,1.5,.2).castShadow=true;
    }
    mesh(g,geo.box,bridgeWood,side*3.55,1.5,0,.18,.22,11.6).castShadow=true;
    mesh(g,geo.box,bridgeWood,side*3.55,.9,0,.16,.18,11.6).castShadow=true;
    for(let z=-4.4;z<=4.4;z+=2.2){
      const br=mesh(g,geo.box,bridgeWood,side*3.55,1.2,z,.1,1.0,.1);br.rotation.x=z>0?.5:-.5;
    }
  }
  return g;
}
