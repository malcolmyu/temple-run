};
function mesh(parent, geometry, mat, x=0,y=0,z=0,sx=1,sy=1,sz=1){
  const o=new THREE.Mesh(geometry,mat);o.position.set(x,y,z);o.scale.set(sx,sy,sz);parent.add(o);return o;
}
function rand(seed){const v=Math.sin(seed*128.13+21.4)*43758.5453;return v-Math.floor(v)}
const TILE=12, TILE_COUNT=12, lanes=[-1.3,0,1.3], PLAYER_Z=3;
const pathSegments=[{start:0,end:Infinity,x:0,z:PLAYER_Z,heading:0}];
const TURN_ARC=3.6; // rounded-corner length: how quickly the runner/camera swing through a 90° turn
function normAngle(a){return ((a+Math.PI)%(Math.PI*2)+Math.PI*2)%(Math.PI*2)-Math.PI}
// smooth=true is for dynamic actors (runner, chaser, shadow, camera): it rounds the
// 90° corner into a short eased arc so motion/direction never snaps. Tiles keep using the
// plain straight path so the 12 m road grid stays perfectly aligned.
function pathAt(distance,side=0,smooth=false){
  let index=0;
  for(let i=1;i<pathSegments.length;i++){if(distance>=pathSegments[i].start)index=i;else break}
  const segment=pathSegments[index],travel=distance-segment.start;
  const bx=segment.x-Math.sin(segment.heading)*travel, bz=segment.z-Math.cos(segment.heading)*travel;
  if(smooth&&index>0){
    const start=segment.start,e=Math.min(1,Math.max(0,(distance-(start-TURN_ARC*.5))/TURN_ARC));
    if(e<1){
      const prev=pathSegments[index-1],pt=distance-prev.start;
      const px=prev.x-Math.sin(prev.heading)*pt, pz=prev.z-Math.cos(prev.heading)*pt;
      const k=e*e*(3-2*e);
      const heading=prev.heading+normAngle(segment.heading-prev.heading)*k;
      const x=px+(bx-px)*k, z=pz+(bz-pz)*k;
      return {x:x+Math.cos(heading)*side,z:z-Math.sin(heading)*side,heading};
    }
  }
  return {x:bx+Math.cos(segment.heading)*side,z:bz-Math.sin(segment.heading)*side,heading:segment.heading};
}
function placeOnPath(group,distance,side=0,smooth=false){const point=pathAt(distance,side,smooth);group.position.x=point.x;group.position.z=point.z;group.rotation.y=point.heading}
function addPathTurn(at,direction){
  const last=pathSegments[pathSegments.length-1];last.end=at;const point=pathAt(at);
  const seg={start:at,end:Infinity,x:point.x,z:point.z,heading:last.heading-direction*Math.PI/2};
  pathSegments.push(seg);
  spawnGateway(seg,62);
}
// Distant mountain silhouettes beyond the jungle: cheap depth cue over the canopy line.
{
  const peakMat=new THREE.MeshLambertMaterial({color:0x2b3a33});
  const peaks=new THREE.Group();peaks.position.z=-95;scene.add(peaks);
  for(let i=0;i<9;i++){
    const st=Math.abs(i-4);
    const h=74-st*7+((i*37)%17);
    const r=64+((i*53)%26);
    const c=new THREE.Mesh(new THREE.ConeGeometry(r,h,4),peakMat);
    c.position.set((i-4)*72+((i*29)%23),-18,-((i*41)%60));
    c.rotation.y=i*.7;peaks.add(c);
  }
}
const world=new THREE.Group();scene.add(world);
const tiles=[];
function createTree(parent,x,z,seed){
  const h=3.1+rand(seed)*3.6;
  const trunk=mesh(parent,geo.cyl,originalBark,x,h*.42,z,.2,h*.85,.2);trunk.castShadow=true;
  for(let i=0;i<4;i++){
    const crown=mesh(parent,geo.sphere,i%2?mats.leaf:mats.darkLeaf,x+(rand(seed+i+4)-.5)*1.8,h*.7+i*.38,z+(rand(seed+i+15)-.5)*1.5,1.5-i*.13,.85,1.2);
    crown.castShadow=i===0;
  }
  for(let i=0;i<3;i++){
    const vine=mesh(parent,geo.cyl,mats.moss,x+(i-1)*.7,h*.57,z+.45,.025,1.8,.025);vine.rotation.z=(i-1)*.25;
  }
}
function createTorch(parent,x,z){
  const pole=mesh(parent,geo.cyl,mats.seam,x,1.15,z,.13,2.3,.13);pole.castShadow=true;
  const cup=mesh(parent,geo.cyl,mats.edge,x,2.25,z,.32,.21,.32);
  const flame=mesh(parent,geo.cone,mats.fire,x,2.6,z,.24,.6,.24);flame.rotation.z=Math.PI;
  flame.userData.torch=[pole,cup,flame];
  return flame;
}
function createBrazier(parent,x,z,tint){
  const base=mesh(parent,geo.box,mats.stone,x,1.0,z,.62,2.0,.62);base.castShadow=true;
  mesh(parent,geo.box,mats.seam,x,2.02,z,.78,.14,.78);
  const bowl=mesh(parent,geo.cyl,mats.stone,x,2.16,z,.5,.3,.5);bowl.castShadow=true;
  const coal=mesh(parent,geo.cyl,mats.fire,x,2.34,z,.34,.1,.34);
  let flame;
  if(FX.flame){
    // Sprite flame instead of a cone: cones blow out to white when a torch light is close.
    flame=new THREE.Sprite(new THREE.SpriteMaterial({map:FX.flame,color:tint||0xffc98a,transparent:true,opacity:.9,depthWrite:false,blending:THREE.AdditiveBlending}));
    flame.position.set(x,2.86,z);flame.scale.set(.95,1.25,1);flame.renderOrder=2;
    flame.userData.flame=true;flame.userData.base=.6;
    parent.add(flame);
  }else{
    flame=mesh(parent,geo.cone,mats.fire,x,2.72,z,.34,.95,.34);flame.rotation.z=Math.PI;
  }
  const glow=makeFlameGlow(x,2.7,z,1.9);parent.add(glow);
  flame.userData.torch=[base,bowl,coal,flame,glow];
  return flame;
}
const flames=[];const junctionFlames=[];const guardianEyes=[];const guardianHeads=[];const _tmpV=new THREE.Vector3();const _tmp=new THREE.Vector3();const stolenCoins=[];const turnGuides=[];const waterfalls=[];const swayLeaves=[];const watchMonkeys=[];

