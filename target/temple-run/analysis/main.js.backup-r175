const sharedGeo={
  junctionPad:new RoundedBoxGeometry(5.0,.62,5.0,2,.1),
  junctionBase:new THREE.BoxGeometry(4.8,3.4,4.8),
  junctionPaving:new THREE.PlaneGeometry(4.8,4.8),
