const charStoreKey='atb_temple_run_chars';
const CHARS=[
  {id:'jhony',g:'m',name:'Jhony',sub:'默认跑者',price:0,tex:'assets/characters/jhony.png',av:'assets/ui/avatar-jhony.png',p:1},
  {id:'selene',g:'f',name:'Selene',sub:'宇航员',price:300,tex:'assets/characters/selene.png',av:'assets/ui/avatar-selene.png',p:1.04},
  {id:'scarlett',g:'f',name:'Scarlett',sub:'女探险家',price:400,tex:'assets/characters/scarlett.png',av:'assets/ui/avatar-scarlett.png',p:1.09},
  {id:'werewolf',g:'m',name:'万圣狼人',isNew:true,sub:'万圣节限定',price:500,tex:'assets/characters/werewolf.png',av:'assets/ui/avatar-werewolf.png',p:.8},
  {id:'barry',g:'m',name:'Barry Bones',sub:'老练跑者',price:600,tex:'assets/characters/barry.png',av:'assets/ui/avatar-barry.png',p:.9},
  {id:'karma',g:'f',name:'Karma Lee',sub:'敏捷盗贼',price:700,tex:'assets/characters/karma.png',av:'assets/ui/avatar-karma.png',p:1.02},
  {id:'ghost',g:'f',name:'血鬼',isNew:true,sub:'暗影皮肤 · 宝石限定',price:0,gemPrice:2,tex:'assets/characters/ghost.png',av:'assets/ui/avatar-ghost.png',p:.93},
  {id:'conquistador',g:'m',name:'征服者',sub:'西班牙探险家',price:1000,tex:'assets/characters/conquistador.png',av:'assets/ui/avatar-conquistador.png',p:.95},
  {id:'skeleton',g:'m',name:'骷髅',sub:'亡灵诅咒 · 宝石限定',price:0,gemPrice:3,tex:'assets/characters/skeleton.png',av:'assets/ui/avatar-skeleton.png',p:.87},
];
let charState={bank:0,gems:0,owned:['jhony'],equipped:'jhony',upgrades:{magnet:0,coin:0,revive:0},objectives:{}};
const OBJECTIVES=[
  {id:'dist',name:'漫漫黄沙',sub:'累计奔跑 3000 m',target:3000,get:()=>stats.totalDistance,unit:'m',reward:{coins:200}},
  {id:'coins',name:'黄金猎人',sub:'累计收集 400 金币',target:400,get:()=>stats.totalCoins,unit:'',reward:{coins:150}},
  {id:'multi',name:'连击大师',sub:'最高倍率达到 ×4',target:4,get:()=>stats.bestMulti,unit:'×',reward:{gems:1}},
  {id:'turns',name:'转角达人',sub:'累计成功转弯 40 次',target:40,get:()=>stats.turns,unit:'',reward:{coins:150}},
  {id:'revive',name:'九死一生',sub:'累计使用复活 2 次',target:2,get:()=>stats.revives||0,unit:'',reward:{gems:2}},
];
const UPGRADES=[
  {id:'magnet',name:'磁铁时长',sub:'每级 +1.2 秒',costs:[200,400,800]},
  {id:'coin',name:'金币价值',sub:'每级 +25% 收益',costs:[300,600,1200]},
  {id:'revive',name:'复活折扣',sub:'每级 -10 金币',costs:[250,500,1000]},
];
try{
  const raw=localStorage.getItem(charStoreKey);
  if(raw){const p=JSON.parse(raw);if(p&&typeof p.bank==='number')charState.bank=p.bank;if(Array.isArray(p.owned))charState.owned=p.owned;if(p.equipped)charState.equipped=p.equipped;if(typeof p.gems==='number')charState.gems=p.gems;if(p.objectives&&typeof p.objectives==='object')charState.objectives=p.objectives;if(p.upgrades&&typeof p.upgrades==='object'){for(const u of ['magnet','coin','revive'])charState.upgrades[u]=(p.upgrades[u]|0)};if(!charState.upgrades)charState.upgrades={magnet:0,coin:0,revive:0}}
}catch{}
if(!charState.owned.includes('jhony'))charState.owned.unshift('jhony');
if(!CHARS.some(c=>c.id===charState.equipped))charState.equipped='jhony';
const charById=(id)=>CHARS.find(c=>c.id===id)||CHARS[0];
const charTexUrl=(id)=>`${import.meta.env.BASE_URL}${charById(id).tex}`;
const upLvl=(id)=>charState.upgrades[id]|0;
let coinValueAcc=0;
const coinWorth=(bonus)=>{const v=(bonus?3:1)*(1+upLvl('coin')*.25);coinValueAcc+=v;const out=Math.floor(coinValueAcc);coinValueAcc-=out;return Math.max(bonus?3:1,out)};
const reviveCostNow=()=>Math.max(20,50-upLvl('revive')*10);
function saveCharState(){try{localStorage.setItem(charStoreKey,JSON.stringify(charState))}catch{}}
const originalMeshes=[];
let runnerRig=null;
function applyCharTex(tex){
  if(!tex)return tex;
  tex.colorSpace=THREE.SRGBColorSpace;tex.flipY=true;
  try{tex.anisotropy=Math.min(8,renderer.capabilities.getMaxAnisotropy())}catch{}
  tex.needsUpdate=true;return tex;
}
function loadFallbackRunner(){
  new OBJLoader().load(asset('mesh-90-player.obj'),model=>{
    const tex=textureLoader.load(asset('texture-63-playerTexture.png'));
    applyCharTex(tex);
    model.traverse(part=>{
      if(!part.isMesh)return;
      part.material=new THREE.MeshStandardMaterial({map:tex,roughness:.96,side:THREE.DoubleSide});
      part.castShadow=true;
      originalMeshes.push({geometry:part.geometry,base:part.geometry.attributes.position.array.slice()});
    });
    model.scale.setScalar(.27);
    model.position.y=1.46;
    model.rotation.y=Math.PI;
    body.add(model);
    for(const limb of limbs){limb.arm.visible=false;limb.leg.visible=false}
    for(const child of body.children)if(child!==model)child.visible=false;
  },undefined,()=>console.warn('Original runner model unavailable; using geometric fallback'));
}
loadRunnerRig(asset('runner-rig.json'),charTexUrl(charState.equipped),{scale:.27,yOffset:1.32}).then(rig=>{
  runnerRig=rig;
  body.add(rig.object);
  for(const child of body.children)if(child!==rig.object)child.visible=false;
}).catch(err=>{console.warn('Skinned runner unavailable; using static fallback',err);loadFallbackRunner()});
function setRunnerSkin(id){
  if(typeof previewRig!=='undefined'&&previewRig)setPreviewChar(id);
  const url=charTexUrl(id);
  new THREE.TextureLoader().load(url,tex=>{
    applyCharTex(tex);
    if(runnerRig&&runnerRig.material){runnerRig.material.map=tex;runnerRig.material.needsUpdate=true}
    else if(originalMeshes.length){originalMeshes.forEach(()=>{});}
  },undefined,()=>console.warn('Character texture unavailable: '+url));
}
function animateOriginalRunner(time){
  for(const {geometry,base} of originalMeshes){
    const positions=geometry.attributes.position.array;
    for(let i=0;i<base.length;i+=3){
      let x=base[i],y=base[i+1],z=base[i+2];
      const side=Math.sign(x)||1;
      if(Math.abs(x)>1.5&&y>1.8){
        const px=side*1.5,py=2.9,angle=-side*1.5;
        const dx=x-px,dy=y-py;
        x=px+dx*Math.cos(angle)-dy*Math.sin(angle);
        y=py+dx*Math.sin(angle)+dy*Math.cos(angle);
        const swing=Math.sin(time*15+(side>0?0:Math.PI))*.24;
        const armY=y-2.9;
        y=2.9+armY*Math.cos(swing)-z*Math.sin(swing);
        z=armY*Math.sin(swing)+z*Math.cos(swing);
      }else if(y< -2.3&&Math.abs(x)>.45){
        const swing=Math.sin(time*15+(side>0?Math.PI:0))*.32;
        const legY=y+2.3;
        y=-2.3+legY*Math.cos(swing)-z*Math.sin(swing);
        z=legY*Math.sin(swing)+z*Math.cos(swing);
      }
      positions[i]=x;positions[i+1]=y;positions[i+2]=z;
    }
    geometry.attributes.position.needsUpdate=true;
    geometry.computeVertexNormals();
  }
}
const shadow=new THREE.Group();
const SHADOW_RINGS=[[1.06,.05],[.97,.06],[.87,.08],[.76,.10],[.63,.14],[.5,.20]];
{const base=0x0b0f09;
 for(const [r,o] of SHADOW_RINGS){
   const m=new THREE.Mesh(new THREE.CircleGeometry(r,28),new THREE.MeshBasicMaterial({color:base,transparent:true,opacity:o,depthWrite:false}));
   m.rotation.x=-Math.PI/2;m.renderOrder=2;shadow.add(m);
 }}
shadow.position.set(0,.09,PLAYER_Z);scene.add(shadow);
const enemyShadow=new THREE.Group();
for(const [r,o] of [[.62,.16],[.42,.28]]){
  const m=new THREE.Mesh(new THREE.CircleGeometry(r,20),new THREE.MeshBasicMaterial({color:0x0b0f09,transparent:true,opacity:o,depthWrite:false}));
  m.rotation.x=-Math.PI/2;m.renderOrder=2;enemyShadow.add(m);
}
scene.add(enemyShadow);
// Ambient fireflies drifting over the jungle beside the corridor.
const fireflies=[];const FIREFLY_N=16;
for(let i=0;i<FIREFLY_N;i++){
  const sp=new THREE.Sprite(new THREE.SpriteMaterial({map:flameGlow,color:0xa8ff6e,transparent:true,opacity:.8,depthWrite:false}));
  sp.scale.setScalar(.5+Math.random()*.35);
  scene.add(sp);
  fireflies.push({sp,phase:Math.random()*Math.PI*2,speed:.5+Math.random()*.7,amp:.5+Math.random()*.9,side:Math.random()<.5?-1:1,off:Math.random()});
}
const ffPos=new THREE.Vector3();
function updateFireflies(dt){
  for(let i=0;i<fireflies.length;i++){
    const f=fireflies[i];
    if(f.sp.position.z>player.position.z+4||f.sp.position.z<player.position.z-85){
      const ahead=4+Math.random()*30;
      const p=pathAt(distance+ahead, f.side*(3.2+Math.random()*2.2));
      f.sp.position.set(p.x,1.1+Math.random()*2.6,p.z);
      f.phase=Math.random()*Math.PI*2;
    }
    f.phase+=dt*f.speed;
    f.sp.position.y+=Math.sin(f.phase*1.7)*dt*f.amp*.5;
    f.sp.position.x+=Math.cos(f.phase)*dt*f.amp;
    f.sp.material.opacity=.35+.5*(0.5+0.5*Math.sin(f.phase*2.3));
  }
}
// Ambient dust motes floating in the warm light (very cheap atmosphere, like the original corridor haze).
const dustMotes=[];const DUST_N=26;
for(let i=0;i<DUST_N;i++){
  const sp=new THREE.Sprite(new THREE.SpriteMaterial({map:flameGlow,color:0xffeccd,transparent:true,opacity:.16,depthWrite:false,blending:THREE.AdditiveBlending}));
  sp.scale.setScalar(.18+Math.random()*.26);
  scene.add(sp);
  dustMotes.push({sp,phase:Math.random()*Math.PI*2,speed:.16+Math.random()*.3,lane:(Math.random()-.5)*6.4,rise:.08+Math.random()*.22});
}
function updateDustMotes(dt){
  for(let i=0;i<dustMotes.length;i++){
    const m=dustMotes[i];
    if(m.sp.position.z>player.position.z+6||m.sp.position.z<player.position.z-46){
      const ahead=2+Math.random()*36;
      const p=pathAt(distance+ahead,m.lane);
      m.sp.position.set(p.x,.4+Math.random()*4.2,p.z);
      m.phase=Math.random()*Math.PI*2;
    }
    m.phase+=dt*m.speed*3.1;
    m.sp.position.x+=Math.cos(m.phase)*dt*.16;
    m.sp.position.z+=Math.sin(m.phase*.7)*dt*.1;
    m.sp.position.y+=dt*m.rise;
    if(m.sp.position.y>5.2)m.sp.position.y=.35;
    m.sp.material.opacity=.14+.2*(0.5+0.5*Math.sin(m.phase*1.9));
  }
}
function setShadowAlpha(k){for(let i=0;i<shadow.children.length;i++){shadow.children[i].material.opacity=SHADOW_RINGS[i][1]*k}}

const _shadowGeoCache=new Map(),_shadowMatCache=new Map();
function shadowCircle(r){
  let g=_shadowGeoCache.get(r);if(!g){g=new THREE.CircleGeometry(r,20);_shadowGeoCache.set(r,g)}return g;
}
function shadowMat(o){
  let m=_shadowMatCache.get(o);if(!m){m=new THREE.MeshBasicMaterial({color:0x0b0f09,transparent:true,opacity:o,depthWrite:false});_shadowMatCache.set(o,m)}return m;
}
function addContactShadow(group,radius){
  // Shared geometry/material pairs: obstacle shadows are re-created on every spawn.
  const shadowGroup=new THREE.Group();
  for(const [r,o] of [[radius,.13],[radius*.68,.2]]){
    const m=new THREE.Mesh(shadowCircle(r),shadowMat(o));
    m.rotation.x=-Math.PI/2;m.position.y=.035;m.renderOrder=2;shadowGroup.add(m);
  }
  group.add(shadowGroup);
}
function createObstacle(kind,lane,pathDistance){
  const full=kind==='hurdle'||kind==='arch'||kind==='gap'||kind==='fire';
  const group=new THREE.Group();placeOnPath(group,pathDistance,full?0:lanes[lane]);scene.add(group);
  let groupScale=full?1:(kind==='hurdle'?.82:.62), usedPrefab=false;
  if(kind==='block')groupScale=1; // lane blocker stands chest-high, not scaled down like low obstacles
  if(kind==='hurdle'){
    // Fallen tree / stump barrier. The APK 'tree-jump' prefab is a whole 2.5D tree whose
    // dark foliage spills across the corridor, so this is built from bark geometry instead:
    // a thick fallen trunk plus two splintered stump ends and root flares — clearly "jump me".
    const trunk=mesh(group,geo.cyl,originalBark,0,.46,0,.42,3.15,.42);trunk.rotation.z=Math.PI/2;trunk.castShadow=true;
    const trunk2=mesh(group,geo.cyl,originalBark,.15,.76,.18,.26,2.4,.26);trunk2.rotation.set(.28,.35,Math.PI/2-.22);trunk2.castShadow=true;
    for(const sx of [-1,1]){
      const stump=mesh(group,geo.cyl,originalBark,sx*1.18,.42,0,.5,.86,.5);stump.castShadow=true;
      mesh(group,geo.sphere,obstacleWood,sx*1.18,.88,0,.52,.2,.52);
      for(const [rz,ry] of [[.9,.5],[-.75,-.4],[1.15,.1]]){
        const root=mesh(group,geo.cone,originalBark,sx*1.3,.2,.25,.22,.75,.22);
        root.rotation.set(.2,ry,rz);root.castShadow=true;
      }
    }
    mesh(group,geo.box,mats.moss,0,.74,.3,2.2,.14,.5);
    const splinter=mesh(group,geo.cone,originalBark,-.4,.62,0,.16,.5,.16);splinter.rotation.z=.5;
  }else if(kind==='arch'){
    // Low branch across the corridor — clearly "slide me". Built from bark geometry (the APK
    // 'tree-slide' facade is a flat stage-set plate that reads oddly up close).
    for(const sx of [-1,1]){
      const post=mesh(group,geo.cyl,originalBark,sx*1.35,1.05,0,.24,2.1,.24);post.rotation.z=sx*.04;post.castShadow=true;
      mesh(group,geo.sphere,originalBark,sx*1.35,2.12,0,.3,.22,.3);
    }
    const beam=mesh(group,geo.cyl,originalBark,0,2.15,0,.22,2.9,.22);beam.rotation.z=Math.PI/2;beam.castShadow=true;
    for(const [x,rz] of [[-.9,.35],[-.2,-.25],[.55,.3],[1.05,-.18]]){
      const twig=mesh(group,geo.cyl,originalBark,x,2.32,.1,.09,.9,.09);twig.rotation.set(.4,.2,rz);twig.castShadow=true;
    }
    for(const [x,y,z,sc] of [[-1.1,2.45,.1,.55],[.2,2.6,-.05,.7],[1.15,2.4,.05,.5]]){
      mesh(group,geo.sphere,mats.moss,x,y,z,sc,sc*.5,sc*.8);
    }
    mesh(group,geo.box,obstacleWood,0,2.15,.14,2.6,.1,.1);
  }else if(kind==='gap'){
    // Broken bridge section. The road surface is a solid tile, so the "hole" is painted
    // just above the paving (y=0.04) and framed by bright rims + broken slabs + torches.
    // (The original APK pit mesh was evaluated but its shaft sits below the solid road
    // tile, so it cannot cut a hole without splitting the tile — kept procedural.)
    const DEPTH=4.6;
    const voidMat=new THREE.MeshBasicMaterial({color:0x05070a});
    // Faint water glint far below so the pit reads as depth, not a flat black decal.
    const waterMat=new THREE.MeshBasicMaterial({color:0x123f3d,transparent:true,opacity:.55});
    const water=new THREE.Mesh(sharedGeo.gapWater,waterMat);water.rotation.x=-Math.PI/2;water.position.set(0,.047,.2);group.add(water);
    const hole=(w,d,rot,off)=>{const m=new THREE.Mesh(sharedGeo.gapHole,voidMat);m.rotation.x=-Math.PI/2;m.rotation.z=rot;m.position.set(0,.042,off);m.scale.set(w,d,1);group.add(m);return m};
    hole(3.9,DEPTH,0,0);hole(3.2,DEPTH*.6,.18,DEPTH*.32);hole(2.4,DEPTH*.5,-.24,-DEPTH*.34);
    // chipped stone lips on both rims
    for(const rz of [1,-1]){
      for(let i=-3;i<=3;i++){
        const x=i*.55+rz*.06,w=.36+rand(i*3.7+rz)*.16,h=.2+rand(i*7.1+rz)*.08;
        const slab=mesh(group,geo.box,obstacleStone,x,.06,rz*(DEPTH/2+.12),w,h,.6);
        slab.rotation.y=rand(i*5.3+rz*2.1)*.5;slab.rotation.x=rand(i*2.9+rz)*.2;
        if(rand(i*9.1+rz)>.55){
          const drop=mesh(group,geo.box,obstacleStone,x+rand(i)*.2,.02,rz*(DEPTH/2-.28),w*.7,.14,.4);
          drop.rotation.x=rz*.5;drop.rotation.y=rand(i*4.7)*.6;
        }
      }
      mesh(group,geo.box,mats.gold,0,.13,rz*(DEPTH/2+.46),3.9,.06,.1);
      for(const x of [-2.05,2.05]){
        mesh(group,geo.cyl,obstacleWood,x,.55,rz*(DEPTH/2+.55),.12,1.05,.12);
        mesh(group,geo.cyl,mats.edge,x,.02,rz*(DEPTH/2+.55),.24,.1,.24);
        const fire=mesh(group,geo.cone,fireOuter,x,1.14,rz*(DEPTH/2+.55),.2,.5,.2);fire.rotation.y=rand(x*3)*2;
        const glow=makeFlameGlow(x,1.18,rz*(DEPTH/2+.55),1.2);group.add(glow);
      }
    }
  }else if(kind==='fire'){
    // Flame jet wall across the lane, framed by two stone burners. (The APK 'flame-tower'
    // prefab is a whole tile section with temple walls — far too large to use as an obstacle.)
    mesh(group,geo.box,mats.black,0,-.01,0,8.0,.05,1.4);
    mesh(group,geo.box,obstacleStone,0,.08,0,7.8,.2,1.3);
    for(const sx of [-1,1]){
      const ped=mesh(group,geo.box,obstacleStone,sx*3.2,.55,.15,.7,1.1,.8);ped.castShadow=true;
      mesh(group,geo.cyl,obstacleStone,sx*3.2,1.16,.15,.42,.18,.42);
    }
    const jets=[];
    for(let i=0;i<6;i++){
      const x=-2.4+i*.96,sc=.85+((i*37)%23)/60;
      const outer=mesh(group,geo.cone,fireOuter,x,.28+1.0*sc,.12,.4*sc,2.0*sc,.4*sc);jets.push(outer);
      const inner=mesh(group,geo.cone,fireCore,x,.28+.82*sc,.12,.2*sc,1.3*sc,.2*sc);jets.push(inner);
      if(FX.flame){
        const fl=new THREE.Sprite(new THREE.SpriteMaterial({map:FX.flame,color:0xffcf86,transparent:true,opacity:.8,depthWrite:false,blending:THREE.AdditiveBlending}));
        fl.position.set(x,1.05*sc+.3,.12);fl.renderOrder=2;fl.userData.flame=true;fl.userData.base=sc;
        group.add(fl);jets.push(fl);
      }
      const glow=makeFlameGlow(x,.9*sc+.35,.12,2.1*sc);group.add(glow);jets.push(glow);
    }
    for(const f of jets)if(!f.isSprite)f.userData.base=f.scale.y;
    group.userData.flames=jets;
    }else if(kind==='block'){
    // Carved stone pedestal (original stone texture) blocking one lane: reads clearly as
    // "change lane", stands chest-high and is textured from the APK carving atlas.
    mesh(group,sharedGeo.pedBody,pedestalMat,0,1.07,0).castShadow=true;
    mesh(group,sharedGeo.pedTop,pedestalMat,0,2.25,0).castShadow=true;
    mesh(group,geo.box,mats.gold,0,2.46,0,1.72,.11,1.02);
    mesh(group,geo.box,mats.moss,0,1.78,.62,1.6,.26,.09);
    mesh(group,sharedGeo.pedCap,pedestalMat,0,.22,0).castShadow=true;
    for(const sx of [-1,1]){for(const sz of [-1,1]){mesh(group,geo.box,pedestalMat,sx*.8,.1,sz*.48,.36,.2,.36)}}
    // Fire bowl on top: a second, unmistakable "do not run into this" cue.
    mesh(group,geo.cyl,pedestalMat,0,2.58,0,.48,.16,.48).castShadow=true;
    mesh(group,geo.cyl,mats.edge,0,2.48,0,.34,.12,.34).castShadow=false;
    if(FX.flame){
      const fl=new THREE.Sprite(new THREE.SpriteMaterial({map:FX.flame,color:0xffc06a,transparent:true,opacity:.95,depthWrite:false,blending:THREE.AdditiveBlending}));
      fl.position.set(0,2.9,0);fl.scale.set(.85,1.15,1);fl.renderOrder=2;fl.userData.flame=true;fl.userData.owner=group;fl.userData.base=.5;
      group.add(fl);flames.push(fl);
    }
    const bglow=makeFlameGlow(0,2.85,0,1.6);bglow.userData.owner=group;group.add(bglow);
  }
  if(!usedPrefab)group.scale.setScalar(groupScale);
  if(kind==='hurdle')addContactShadow(group,1.7);
  else if(kind==='arch')addContactShadow(group,1.25);
  else if(kind==='block')addContactShadow(group,1.15);
  else if(kind==='fire')addContactShadow(group,1.35);
  return {kind,lane,group,pathDistance,passed:false,full};
}
// Original coin face art cropped from the APK wallTexture atlas (matches the APK coin card UVs).
const coinFaceTex=textureLoader.load(`${import.meta.env.BASE_URL}assets/ui/coin-face.png`);coinFaceTex.colorSpace=THREE.SRGBColorSpace;
const coinFaceMat=new THREE.MeshStandardMaterial({map:coinFaceTex,metalness:.32,roughness:.38,emissive:0x8a5a12,emissiveIntensity:.6,transparent:true,alphaTest:.35,side:THREE.DoubleSide});
const coinSideMat=new THREE.MeshStandardMaterial({color:0xc98a26,metalness:.7,roughness:.35});
const coinFaceGeo=new THREE.CircleGeometry(.30,24);
const coinRimGeo=new THREE.CylinderGeometry(.30,.30,.06,24,1,true);coinRimGeo.rotateX(Math.PI/2);
function buildCoinBody(){
  const body=new THREE.Group();
  const front=new THREE.Mesh(coinFaceGeo,coinFaceMat);front.position.z=.031;body.add(front);
  const back=new THREE.Mesh(coinFaceGeo,coinFaceMat);back.rotation.y=Math.PI;back.position.z=-.031;body.add(back);
  const rim=new THREE.Mesh(coinRimGeo,coinSideMat);body.add(rim);
  return body;
}
function createCoin(lane,pathDistance,y=1.3){
  const group=new THREE.Group();placeOnPath(group,pathDistance,lanes[lane]);group.position.y=y;scene.add(group);
  const face=buildCoinBody();group.add(face);
  const gl=makeFlameGlow(0,0,0,.62);gl.material.opacity=.14;gl.material.color.set(0xffd76a);group.add(gl);
  return {lane,group,pathDistance,y,taken:false};
}
// Temple monkeys perched on the roadside: run past one and it snatches a few coins.
const monkeys=[];let nextMonkey=150;
function makeMonkey(scale=1.35){
  const g=new THREE.Group();
  const fur=new THREE.MeshStandardMaterial({color:0x6b4e37,roughness:.9});
  const faceMat=new THREE.MeshStandardMaterial({color:0xc79a6a,roughness:.9});
  mesh(g,geo.sphere,fur,0,.42,0,.3,.36,.26);
  mesh(g,geo.sphere,fur,0,.74,.1,.21,.2,.19);
  mesh(g,geo.sphere,faceMat,0,.71,.27,.13,.12,.09);
  for(const sx of [-1,1]){
    mesh(g,geo.sphere,mats.black,sx*.075,.77,.3,.035,.04,.025);
    mesh(g,geo.cyl,fur,sx*.3,.5,.02,.05,.34,.05).rotation.z=sx*.5;
    mesh(g,geo.sphere,fur,sx*.22,.32,.1,.09,.1,.09);
  }
  mesh(g,geo.cyl,fur,0,.45,-.3,.045,.5,.045).rotation.x=-1.9;
  g.scale.setScalar(scale);
  return g;
}
function spawnMonkey(ahead=16){
  const side=Math.random()<.5?-1:1;
  const g=makeMonkey(1.15);
  const pd=distance+ahead;
  const p=pathAt(pd,side*3.55);
  g.position.set(p.x,1.52,p.z);
  g.rotation.y=side>0?Math.PI/2:-Math.PI/2;
  scene.add(g);
  monkeys.push({group:g,pd,side,taken:false,hop:0});
}
function updateMonkeys(dt){
  for(let i=monkeys.length-1;i>=0;i--){
    const m=monkeys[i],ahead=m.pd-distance;
    if(!m.taken){
      m.group.position.y=1.52+Math.sin(runTime*7+i*2)*.05;
      m.group.rotation.z=Math.sin(runTime*3+i)*.06;
      if(ahead<1.3&&ahead>-1.3){
        m.taken=true;m.hop=0;m.leap=.42;m.leapFrom=m.group.position.clone();
        const steal=Math.min(3,coins);
        if(steal>0){coins-=steal;renderNum($('coins'),coins,'num-sm');setHint(`猴子偷走了 ${steal} 金币！`,1.6);sfx.play('monkey',{gain:.7});sfx.play('coinCascade',{gain:.4});
          for(let k=0;k<steal;k++){const body=buildCoinBody();body.scale.setScalar(.85);
            body.position.copy(m.group.position);body.position.y+=.4;scene.add(body);
            stolenCoins.push({g:body,vx:m.side*(1.6+k*.35),vy:3.6+k*.5,vz:-1.2-k*.4,life:1.1})}}
        else{setHint('猴子：这穷鬼一枚金币都没有',1.5);sfx.play('monkey',{gain:.45})}
        haptic(18);
      }else if(ahead<-24){scene.remove(m.group);monkeys.splice(i,1)}
    }else if(m.leap>0){
      // The thief springs at the runner's shoulder for a beat, then flees into the jungle.
      m.leap-=dt;
      const k=1-Math.max(0,m.leap)/.42;
      const tx=player.position.x+m.side*1.25, ty=player.position.y+1.15, tz=player.position.z-1.55;
      m.group.position.set(
        m.leapFrom.x+(tx-m.leapFrom.x)*k,
        m.leapFrom.y+(ty-m.leapFrom.y)*k+Math.sin(k*Math.PI)*.5,
        m.leapFrom.z+(tz-m.leapFrom.z)*k);
      m.group.rotation.y+=dt*10;
      if(m.leap<=0){m.hop=0;m.group.position.copy(new THREE.Vector3(tx,ty,tz))}
    }else{
      m.hop+=dt*3.6;
      m.group.position.y+=dt*4.2;
      m.group.position.x+=m.side*dt*2.1;
      m.group.rotation.y+=dt*7;
      if(m.hop>1.5){scene.remove(m.group);monkeys.splice(i,1)}
    }
  }
}
