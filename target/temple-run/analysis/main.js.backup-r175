function applySettings(){
  muted=!settings.sfx;
  sfx.setMuted(!settings.sfx);
  if(!settings.music){sfx.stopMusic(.4)}
  else if((state==='menu'||state==='playing'||state==='paused')&&!sfx.musicInfo().current){sfx.startMusic('theme')}
  const ah=$('audioHint');if(ah)ah.classList.toggle('hidden',!settings.music||!!sfx.musicInfo().current);
  const sb=$('soundBtn');if(sb){sb.textContent='♪';sb.classList.toggle('muted',!settings.sfx);sb.setAttribute('aria-label',settings.sfx?'关闭声音':'开启声音')}
  renderer.setPixelRatio(settings.hq?Math.min(devicePixelRatio||1,2):1);
  resize();
}
function haptic(ms=60){if(!settings.haptics)return;try{navigator.vibrate&&navigator.vibrate(ms)}catch{}}
let state='menu', distance=0, coins=0, speed=RUN_SPEED, lane=1, laneX=0, multiplier=1, comboCount=0, lastCoinAt=0, runBestMulti=1, impactFlash=0;
let lastTurnDirection=0, nextTurnLen=0, turnDirectionForced=0;
let lastMilestone=0, milestoneTimer=0, jumpY=0, jumpV=0, sliding=0, runTime=0, nextSpawn=16, nextTurn=57, turnDirection=0, turnQueued=false, turnFlash=0, turnFlashDir=1, playerYaw=0, camLane=0, shakeAmp=0, turnKick=0;
let templeGateTemplate=null;
new OBJLoader().load(`${import.meta.env.BASE_URL}assets/obstacles/tower-arch.obj`,obj=>{
  obj.traverse(part=>{if(part.isMesh){part.material=facadeMat;part.castShadow=true;part.receiveShadow=true}});
  templeGateTemplate=obj;
},undefined,()=>console.warn('Temple gate prefab unavailable'));
let voiceGender='m';
function vkey(k,id){const c=id?CHARS.find(x=>x.id===id):CHARS.find(x=>x.id===charState.equipped);return c&&c.g==='f'?k+'F':k}
function charPitch(){const c=CHARS.find(x=>x.id===charState.equipped);return c&&typeof c.p==='number'?c.p:1}
// Per-character voice colour: the same male/female clip set is detuned so every runner
// sounds different (werewolf deep, skeletons hollow, Selene/Scarlett brighter).
function charPitchFor(id){const c=CHARS.find(x=>x.id===id);return c&&c.p?c.p:1}
function vplay(k,opts={},id){const p=id?charPitchFor(id):charPitch();sfx.play(vkey(k,id),{...opts,detune:(opts.detune||0)+(p-1)*1200})}
function charGender(){const c=CHARS.find(x=>x.id===charState.equipped);return c&&c.g==='f'?'f':'m'}
let chaseGap=4.8,stumbleCooldown=0,turnCount=0,lastTurnDistance=-Infinity,airborne=false,lastStep=0,stumbleKick=0,lastDustAt=0,lastSlideSparkAt=0,jumpBuffer=0,slideBuffer=0,landPulse=0;
// Gateway arches over the corridor: the original temple run passes through carved gates.
const gateways=[];
function spawnGateway(seg,offset=62){
  if(!templeGateTemplate)return;
  const g=templeGateTemplate.clone(true);
  g.rotation.y=Math.PI;g.scale.set(.27,.13,.16);
  const gateMat=new THREE.MeshStandardMaterial({map:facadeMat.map,color:0x9c8760,emissive:0x241c10,emissiveIntensity:.22,roughness:.96,metalness:.02});
  g.traverse(part=>{if(part.isMesh)part.material=gateMat});
  const wrap=new THREE.Group();wrap.add(g);wrap.visible=false;scene.add(wrap);
  gateways.push({group:wrap,seg,pathDistance:seg.start+offset});
}
function updateGateways(){
  for(let i=gateways.length-1;i>=0;i--){
    const gw=gateways[i];
    const expired=gw.pathDistance>gw.seg.end-2; // a turn cut the segment short before the gate
    if(expired||distance-gw.pathDistance>26){scene.remove(gw.group);gateways.splice(i,1);continue}
    gw.group.visible=distance-gw.pathDistance>-40;
    placeOnPath(gw.group,gw.pathDistance);
  }
}
const POWER_KINDS=['magnet','bonus','boost','shield'];
const powerLabel={magnet:'磁铁',bonus:'金币加成',boost:'加速',shield:'护盾'};
const powerColor={magnet:0xff6a52,bonus:0xffd24a,boost:0x54e08a,shield:0x5aa8ff};
const powerDuration={magnet:9,bonus:10,boost:4.5};
let power={type:null,until:0,shield:0},pickups=[],lastPickupAt=-999;
const POWER_METER_MAX=40;let powerMeter=0;let meterHold=0;
// Power-up auras around the runner (shield bubble / magnet ring / boost trail).
const shieldBubble=new THREE.Mesh(new THREE.SphereGeometry(1,18,12),
  new THREE.MeshBasicMaterial({color:0x9fe0ff,transparent:true,opacity:.22,depthWrite:false,side:THREE.DoubleSide}));
shieldBubble.visible=false;shieldBubble.scale.set(1.05,1.25,1.05);shieldBubble.position.y=1.05;player.add(shieldBubble);
const magnetRing=new THREE.Mesh(new THREE.TorusGeometry(.62,.035,8,26),
  new THREE.MeshBasicMaterial({color:0xff7a52,transparent:true,opacity:.85}));
magnetRing.rotation.x=Math.PI/2;magnetRing.visible=false;player.add(magnetRing);
let boostTrailAt=0;
const pwIconUrl={boost:'assets/ui/pw-boost.png',shield:'assets/ui/pw-wings.png',bonus:'assets/ui/pw-bonus.png'};
const pwIconTex={};
for(const k in pwIconUrl)new THREE.TextureLoader().load(`${import.meta.env.BASE_URL}${pwIconUrl[k]}`,t=>{t.colorSpace=THREE.SRGBColorSpace;pwIconTex[k]=t});
function createPickup(kind,lane,pathDistance){
  const group=new THREE.Group();placeOnPath(group,pathDistance,lanes[lane]);group.position.y=1.35;scene.add(group);
  const color=powerColor[kind];
  const iconTex=pwIconTex[kind];
  if(iconTex){
    // Original UI icon as a billboard sprite (matches the game's power-up art).
    const icon=new THREE.Sprite(new THREE.SpriteMaterial({map:iconTex,transparent:true,depthWrite:false}));
    const iw=2.35;icon.scale.set(iw,iw*(iconTex.image.height/iconTex.image.width),1);
    group.add(icon);
  }else{
    const mat=new THREE.MeshStandardMaterial({color,emissive:color,emissiveIntensity:1.15,metalness:.35,roughness:.22});
    mesh(group,sharedGeo.pickupOcta,mat).castShadow=true;
    const ring=mesh(group,sharedGeo.pickupRing,mat);ring.rotation.x=Math.PI/2;
  }
  const glow=new THREE.Sprite(new THREE.SpriteMaterial({map:flameGlow,color,transparent:true,depthWrite:false,blending:THREE.AdditiveBlending,opacity:.7}));
  glow.scale.setScalar(iconTex?2.1:2.9);glow.material.opacity=iconTex?.3:.7;group.add(glow);group.userData.glow=glow;
  return {kind,lane,group,pathDistance,taken:false};
}
function createGemPickup(lane,pathDistance){
  const group=new THREE.Group();placeOnPath(group,pathDistance,lanes[lane]);group.position.y=1.35;scene.add(group);
  const gemMat=new THREE.MeshStandardMaterial({color:0xff5a7a,emissive:0xff2d5e,emissiveIntensity:.9,metalness:.45,roughness:.25});
  const core=new THREE.Mesh(sharedGeo.gemCore,gemMat);core.scale.y=1.35;group.add(core);
  const glow=makeFlameGlow(0,0,0,1.7);glow.material.color.set(0xff7d9a);glow.material.opacity=.5;group.add(glow);group.userData.glow=glow;
  return {lane,group,pathDistance,taken:false};
}
function activatePower(kind){
  if(kind==='shield'){power.type='shield';power.shield=1;power.until=0}
  else{power.type=kind;power.until=runTime+powerDuration[kind]+(kind==='magnet'?upLvl('magnet')*1.2:0);power.shield=0}
  if(kind==='boost')sfx.startLoop('boostLoop',{gain:.9});
  else if(kind==='magnet')sfx.play('magnet',{gain:.9});
  else sfx.play('shimmer',{gain:.8});
  updatePowerBadge();showPowerToast(kind);
  const clip=kind==='shield'?'angelWings':kind==='bonus'?'scoreBlast':kind==='boost'?'wings':'recharged';
  sfx.play(clip,{gain:.85});
}
function updatePowerMeter(){
  const wrap=$('powerMeter'),fill=$('powerFill');
  if(!wrap||!fill)return;
  const on=state==='playing';
  wrap.classList.toggle('hidden',!on);
  const pct=Math.min(100,powerMeter/POWER_METER_MAX*100);
  fill.style.width=pct+'%';
  wrap.classList.toggle('full',pct>=100);
}
function chargePowerMeter(n=1){
  powerMeter=Math.min(POWER_METER_MAX,powerMeter+n);
  updatePowerMeter();
  if(powerMeter>=POWER_METER_MAX&&meterHold<=0){
    // Hold the full bar for a beat so the player actually sees it filled, then grant the power.
    meterHold=.55;updatePowerMeter();
    const p=new THREE.Vector3(player.position.x,1.3,player.position.z);
    spawnSparks(p,0xffd76a,18,1.6,.6,1.1,'sparkle');spawnSparks(p,0xfff2c8,10,1.1,.45,.8,'spark');
    impactFlash=Math.max(impactFlash,.55);
    sfx.play('meterFull',{gain:.85});haptic(35);
  }
}
const POWER_ICON={magnet:'coin.png',bonus:'pw-bonus.png',boost:'pw-boost.png',shield:'pw-wings.png'};
const POWER_TITLE={magnet:'磁铁激活！',bonus:'金币加成！',boost:'加速冲刺！',shield:'护盾开启！'};
function powerIconURL(kind){return `${import.meta.env.BASE_URL}assets/ui/${POWER_ICON[kind]||'coin.png'}`}
let powerToastTimer=0;
function showPowerToast(kind){
  const el=$('powerToast');if(!el)return;
  el.querySelector('img').src=powerIconURL(kind);
  el.querySelector('strong').textContent=POWER_TITLE[kind]||'获得强化';
  el.classList.remove('hidden','pop');void el.offsetWidth;el.classList.add('pop');
  powerToastTimer=1.5;
}
function updateSpeedLines(){
  const el=$('speedlines');if(!el)return;
  const on=state==='playing'&&power.type==='boost'&&runTime<power.until;
  el.classList.toggle('on',on);
}
function updatePowerBadge(){
  const el=$('powerBadge');if(!el)return;
  let label='',rem=0,kind=power.type;
  if(power.shield>0){label=powerLabel.shield;kind='shield'}
  else if(power.type&&power.until>0){label=powerLabel[power.type];rem=Math.max(0,power.until-runTime)}
  if(!label){el.classList.add('hidden');return}
  el.classList.remove('hidden');
  const hex=(powerColor[kind||'shield']).toString(16).padStart(6,'0');
  el.style.borderColor=`#${hex}`;
  el.style.boxShadow=`0 0 0 2px #${hex}55,0 4px 12px #0008`;
  el.innerHTML=`<img class="pw-ico" src="${powerIconURL(kind||'shield')}" alt="">`+(rem>0?`${label} ${rem.toFixed(0)}s`:`${label} · 就绪`);
}
let death=null;
let obstacles=[],coinItems=[],gemItems=[],previous=performance.now(),hintTimeout=0,lastJumpAt=-9,lastSlideAt=-9;
let gems=charState.gems||0;
let reviveUsed=false,invincibleUntil=0,deathRun=null;
const show=(id,on)=>$(id).classList.toggle('hidden',!on);
function setHint(value,duration=1.2){if(turnDirection!==0)return;$('hint').textContent=value;$('hint').classList.add('visible');hintTimeout=duration}
function clearObjects(){
  while(turnGuides.length){const g=turnGuides.pop();scene.remove(g)}
for(const sp of leafSprites){scene.remove(sp)}leafSprites.length=0;for(const item of [...obstacles,...coinItems,...gemItems,...pickups])scene.remove(item.group);obstacles=[];coinItems=[];gemItems=[];pickups=[]}
const tutorialKey='atb_temple_run_tutorial_v1';
let tutorialActive=false;
function hideTutorial(){const t=$('tutorial');if(t)t.classList.add('hidden');tutorialActive=false}
function dismissTutorial(){if(tutorialActive)hideTutorial()}
function maybeShowTutorial(force){
  const t=$('tutorial');if(!t)return;
  let seen=false;try{seen=!!localStorage.getItem(tutorialKey)}catch{}
  if(seen&&!force)return;
  tutorialActive=true;
  t.classList.remove('hidden');
  try{localStorage.setItem(tutorialKey,'1')}catch{}
  clearTimeout(maybeShowTutorial.timer); // stays until the player taps / presses a key
}
// HUD digits use the original gold numeral sprites extracted from the game's font atlas.
const DIGIT_SRC={};for(const d of '0123456789')DIGIT_SRC[d]=`${import.meta.env.BASE_URL}assets/ui/score-${d}.png`;
const DIGIT_IMG={};for(const d of '0123456789'){const img=new Image();img.src=DIGIT_SRC[d];img.alt=d;DIGIT_IMG[d]=img}
// Coin/gem pickups fly from their 3D position into the HUD counter (juice, like the original).
let flyCount=0;
function spawnFlyCoin(worldPos,kind='coin'){
  if(flyCount>=6)return;
  const v=worldPos.clone().project(camera);
  if(v.z>1)return;
  const x=(v.x*.5+.5)*window.innerWidth,y=(-v.y*.5+.5)*window.innerHeight;
  const img=document.createElement('img');
  img.className='fly-coin';img.src=`${import.meta.env.BASE_URL}assets/ui/${kind==='gem'?'gem.png':'coin.png'}`;
  img.style.left=x+'px';img.style.top=y+'px';
  document.body.appendChild(img);flyCount++;
  const targetEl=document.getElementById(kind==='gem'?'gems':'coins');if(!targetEl)return;const target=targetEl.getBoundingClientRect();
  requestAnimationFrame(()=>{requestAnimationFrame(()=>{
    const s=kind==='gem'?.55:.5;
    img.style.transform=`translate(${target.left-x+2}px,${target.top-y+2}px) scale(${s})`;
    img.style.opacity='.15';
  })});
  setTimeout(()=>{img.remove();flyCount--},420);
}
function renderNum(el,value,extra=''){
  if(!el)return;
  if(el.dataset.num===String(value)&&el.dataset.extra===extra)return;
  el.dataset.num=String(value);el.dataset.extra=extra;
  el.textContent='';
  el.classList.add('num');if(extra)el.classList.add(extra);
  // Shrink long numbers so they stay inside the score plate.
  const len=String(value).length;
  el.classList.toggle('long',extra==='num-lg'&&len>4);
  el.classList.toggle('longer',extra==='num-lg'&&len>5);
  for(const ch of String(value)){
    if(DIGIT_IMG[ch]){const im=DIGIT_IMG[ch].cloneNode();im.draggable=false;el.appendChild(im)}
    else{const sp=document.createElement('span');sp.textContent=ch;el.appendChild(sp)}
  }
}
// Same gold numerals, but as markup for templates rendered through innerHTML.
function numHTML(value,cls='num-sm'){
  const out=[];
  for(const ch of String(value)){
    if(/[0-9]/.test(ch))out.push(`<img class="num-img" src="${DIGIT_SRC[ch]}" alt="${ch}">`);
    else out.push(`<span class="num-txt">${ch}</span>`);
  }
  return `<span class="num ${cls}">${out.join('')}</span>`;
}
function reset(){
  document.querySelectorAll('.fly-coin').forEach(el=>el.remove());flyCount=0;
  window.__frictionOn=false;sfx.stopFriction();
  commitRun(); // bank/lifetime stats must survive a direct restart as well
  voiceGender=charGender();
  stopReviveTimer();
  const dv=$('deathVignette');if(dv){dv.classList.remove('on');dv.classList.add('hidden')}
  sfx.stopAllLoops();sfx.play('click');if(settings.music)sfx.startMusic('theme');
  for(const m of monkeys)scene.remove(m.group);monkeys.length=0;nextMonkey=150;
  clearObjects();while(stolenCoins.length)scene.remove(stolenCoins.pop().g);distance=0;coins=0;coinValueAcc=0;speed=RUN_SPEED;lane=1;laneX=0;jumpY=0;jumpV=0;sliding=0;runTime=0;death=null;multiplier=1;comboCount=0;lastCoinAt=0;runBestMulti=1;impactFlash=0;const ifl=$('impactFlash');if(ifl)ifl.style.opacity='0';updateMultiBadge();reviveUsed=false;invincibleUntil=0;deathRun=null;body.visible=true;
  {const ac=$('actionCue');if(ac)ac.classList.add('hidden')}
  power={type:null,until:0,shield:0};updatePowerBadge();shieldBubble.visible=false;magnetRing.visible=false;powerMeter=0;updatePowerMeter();
  lastMilestone=0;lastCoinMilestone=0;lastGemMilestone=0;nextMonkeyCall=22;milestoneTimer=0;$('milestone').classList.add('hidden');$('milestone').classList.remove('pop');
  nextSpawn=16;nextTurn=57;turnDirection=0;turnQueued=false;turnFlash=0;turnFlashDir=1;turnCount=0;lastTurnDistance=-Infinity;lastTurnDirection=0;nextTurnLen=0;turnDirectionForced=0;chaseGap=11.5;stumbleCooldown=0;playerYaw=0;stumbleKick=0;
  junction.visible=false;tiles.forEach(tile=>tile.decor.visible=true);
  pathSegments.length=1;Object.assign(pathSegments[0],{start:0,end:Infinity,x:0,z:PLAYER_Z,heading:0});
  for(const gw of gateways)scene.remove(gw.group);gateways.length=0;spawnGateway(pathSegments[0],42);
  tiles.forEach((tile,i)=>{tile.pathDistance=-9+i*TILE;placeOnPath(tile,tile.pathDistance)});
  for(let i=0;i<6;i++)coinItems.push(createCoin(1,15+i*2.7));
  player.position.set(0,0,PLAYER_Z);body.position.y=0;body.scale.y=1;body.rotation.set(0,0,0);enemy.scale.setScalar(1);setShadowAlpha(1);
  $('distance').textContent='0';renderNum($('coins'),0,'num-sm');show('menu',false);show('pauseOverlay',false);show('endOverlay',false);show('turnCue',false);$('turnEdge')&&$('turnEdge').classList.remove('show');$('turnEdge')&&$('turnEdge').classList.remove('show');
  state='playing';closePanel();setHint('向左或向右换道 · 向上跳跃 · 向下滑铲',2.8);
  // Drop-in intro: start slightly high and let the chase camera settle in.
  const intro=pathAt(-9);camera.position.set(intro.x,7.4,intro.z);camera.lookAt(0,1.4,PLAYER_Z-8);
  maybeShowTutorial(false);
}
function finishDeath(){
  sfx.stopMusic(1.4);
  if(state!=='dying')return;
  state='ended';updatePowerMeter();const previousBest=best;best=Math.max(best,Math.floor(distance));
  sfx.play('gameOver');
  if(best>previousBest&&best>0)vplay('best');
  const art={fall:'deathIllustrationFallA@2x.png',caught:'deathIllustrationEaten@2x.png',impact:'deathIllustrationTree@2x.png'}[death.kind]||'deathIllustrationSlide@2x.png';
  $('endArt').src=`${import.meta.env.BASE_URL}assets/ui/${art}`;
  try{localStorage.setItem(storeKey,String(best))}catch{}
  $('gems').textContent=gems;renderNum($('endDistance'),`${Math.floor(distance)} m`,'num-md');renderNum($('endCoins'),coins,'num-md');renderNum($('endBest'),`${best} m`,'num-md');const etc=$('endTotalCoins');if(etc)etc.innerHTML=`累计收集金币 <b>${fmtNum(stats.totalCoins+coins)}</b>`;const em=$('endMulti');if(em)em.textContent='×'+runBestMulti;
  $('endReason').textContent=death.reason;
  deathRun={distance:Math.floor(distance),coins,multiplier:runBestMulti,turns:turnCount};
  const nb=$('newBestTag');if(nb)nb.classList.toggle('hidden',!(best>previousBest&&best>0));
  updateReviveButton();startReviveTimer();
  show('endOverlay',true);
}
const REVIVE_WINDOW=8;let reviveTimer=0,reviveTick=null;
function stopReviveTimer(){if(reviveTick){clearInterval(reviveTick);reviveTick=null}}
function startReviveTimer(){
  stopReviveTimer();reviveTimer=REVIVE_WINDOW;
  const bar=$('reviveBar');if(bar)bar.style.width='100%';
  reviveTick=setInterval(()=>{
    if(state!=='ended'){stopReviveTimer();return}
    reviveTimer=Math.max(0,reviveTimer-.1);
    const b=$('reviveBar');if(b)b.style.width=(reviveTimer/REVIVE_WINDOW*100).toFixed(1)+'%';
    const nt=$('reviveNote');
    if(nt&&!reviveUsed&&revivePayment())nt.textContent=`限时 ${Math.ceil(reviveTimer)}s · 每局可复活一次`;
    if(reviveTimer<=0){stopReviveTimer();reviveUsed=true;updateReviveButton();const n=$('reviveNote');if(n)n.textContent='复活机会已过期';}
  },100);
}
function revivePayment(){
  const coinCost=reviveCostNow();
  if(coins>=coinCost)return {type:'coins',amount:coinCost};
  if((charState.gems||0)>=1)return {type:'gems',amount:1};
  return null;
}
function updateReviveButton(){
  const btn=$('reviveBtn');
  if(!btn)return;
  if(reviveUsed){btn.classList.add('disabled');$('reviveCost').textContent=reviveTimer<=0?'已过期':'已用';$('reviveNote').textContent=reviveTimer<=0?'复活机会已过期':'本局已复活过一次';return}
  const pay=revivePayment();
  const lb=$('reviveLabel');if(lb)lb.textContent=pay&&pay.type==='gems'?'宝石复活':'金币复活';
  if(!pay){btn.classList.add('disabled');$('reviveCost').textContent='币不足';$('reviveNote').textContent=`需要 ${reviveCostNow()} 金币或 1 宝石（本局 ${coins} 金币 / ${charState.gems||0} 宝石）`;return}
  btn.classList.remove('disabled');
  if(pay.type==='coins'){$('reviveCost').textContent=String(pay.amount);$('reviveNote').textContent='每局可复活一次，保留当前里程'}
  else{$('reviveCost').textContent='◆ 1';$('reviveNote').textContent=`金币不足 · 消耗 1 宝石复活（剩余 ${charState.gems||0} 宝石）`}
}
function commitRun(){
  if(!deathRun)return;
  charState.bank+=deathRun.coins;saveCharState();
  stats.runs+=1;stats.totalDistance+=deathRun.distance;stats.totalCoins+=deathRun.coins;
  stats.bestMulti=Math.max(stats.bestMulti,deathRun.multiplier);stats.turns+=deathRun.turns;saveStats();
  deathRun=null;updateMenuCoins();
}
function revive(){
  if(state!=='ended'||reviveUsed||reviveTimer<=0)return;
  const pay=revivePayment();if(!pay)return;
  stopReviveTimer();
  if(pay.type==='coins'){coins-=pay.amount;renderNum($('coins'),coins,'num-sm');stats.coinsSpent+=pay.amount;saveStats()}
  else{charState.gems-=1;gems=charState.gems;$('gems').textContent=gems;saveCharState()}
  reviveUsed=true;stats.revives=(stats.revives||0)+1;saveStats();
  state='playing';death=null;show('endOverlay',false);if(settings.music)sfx.startMusic('theme');
  // Revival burst: golden/white sparks around the runner (original wings cue).
  for(let i=0;i<3;i++)spawnSparks(new THREE.Vector3(player.position.x+(Math.random()-.5)*1.2,1+Math.random()*1.4,player.position.z+(Math.random()-.5)*1.2),i===1?0xffffff:0xffd75e,10,1.1,.5,.9,i===1?'wings':'sparkle');
  distance=Math.max(0,distance-12);
  speed=RUN_SPEED_MIN+Math.min(RUN_SPEED_MAX-RUN_SPEED_MIN,distance*.02);
  clearObjects();nextSpawn=distance+26;
  jumpY=0;jumpV=0;sliding=0;stumbleCooldown=0;chaseGap=8;multiplier=1;comboCount=0;updateMultiBadge();
  body.rotation.set(0,0,0);body.scale.y=1;player.position.y=0;enemy.scale.setScalar(1);
  turnDirection=0;turnQueued=false;show('turnCue',false);$('turnEdge').classList.remove('show');junction.visible=false;
  nextTurn=9+12*Math.max(1,Math.round((distance+72-9)/12));
  pathSegments.length=1;Object.assign(pathSegments[0],{start:0,end:Infinity,x:0,z:PLAYER_Z,heading:0});
  invincibleUntil=runTime+2.6;
  setHint('复活成功！短暂无敌',1.8);sfx.play('recharged',{gain:.9});sfx.play('wooosh',{gain:.6});haptic(40);
}
function goMenu(){hideTutorial();commitRun();reset();state='menu';show('menu',true);updateMenuCoins();$('distance').textContent='0';renderNum($('coins'),0,'num-sm');if(settings.music)sfx.startMusic('theme')}
function end(reason,kind='impact'){
  if(state!=='playing')return;
  window.__frictionOn=false;sfx.stopFriction();
  state='dying';death={reason,kind,elapsed:0,duration:kind==='fall'?1.55:kind==='caught'?1.4:1.25,
    pitch:body.rotation.x,roll:body.rotation.z,height:player.position.y,gap:chaseGap};
  if(kind==='fall')vplay('scream');else vplay('splat');haptic(kind==='fall'?90:60);
  // A death ends any active power-up (original behaviour).
  power={type:null,until:0,shield:0};shieldBubble.visible=false;magnetRing.visible=false;updatePowerBadge();updateSpeedLines();
  show('turnCue',false);$('hint').classList.remove('visible');
  const dv=$('deathVignette');if(dv){dv.classList.remove('hidden');void dv.offsetWidth;dv.classList.add('on')}
  const ac=$('actionCue');if(ac)ac.classList.add('hidden');
}
function updateDeath(dt){
  death.elapsed+=dt;
  const progress=Math.min(1,death.elapsed/death.duration),ease=1-(1-progress)**2;
  if(death.kind==='fall'&&progress>.55&&!death.splashed){death.splashed=true;sfx.play('splash',{gain:.9});shakeAmp=Math.max(shakeAmp,.08);haptic(70)}
  if(death.kind==='fall'){
    player.position.y=death.height-6*progress;
    body.rotation.x=THREE.MathUtils.lerp(death.pitch,-.55,ease);
    body.rotation.z=THREE.MathUtils.lerp(death.roll,.35,ease);
    setShadowAlpha(1-progress);
  }else{
    const caught=death.kind==='caught';
    player.position.y=THREE.MathUtils.lerp(death.height,0,ease);
    body.rotation.x=THREE.MathUtils.lerp(death.pitch,caught?.65:-1.35,ease);
    body.rotation.z=THREE.MathUtils.lerp(death.roll,caught?-.8:.38,ease);
    body.position.y=-.16*ease;
    chaseGap=THREE.MathUtils.lerp(death.gap,caught?.25:2.2,ease);
    placeOnPath(enemy,distance-chaseGap,Math.sin(runTime*5)*.3);
    enemy.position.y=.08+Math.sin(progress*Math.PI)*.35;
    enemy.scale.setScalar(1+Math.sin(progress*Math.PI)*.12);
  }
  // Death cinematic: dolly in and tilt down onto the runner.
  const back=pathAt(distance-5.0,laneX*.1);
  const settle=Math.min(1,death.elapsed/.9);
  camera.position.lerp(new THREE.Vector3(back.x,3.15-settle*.75,back.z),Math.min(1,dt*5.5));
  camera.lookAt(player.position.x,1.0+settle*.25,player.position.z);
  camera.fov+=(48-camera.fov)*Math.min(1,dt*4);camera.updateProjectionMatrix();
  if(progress>=1)finishDeath();
}
function pause(){if(state==='playing'){state='paused';window.__frictionOn=false;sfx.stopFriction();sfx.play('click',{gain:.6});sfx.pauseMusic();
  const pd=$('pauseDistance'),pc=$('pauseCoins'),pm=$('pauseMulti');
  if(pd)pd.textContent=`${Math.floor(distance)} m`;if(pc)pc.textContent=String(coins);if(pm)pm.textContent='×'+multiplier;
  show('pauseOverlay',true)}else if(state==='paused'){state='playing';sfx.resumeMusic();show('pauseOverlay',false);previous=performance.now()}}
function dampAngle(current,target,lambda,dt){const delta=((target-current+Math.PI)%(Math.PI*2)+Math.PI*2)%(Math.PI*2)-Math.PI;return current+delta*(1-Math.exp(-lambda*dt))}
function updateTurnCue(){
  if(turnDirection===0)return;
  const remain=Math.max(0,Math.ceil(nextTurn-distance));
  $('turnArrow').src=turnDirection<0?'/assets/ui/arrow-left.png':'/assets/ui/arrow-right.png';
  $('turnText').textContent=turnQueued?'转弯已确认':`${turnDirection<0?'前方左转':'前方右转'} · ${remain} m`;
  $('turnCue').classList.toggle('ready',turnQueued);
  // Big edge-of-screen arrow once the junction is close (extra clarity on phones).
  const edge=$('turnEdge');if(edge){
    const near=remain<=18;
    edge.classList.toggle('left',turnDirection<0);edge.classList.toggle('right',turnDirection>0);
    edge.classList.toggle('ready',turnQueued);edge.classList.toggle('hidden',!near);edge.classList.toggle('show',near);edge.classList.toggle('urgent',near&&!turnQueued&&remain<=6);
    $('turnEdgeImg').src=turnDirection<0?'/assets/ui/arrow-left.png':'/assets/ui/arrow-right.png';
    $('turnEdgeTxt').textContent=turnQueued?'已确认':`${turnDirection<0?'左转':'右转'} · ${remain}m`;
  }
}
function beginTurn(){
  turnDirection=turnDirectionForced||(rand(Math.floor(nextTurn))>.5?1:-1);turnDirectionForced=0;
  junctionHeading=pathAt(nextTurn-.01).heading;
  addPathTurn(nextTurn,turnDirection);
  const corner=pathAt(nextTurn);junctionCorner={x:corner.x,z:corner.z};
  buildJunction(turnDirection);
  junction.visible=true;turnQueued=false;
  updateTurnCue();show('turnCue',true);
  sfx.play('whoosh',{gain:.8});
  // Coin trail arcing through the corner (original guides you into the turn with coins).
  for(let i=0;i<6;i++){
    const cd=nextTurn-5+i*2.2;
    const c=createCoin(1,cd);placeOnPath(c.group,cd,lanes[1],true);
    coinItems.push(c);
  }
}
function completeTurn(){
  turnCount++;lastTurnDistance=nextTurn;turnFlash=1.1;turnFlashDir=turnDirection;shakeAmp=Math.max(shakeAmp,.16);turnKick=1;
  // Drift kick: scuff dust off both feet as the turn completes.
  {const f=pathAt(distance-1.1,laneX);
   for(const sgn of [-1,1]){const q=pathAt(distance-1.05,laneX+sgn*.45);dustPuff(new THREE.Vector3(q.x,.12,q.z),4,.5)}
   spawnSparks(new THREE.Vector3(f.x,.55,f.z),0xe8dcc0,5,.9,.5,.7,'spark')}
  const gap=nextTurn-lastTurnDistance; // 0 on first completed turn
  const prevDir=turnDirection;
  turnDirection=0;turnQueued=false;
  const len=pickNextTurnLength(nextTurn*.53+turnCount);
  nextTurn=9+12*Math.max(1,Math.round((nextTurn+len-9)/12));
  nextTurnLen=nextTurn-lastTurnDistance;
  // short follow-up corner: 60% opposite (S-curve) / 40% same way (U-turn)
  if(nextTurnLen<84&&lastTurnDirection!==0){turnDirectionForced=rand(nextTurn*1.9+5.2)>.4?-lastTurnDirection:lastTurnDirection}
  else turnDirectionForced=0;
  lastTurnDirection=prevDir;
  show('turnCue',false);$('turnCue').classList.remove('ready');$('turnEdge').classList.remove('show');
  setHint('漂亮的转弯！',.9);
  sfx.play('swish',{rate:1.15});
}
function stumbleOrCatch(){
  if(stumbleCooldown>0){chaseGap=1.2;end('追逐者抓住了你。','caught')}
  else{stumbleCooldown=8;chaseGap=3.8;impactFlash=1;shakeAmp=Math.max(shakeAmp,.14);spawnSparks(player.position,0xd8c9a0,10,1.2,.42,.5,'spark');spawnSparks(player.position,0x8f7d5c,14,1.6,.9,1.05,'dust');spawnSparks(player.position,0xffc16b,9,1.1,.5,.75,'ember');setHint('绊倒了！追逐者靠近了',1.6);vplay('stumble',{gain:.9});haptic(70);stumbleKick=1}
}
function move(dir){
  if(state!=='playing')return;
  // Swiping the correct way near a corner queues the turn, but must NOT freeze lane changes:
  // the original still lets you dodge obstacles in the corner approach.
  if(turnDirection!==0 && distance>=nextTurn-42 && distance<nextTurn+2 && dir===turnDirection && !turnQueued){
    turnQueued=true;updateTurnCue();sfx.play('click',{gain:.5});setHint('方向正确，保持住！',.9);
    spawnSparks(new THREE.Vector3(player.position.x,1.25,player.position.z),0xa8e88d,8,1.0,.32,.5);haptic(12);
  }
  lane=Math.max(0,Math.min(2,lane+dir));
  sfx.play('swish',{gain:.55,rate:.95+Math.random()*.1});
}
function jump(){if(state!=='playing')return;if(jumpY<=.02 && jumpV<=0){jumpV=8.8;sliding=0;airborne=true;lastJumpAt=runTime;setHint('跳！',.35);vplay('jump',{gain:.85});sfx.play('whoosh',{gain:.32,rate:1.12});jumpKick()}else jumpBuffer=.16}
function slide(){if(state!=='playing')return;if(jumpY<.12){sliding=1.05;setHint('滑铲！',.35);sfx.play('slide',{gain:1.3})}else{jumpV=-8;slideBuffer=.24}}
function spawnWave(){
  // Rare idol gems (TR1 style), spawned a bit further than the obstacle wave.
  {const gSeed=Math.floor(nextSpawn);
   if(rand(gSeed+911)>.9&&Math.abs(distance+99-nextTurn)>26){gemItems.push(createGemPickup(Math.floor(rand(gSeed+37)*3),distance+99))}}
  // Wave patterns like the original: single full-width piece, forced-lane pair, or staggered pair.
  const base=distance+83;
  // Keep the junction plaza clean: never spawn obstacles/coins on the turn platform.
  if(Math.abs(base-nextTurn)<26||Math.abs(base+8-nextTurn)<26){nextSpawn+=13;return}
  // ...and give the player a clear run-out after each corner (short snake sections are tight).
  if(base-lastTurnDistance<22){nextSpawn+=13;return}
  const seed=Math.floor(nextSpawn);
  const fullKinds=['hurdle','arch','gap','fire'];
  let obstacleLane=1,safeLane=1,span=26,blockers=0;
  const pattern=rand(seed+301);
  if(pattern<.45){
    const kind=fullKinds[Math.floor(rand(seed)*4)];
    obstacleLane=Math.floor(rand(seed+22)*3);
    obstacles.push(createObstacle(kind,obstacleLane,base));
    safeLane=Math.floor(rand(seed+50)*3);
    span=22+rand(seed+8)*10;
  }else if(pattern<.72){
    // Two lane blockers side by side: one lane is forced (the original's signature "doorway" wave).
    const l1=Math.floor(rand(seed+2)*3),l2=(l1+1+Math.floor(rand(seed+3)*2))%3;
    obstacles.push(createObstacle('block',l1,base));
    obstacles.push(createObstacle('block',l2,base));
    safeLane=3-l1-l2;obstacleLane=l1;blockers=2;
    span=24+rand(seed+8)*9;
  }else if(pattern<.9){
    // Staggered pair: dodge, then dodge again the other way.
    const l1=Math.floor(rand(seed+4)*3),l2=(l1+1+Math.floor(rand(seed+5)*2))%3;
    obstacles.push(createObstacle('block',l1,base));
    obstacles.push(createObstacle('block',l2,base+8));
    safeLane=3-l1-l2;obstacleLane=l1;blockers=1;
    span=32+rand(seed+8)*8;
  }else{
    // Full-width piece with a coin arc over/through it.
    const kind=fullKinds[Math.floor(rand(seed+6)*4)];
    obstacleLane=Math.floor(rand(seed+22)*3);
    obstacles.push(createObstacle(kind,obstacleLane,base));
    safeLane=Math.floor(rand(seed+50)*3);
    span=26+rand(seed+8)*8;
  }
  // Coins must never intersect an obstacle: full-width pieces clear 6.5 m around them,
  // lane blockers clear 4 m on their own lane (the player needs room to read the dodge).
  const coinFits=(pd,ln)=>{for(const o of obstacles){const dd=Math.abs(o.pathDistance-pd);if(o.full&&dd<6.5)return false;if(!o.full&&o.lane===ln&&dd<4)return false}return true};
  let placed=0;const arc=rand(seed+61)>.68;
  for(let cd=distance+70;placed<5&&cd<distance+96;cd+=2.2){if(cd-lastTurnDistance<20)continue;
    if(coinFits(cd,safeLane)){
      const y=arc?1.35+Math.sin((placed/4)*Math.PI)*1.25:1.3;
      coinItems.push(createCoin(safeLane,cd,y));placed++
    }
  }
  if(rand(seed+75)>.72&&!blockers)for(let i=0;i<3;i++){
    const cd=distance+91+i*2.6;if(coinFits(cd,obstacleLane))coinItems.push(createCoin(obstacleLane,cd));
  }
  if((distance-lastPickupAt>170||rand(seed+137)>.8)&&coinFits(distance+83,safeLane)){
    pickups.push(createPickup(POWER_KINDS[Math.floor(rand(seed+91)*4)],safeLane,distance+83));lastPickupAt=distance;
  }
  nextSpawn+=span;
}
let lastCoinMilestone=0,lastGemMilestone=0;
let nextMonkeyCall=22;
// Falling jungle leaves: small sprite flakes drifting down in front of the runner.
function spawnLeaf(){
  const sp=new THREE.Sprite(new THREE.SpriteMaterial({map:leafAtlas,color:0x9dbb84,transparent:true,opacity:.9,depthWrite:false}));
  const side=Math.random()<.5?-1:1;
  const x=player.position.x+side*(2.6+Math.random()*4.4);
  const y=7.2+Math.random()*3.2;
  const z=player.position.z-4-Math.random()*22;
  sp.position.set(x,y,z);
  const sc=.22+Math.random()*.22;sp.scale.set(sc,sc,1);
  sp.material.rotation=Math.random()*6.28;
  sp.userData.leaf={vy:-(.7+Math.random()*.9),baseX:x,phase:Math.random()*6.28};
  scene.add(sp);leafSprites.push(sp);
}

function showMilestone(m,unit='m'){
  const el=$('milestone');if(!el)return;
  const art=el.querySelector('.nj-art');
  if(art)art.src=(unit==='m'&&m>=1000)?`${import.meta.env.BASE_URL}assets/ui/highscore.png`:`${import.meta.env.BASE_URL}assets/ui/nicejob.png`;
  $('milestoneText').innerHTML=numHTML(Math.round(m),'num-md')+`<span class="unit">${unit}</span>`;
  el.classList.remove('hidden','pop');void el.offsetWidth;el.classList.add('pop');
  milestoneTimer=2.0;
  if(unit==='金币')sfx.play('coinCascade',{gain:.65});
  else if(unit==='宝石')sfx.play('shimmer',{gain:.6});
  else vplay('best',{gain:.55});
}
function update(dt){
  if(meterHold>0){meterHold-=dt;if(meterHold<=0){powerMeter=0;updatePowerMeter();const kind=POWER_KINDS[Math.floor(Math.random()*POWER_KINDS.length)];activatePower(kind);sfx.play('recharged',{gain:.9})}}
  if(distance>flameGcAt){flameGcAt=distance+24;for(let i=flames.length-1;i>=0;i--){let o=flames[i];while(o.parent)o=o.parent;if(o!==scene)flames.splice(i,1)}}
  if(state==='dying'){updateDeath(dt);return}
  if(state!=='playing')return;
  runTime+=dt;
  if(milestoneTimer>0){milestoneTimer-=dt;if(milestoneTimer<=0)$('milestone').classList.add('hidden')}
  {const ms=Math.floor(distance/500)*500;if(ms>0&&ms>lastMilestone){lastMilestone=ms;showMilestone(ms)}}
  if(multiplier>1&&runTime-lastCoinAt>2.4){multiplier=1;comboCount=0;updateMultiBadge()}distance+=speed*dt;
  if(power.until>0&&runTime>power.until){power.type=null;power.until=0;sfx.play('recharged',{gain:.4})}
  if(airborne&&jumpY===0&&jumpV===0){airborne=false;vplay('land',{gain:.8})}
  updatePowerBadge();
  // Auras
  const shieldOn=power.shield>0,magnetOn2=power.type==='magnet',boostOn2=power.type==='boost';
  shieldBubble.visible=shieldOn;
  if(shieldOn){const pulse=1+Math.sin(runTime*5.5)*.05;shieldBubble.scale.set(1.05*pulse,1.25*pulse,1.05*pulse);shieldBubble.material.opacity=.13+Math.sin(runTime*5.5)*.04}
  magnetRing.visible=magnetOn2;
  if(magnetOn2){magnetRing.rotation.z=runTime*3.2;magnetRing.position.y=1.15+Math.sin(runTime*3.4)*.12}
  if(boostOn2&&runTime-boostTrailAt>.09){boostTrailAt=runTime;const p=pathAt(distance-1.2,laneX);spawnSparks(new THREE.Vector3(p.x,.6+Math.random()*.9,p.z),0x66ffb0,2,.5,.3,.5)}
  if(speed>0&&speed!==0)speed=RUN_SPEED_MIN+Math.min(RUN_SPEED_MAX-RUN_SPEED_MIN,distance*.02);
  const boostOn=power.type==='boost';if(boostOn){distance+=speed*.55*dt}
  const step=Math.floor(runTime/.21);
  if(step!==lastStep)lastStep=step;
  // Continuous original per-surface footstep loop (stone corridor vs wooden bridge).
  if(jumpY<=.02&&!sliding&&stumbleCooldown<=0&&state==='playing'){
    setStepSurface(isBridgeTile(distance)?'stepPlank':(isCliffTile(distance)?'stepCliff':'stepTemple'));
    {const lv=isCliffTile(distance)?.42:isCliffTile(distance+8)?.3:isCliffTile(distance+20)?.2:0;if(lv)sfx.startWaterfall(lv);else sfx.stopWaterfall();
     const wl=isCliffTile(distance)?.2:isCliffTile(distance+8)?.15:(isCliffTile(distance+24)?.1:(isCliffTile(distance-24)?.08:0));if(wl)sfx.startWind(wl);else sfx.stopWind();}
    sfx.setLoopRate(stepSurface,.82+Math.max(0,speed-RUN_SPEED_MIN)*.028);
    sfx.setAmbience(isBridgeTile(distance)?'water':null,isBridgeTile(distance)?.42:.3); // canyon wind is the richer gust loop below
    if(hallReverbOn!==isHallTile(distance)){hallReverbOn=isHallTile(distance);sfx.setHallReverb(hallReverbOn)}
  }else setStepSurface(null);
  lightTick++;
  if(lightTick%8===0){
    const cand=[];
    for(const f of flames){f.getWorldPosition(flamePos);const dz=Math.abs(flamePos.z-player.position.z);if(dz<32&&Math.abs(flamePos.x)<9)cand.push({x:flamePos.x,z:flamePos.z,d:dz})}
    cand.sort((a,b)=>a.d-b.d);
    emberSpots=cand.slice(0,2);
    for(let i=0;i<torchLights.length;i++){const c=cand[i*2];if(c){torchLights[i].position.set(c.x,2.95,c.z);torchLights[i].userData.on=true}else torchLights[i].userData.on=false}
  }
  for(let i=0;i<torchLights.length;i++){const l=torchLights[i];l.intensity=l.userData.on?(1.05+Math.sin(runTime*11+i*2.3)*.22):0}
  // Hide the torch mesh the chase camera is flying through so it never fills the frame with fire.
  for(const f of flames){
    const parts=f.userData.torch;if(!parts)continue;
    f.getWorldPosition(flamePos);
    const near=flamePos.distanceTo(camera.position)<2.6;
    for(const part of parts)part.visible=!near;
  }
  if(lightTick%10===0)for(const c of emberSpots)spawnEmber(new THREE.Vector3(c.x+(Math.random()-.5)*.3,2.72+Math.random()*.15,c.z+(Math.random()-.5)*.3));
  updateFireflies(dt);
  updateDustMotes(dt);
  waterTex.offset.x=(runTime*.018)%1;waterTex.offset.y=(runTime*.008)%1;if(waterfallTex)waterfallTex.offset.y=(runTime*.55)%1;
  if(state!=='playing'){setStepSurface(null);sfx.stopWaterfall();sfx.stopWind();sfx.stopAmbience(.5);if(hallReverbOn){hallReverbOn=false;sfx.setHallReverb(false)}}
  for(let i=0;i<lightShafts.length;i++){const m=lightShafts[i];
    if(m.material){m.material.opacity=.11+.07*(.5+.5*Math.sin(runTime*.7+i*1.3));
      const wp=m.getWorldPosition(new THREE.Vector3());
      m.rotation.y=Math.atan2(camera.position.x-wp.x,camera.position.z-wp.z);}}
  // Gentle jungle canopy sway so the foliage does not read as static blobs.
  for(let i=0;i<swayLeaves.length;i++){const lf=swayLeaves[i];
    lf.rotation.z=Math.sin(runTime*1.1+lf.userData.sway)*.045;
    lf.rotation.x=Math.cos(runTime*.8+lf.userData.sway*1.7)*.03;
  }
  charRim.position.set(player.position.x+Math.sin(playerYaw+Math.PI)*1.7,player.position.y+2.6,player.position.z+Math.cos(playerYaw+Math.PI)*1.7);
  updateMonkeys(dt);
  for(let i=0;i<watchMonkeys.length;i++){const w=watchMonkeys[i];
    w.g.position.y=1.55+Math.sin(runTime*2.2+w.phase)*.06;
    w.g.rotation.z=Math.sin(runTime*1.3+w.phase)*.08;
    // Turn the head/body toward the runner when they pass close by.
    const wp=w.g.getWorldPosition(_tmp);
    const dx=player.position.x-wp.x,dz=player.position.z-wp.z;
    const near=Math.hypot(dx,dz)<13;
    const want=near?Math.atan2(dx,dz):w.base;
    let diff=want-w.g.rotation.y;while(diff>Math.PI)diff-=Math.PI*2;while(diff<-Math.PI)diff+=Math.PI*2;
    w.g.rotation.y+=diff*Math.min(1,dt*6);
  }
  // Falling leaves: keep 8 alive around the runner.
  while(leafSprites.length<6&&Math.random()<.3)spawnLeaf();
  for(let i=leafSprites.length-1;i>=0;i--){const sp=leafSprites[i];const d0=sp.userData.leaf;
    sp.position.y+=d0.vy*dt;sp.position.x=d0.baseX+Math.sin(runTime*1.6+d0.phase)*.45;
    sp.material.rotation+=dt*1.4;sp.material.opacity=.9*Math.min(1,Math.max(0,(sp.position.y-1.2)/4));
    if(sp.position.y<1.1||sp.position.z>player.position.z+6){scene.remove(sp);leafSprites.splice(i,1)}
  }
  // Distant jungle monkey calls for ambience (quiet, randomised).
  nextMonkeyCall-=dt;
  if(nextMonkeyCall<=0){nextMonkeyCall=26+Math.random()*34;sfx.play('monkey',{gain:.14,rate:.85+Math.random()*.3})}
  if(distance+22>nextMonkey){
    if(Math.abs(nextMonkey-nextTurn)<26)nextMonkey+=17;
    else{spawnMonkey(18);nextMonkey=distance+150+Math.random()*80}
  }
  while(distance>=nextSpawn)spawnWave();
  if(turnDirection===0 && distance>nextTurn-42)beginTurn();
  if(turnDirection!==0){
    if(turnQueued && distance>=nextTurn)completeTurn();
    else if(!turnQueued && distance>nextTurn+2)end('错过路口，前方没有路了。');
    else updateTurnCue();
  }
  junction.visible=turnDirection!==0||distance<lastTurnDistance+17;

  {
    const ja=junction.userData.arrow;
    if(ja){
      const pulse=1.28+.09*Math.sin(runTime*5.2);
      ja.scale.set(pulse,1,pulse);
      for(const c of ja.children){if(c.isSprite)c.material.opacity=.45+.25*Math.sin(runTime*6.5)}
    }
  }
  turnFlash=Math.max(0,turnFlash-dt*1.8);
  {const tg=document.getElementById('turnGlow');if(tg)tg.style.opacity=String(Math.min(1,turnFlash)*.55)}
  for(const tile of tiles){
    if(tile.pathDistance<distance-20)tile.pathDistance+=TILE*TILE_COUNT;
    placeOnPath(tile,tile.pathDistance);
    const nearTurn=pathSegments.slice(1).some(segment=>Math.abs(tile.pathDistance-segment.start)<CORRIDOR_WALL_NEAR_TURN);
    const nearGate=gateways.some(gw=>Math.abs(tile.pathDistance-gw.pathDistance)<11);
    const bridge=isBridgeTile(tile.pathDistance);
    const cliff=!bridge&&isCliffTile(tile.pathDistance);
    const hall=!bridge&&!cliff&&isHallTile(tile.pathDistance);
    if(cliff){
      const cm=((Math.floor((tile.pathDistance+9)/12)%48)+48)%48;
      if(cm===6&&tile.cliff&&!tile.cliffGate&&obstaclePrefabs['tower-arch']){
        const gate=obstaclePrefab('tower-arch',.18,Math.PI);
        if(gate){gate.position.set(0,-.35,0);gate.userData.cliffGate=true;tile.cliff.add(gate);tile.cliffGate=gate}
      }
      if(tile.cliffGate)tile.cliffGate.visible=(cm===6);
    }
    if(cliff&&!tile.cliff&&rockTemplate)makeCliff(tile);
    if(hall&&!tile.hall)makeHall(tile);
    if(tile.hall)tile.hall.visible=hall;
    tile.decor.visible=!bridge&&!cliff&&!hall&&!pathSegments.slice(1).some(segment=>Math.abs(tile.pathDistance-segment.start)<12);
    if(tile.bridge)tile.bridge.visible=bridge;
    if(tile.cliff){tile.cliff.visible=cliff;
      if(cliff)for(const ch of tile.cliff.children)if(ch.userData.mist){
        const cyc=(runTime*ch.userData.rise+ch.position.z*.13+ch.userData.baseY)%1.6;
        ch.position.y=ch.userData.baseY+cyc;
        if(ch.userData.baseX===undefined)ch.userData.baseX=ch.position.x;
        ch.position.x=ch.userData.baseX+Math.sin(runTime*.7+ch.userData.baseY*2.7)*1.5;
        const fade=1-Math.min(1,cyc/1.6);
        ch.material.opacity=(ch.userData.chasm?.05:.1)+ (ch.userData.chasm?.06:.08)*fade;
      }
      if(cliff)for(const ch of tile.cliff.children)if(ch.userData.spray){
        const cyc=((runTime*1.3+ch.userData.phase)%1);
        ch.position.y=ch.userData.baseY+cyc*.9;
        ch.material.opacity=.34*(1-cyc);
        const sc=.9+cyc*.8;ch.scale.set(sc*1.3,sc,1);
      }}
    tile.surface.children.forEach(child=>{if(child.userData.facade)child.visible=!nearTurn&&!nearGate&&!bridge});
  }
  laneX=THREE.MathUtils.damp(laneX,lanes[lane],12,dt);
  const playerHeading=pathAt(distance,laneX,true).heading;
  placeOnPath(player,distance,laneX,true);
  playerYaw=dampAngle(playerYaw,playerHeading,turnFlash>0?16:11,dt);
  player.rotation.y=playerYaw;
  const wasAir=jumpY>.02;
  jumpV-=23*dt;jumpY=Math.max(0,jumpY+jumpV*dt);if(jumpY===0&&jumpV<0)jumpV=0;
  if(wasAir&&jumpY===0){
    const f=pathAt(distance-.4,laneX);dustPuff(new THREE.Vector3(f.x,.1,f.z),8,.62);
    // Landing impact: a wider dust ring plus a short squash-and-stretch on the body.
    for(const s of [-1,1]){const q=pathAt(distance-.35,laneX+s*.55);dustPuff(new THREE.Vector3(q.x,.12,q.z),3,.5)}
    landPulse=1;shakeAmp=Math.max(shakeAmp,.05);sfx.thud(.5);
  }
  sliding=Math.max(0,sliding-dt);
  if(sliding>0){
    if(!window.__frictionOn){window.__frictionOn=true;sfx.startFriction(.2)}
    if(runTime-lastDustAt>.11){lastDustAt=runTime;const f=pathAt(distance-1.1,laneX);dustPuff(new THREE.Vector3(f.x,.12,f.z),2,.4)}
  }else if(window.__frictionOn){window.__frictionOn=false;sfx.stopFriction()}
  if(slideBuffer>0){
    slideBuffer-=dt;
    if(jumpY<=.02&&jumpV<=0){slideBuffer=0;sliding=1.05;setHint('滑铲！',.35);sfx.play('slide',{gain:1.15})}
  }
  if(jumpBuffer>0){
    jumpBuffer-=dt;
    if(jumpY<=.02&&jumpV<=0){jumpBuffer=0;jumpV=8.8;sliding=0;airborne=true;lastJumpAt=runTime;vplay('jump',{gain:.8});jumpKick()}
  }
  if(sliding>0&&runTime-lastSlideSparkAt>.055){lastSlideSparkAt=runTime;const f=pathAt(distance-.55,laneX);spawnSparks(new THREE.Vector3(f.x,.16,f.z),0xffc46a,1,.24,.22,.45,'ember')}
  player.position.y=jumpY;
  body.visible=runTime>=invincibleUntil||Math.floor(runTime*14)%2===0;
  landPulse=Math.max(0,landPulse-dt*7);
  const landSquash=landPulse*landPulse*.16;
  body.scale.set(1+landSquash*.55,1-landSquash+(runnerRig?0:(sliding>0?.54:1)-1),1+landSquash*.55);
  // Lean into lane changes and corner turns like the original runner.
  const turnLean=turnFlash>0&&turnDirection!==0?-turnDirection*Math.min(1,turnFlash*1.8)*.22:0;
  body.rotation.z=THREE.MathUtils.damp(body.rotation.z,(lanes[lane]-laneX)*-.19+turnLean,9,dt);
  stumbleKick=Math.max(0,stumbleKick-dt*2.4);
  const boostPitch=power.type==='boost'?-.11:0;
  body.rotation.x=sliding>0?-.23:Math.sin(runTime*15)*.045+boostPitch-stumbleKick*.5;
  for(const {arm,leg,side} of limbs){arm.rotation.x=Math.sin(runTime*15+side*Math.PI)*.62;leg.rotation.x=Math.sin(runTime*15+side*Math.PI+Math.PI)*.65}
  if(runnerRig){
    runnerRig.setClip(sliding>0?'slide':(jumpY>0||jumpV>0?'jump':'run'));
    runnerRig.update(dt, THREE.MathUtils.clamp(speed / RUN_SPEED, .65, 1.55));
  }else if(originalMeshes.length)animateOriginalRunner(runTime);
  placeOnPath(shadow,distance,laneX,true);setShadowAlpha(1-Math.min(jumpY,2)*.18);shadow.scale.setScalar(1+jumpY*.18);
  stumbleCooldown=Math.max(0,stumbleCooldown-dt);chaseGap=THREE.MathUtils.damp(chaseGap,stumbleCooldown>0?3.6:11.5,stumbleCooldown?1.6:0.9,dt);
  {
  const close=chaseGap<7.5;
  placeOnPath(enemy,distance-chaseGap,(close?1.15:1.9)+Math.sin(runTime*1.3)*.35,true);
  enemy.position.y=(close?1.15:1.02)+Math.sin(runTime*2.6)*.14;
  enemy.rotation.z=Math.sin(runTime*5.4)*.10;enemy.rotation.x=Math.sin(runTime*4.1)*.06;
  enemy.scale.setScalar(close?1.12:1);
  enemy.visible=death?enemy.visible:(state==='playing'?close:true);
  enemyShadow.visible=enemy.visible&&state==='playing';
  if(enemyShadow.visible){placeOnPath(enemyShadow,distance-chaseGap,(close?1.15:1.9)+Math.sin(runTime*1.3)*.35,true);enemyShadow.scale.setScalar(close?1:1.25)}
}
  const turnAmount=Math.min(1,turnFlash*1.4);
  if(death){
    // Death cinematic: swoop in close on the fallen runner (original zooms into the character).
    const back=pathAt(distance-3.0,laneX*.1);
    const settle=Math.min(1,death.elapsed/.85);
    camera.position.lerp(new THREE.Vector3(back.x,2.55-settle*.45,back.z),Math.min(1,dt*7));
    camera.lookAt(player.position.x,1.1+settle*.15,player.position.z);
  }else{
    // Chase camera is locked to the runner's smoothed heading (not to a point 10 m back along
    // the path): this is what makes 90° corners feel like one continuous swing instead of the
    // camera lagging behind until it reaches the corner.
    const jumpFollow=Math.min(1,jumpY/1.6)*.55;
    const slideDip=sliding>0?.42:0;
    camLane+=(laneX-camLane)*Math.min(1,dt*7);
    const groundedBob=jumpY<=.05?(Math.sin(runTime*10.4)*.05+Math.sin(runTime*20.8)*.018):0;
    const yaw=playerYaw,fwdX=-Math.sin(yaw),fwdZ=-Math.cos(yaw);
    // Camera position rides the rounded road arc (never inside the corner masonry)…
    // Subtle dolly-in on the approach so the corner reads before the swing.
    const approach=Math.max(0,Math.min(1,(24-(nextTurn-distance))/24));
    const dolly=approach*1.15*(1-Math.min(1,turnAmount*1.4));
    const backPoint=pathAt(distance-(10.2+turnAmount*2.2-dolly),laneX*.08,true);
    camera.position.lerp(new THREE.Vector3(backPoint.x,4.62+turnAmount*1.25-dolly*.26+jumpFollow+groundedBob,backPoint.z),Math.min(1,dt*(turnFlash>0?12:9)));
    if(slideDip>0)camera.position.y-=slideDip*Math.min(1,dt*9);
    if(impactFlash>0){camera.position.x+=Math.sin(runTime*63)*impactFlash*.09;camera.position.y+=Math.sin(runTime*57)*impactFlash*.07;}
    if(stumbleCooldown>0)camera.position.y+=Math.sin(runTime*41)*.04;
    // …while the view stays locked on the runner (slight look-ahead), so he never drifts out of
    // frame mid-corner; the pan comes from the camera itself travelling along the arc.
    const aheadDist=2.4+turnAmount*1.6;
    // Anticipation: a few metres before a junction the view leans slightly into the coming turn.
    const anticip=turnDirection!==0?Math.max(0,1-Math.max(0,nextTurn-distance)/24):0;
    const lookSide=turnDirection*(anticip*.85+turnAmount*1.1);
    const latX=Math.cos(playerYaw),latZ=-Math.sin(playerYaw);
    camera.lookAt(player.position.x+fwdX*aheadDist+latX*lookSide,.95+turnAmount*.55+jumpFollow*.5-slideDip*.35,player.position.z+fwdZ*aheadDist+latZ*lookSide);
    camera.rotateZ((laneX-camLane)*.032);
    if(shakeAmp>0){camera.position.x+=Math.sin(runTime*57)*shakeAmp;camera.position.y+=Math.cos(runTime*49)*shakeAmp*.7;shakeAmp=Math.max(0,shakeAmp-dt*1.7)}
  }
  camera.rotateZ(turnFlash*turnFlashDir*.06);
  const targetFov=(death?46:(camera.aspect<.7?65:58))+turnFlash*4+(power.type==='boost'?5:0)+turnKick*7+Math.max(0,speed-RUN_SPEED_MIN)*.22;camera.fov+=(targetFov-camera.fov)*Math.min(1,dt*10);camera.updateProjectionMatrix();
  if(turnKick>0)turnKick=Math.max(0,turnKick-dt*1.9);
  updateSparks(dt);updateGateways();
  if(state==='playing'&&!death){
    const grounded=jumpY<=.05;
    if(grounded&&!sliding&&runTime-lastStepDustAt>.26){lastStepDustAt=runTime;const f=pathAt(distance-1.15,laneX);dustPuff(new THREE.Vector3(f.x,.14,f.z),2,.72)}
    if(wasAirborne&&grounded&&jumpV===0){const f=pathAt(distance-1.0,laneX);dustPuff(new THREE.Vector3(f.x,.14,f.z),9,.85);shakeAmp=Math.max(shakeAmp,.07)}
    wasAirborne=jumpY>.25;
  }
  if(impactFlash>0&&!window.__freezeFx){impactFlash=Math.max(0,impactFlash-dt*3.4)}
  {const el=$('impactFlash');if(el)el.style.opacity=(Math.max(0,impactFlash)*.85).toFixed(2)}
  for(const flame of flames){flame.scale.y=.52+Math.sin(runTime*15+flame.position.x)*.1;flame.rotation.y=runTime*2}
  for(let i=obstacles.length-1;i>=0;i--){
    const o=obstacles[i];placeOnPath(o.group,o.pathDistance,o.full?0:lanes[o.lane]);
    if(o.group.userData.flames){const fs=o.group.userData.flames;for(let k=0;k<fs.length;k++){const f=fs[k];
      if(f.isSprite){
        const s0=1+.14*Math.sin(runTime*11+k*2.4);
        if(f.userData.flame){const sc=f.userData.base||1;f.scale.set(1.45*sc*s0,2.05*sc*(1+.18*Math.sin(runTime*9.3+k*1.7)),1);f.material.opacity=.6+.22*Math.sin(runTime*8+k)}
        else f.scale.setScalar(2.2*s0*(k%3===2?1:.9));
      }else{f.scale.y=f.userData.base*(1+.12*Math.sin(runTime*13+k*2.1));f.rotation.y=runTime*1.7+k}}}
    const gapDepth=o.kind==='gap'?2.0:(o.full?.5:.85);
    if(o.kind==='gap'&&!o.warned&&o.pathDistance-distance>3.5&&o.pathDistance-distance<11){
      o.warned=true;setHint('前方坑洞 · 向上跳！',1.0);sfx.play('wooosh',{gain:.5});
    }
    if(!o.passed && Math.abs(o.pathDistance-distance)<gapDepth){
      if(o.kind!=='gap')o.passed=true;
      else if(distance>o.pathDistance+gapDepth)o.passed=true;
      if(o.full||o.lane===lane){
        const justJump=runTime-lastJumpAt<.42,justSlide=runTime-lastSlideAt<.42,invincible=runTime<invincibleUntil;
        const escaped=invincible||o.kind==='gap'?(jumpY>.12||jumpV>0||justJump):(o.kind==='hurdle'||o.kind==='fire')?(jumpY>.45||jumpV>.2||justJump):o.kind==='arch'?(sliding>.03||justSlide):false;
        if(!escaped){
          if(power.type==='boost'){
            setHint('冲撞！',.6);sfx.play('swish',{gain:.7});
          }else if(power.shield>0){
            power.shield=0;power.type=null;updatePowerBadge();stumbleCooldown=Math.max(stumbleCooldown,4);
            // Glass-bubble break: a ring of wing sparks + brief screen flash + shake.
            const burstPos=player.position.clone();burstPos.y=1.05;
            spawnSparks(burstPos,0x9fe0ff,10,1.5,.6,.7,'wings');
            spawnSparks(burstPos,0xdfefff,8,1.0,.45,.55,'spark');
            shakeAmp=Math.max(shakeAmp,.12);impactFlash=Math.max(impactFlash,.35);
            setHint('护盾抵挡了一次撞击',1.4);sfx.play('shimmer',{gain:.9});sfx.play('sizzle',{gain:.7});
          }else if(o.kind==='gap')end('掉进了断桥。','fall');
          else stumbleOrCatch();
        }
      }
    }
    if(o.pathDistance<distance-16){for(let k=flames.length-1;k>=0;k--){if(flames[k].userData.owner===o.group)flames.splice(k,1)}scene.remove(o.group);obstacles.splice(i,1)}
  }
  // Contextual prompt: tell the player which move clears the next full-width obstacle.
  {
    const ACTIONS={hurdle:'↑ 跳过',fire:'↑ 跳过',gap:'↑ 跳过',arch:'↓ 滑铲'};
    let cue=null,cueAhead=1e9;
    for(const o of obstacles){
      if(!o.full)continue;
      const ahead=o.pathDistance-distance;
      if(ahead>-2&&ahead<14&&ahead<cueAhead){cueAhead=ahead;cue=o}
    }
    const el=$('actionCue');
    if(cue&&ACTIONS[cue.kind]){el.textContent=ACTIONS[cue.kind];el.classList.remove('hidden')}
    else el.classList.add('hidden');
  }
  const magnetOn=power.type==='magnet';
  for(let i=coinItems.length-1;i>=0;i--){
    const c=coinItems[i];placeOnPath(c.group,c.pathDistance,lanes[c.lane]);c.group.position.y=c.y;c.group.children[0].rotation.y=runTime*3.5;
    const gapAhead=c.pathDistance-distance;
    if(magnetOn&&!c.taken&&gapAhead>-1.5&&gapAhead<10){
      const k=THREE.MathUtils.clamp(1-gapAhead/10,0,1);
      placeOnPath(c.group,c.pathDistance,THREE.MathUtils.lerp(lanes[c.lane],lanes[lane],k*.9));
      // Pulled coins accelerate, spin faster, swell a little and shed gold sparks.
      c.group.scale.setScalar(1+k*.35);
      c.group.children[0].rotation.y=runTime*(3.5+k*10);
      const gl=c.group.children[1];
      if(gl&&gl.material)gl.material.opacity=.12+k*.55;
      if((c.sparkAt||0)<runTime-.09){c.sparkAt=runTime;spawnSparks(new THREE.Vector3(c.group.position.x,c.group.position.y,c.group.position.z),0xffe9a8,1,.35,.3,.32,'spark')}
    }else if(c.group.scale.x!==1){
      c.group.scale.setScalar(1);
      const gl=c.group.children[1];if(gl&&gl.material)gl.material.opacity=.14;
    }
    const collectDist=magnetOn?1.7:1.2;
    if(!c.taken && Math.abs(gapAhead)<collectDist && (magnetOn||c.lane===lane) && jumpY<2.2){
      c.taken=true;spawnSparks(new THREE.Vector3(c.group.position.x,c.group.position.y+.55,c.group.position.z),0xffe38a,4,.55,.34);spawnFlyCoin(c.group.position.clone());coins+=coinWorth(power.type==='bonus');
      comboCount=(runTime-lastCoinAt<1.3)?comboCount+1:1;lastCoinAt=runTime;chargePowerMeter(1);
      multiplier=Math.min(5,1+Math.floor(comboCount/4));if(multiplier>runBestMulti)runBestMulti=multiplier;updateMultiBadge();
      renderNum($('coins'),coins,'num-sm');
      {const el=$('coins');el.classList.remove('pop');void el.offsetWidth;el.classList.add('pop')}
      // Coin milestones every 100 coins: small gold plaque, same as distance milestones.
      {const ms=Math.floor(coins/100)*100;if(ms>=100&&ms>lastCoinMilestone){
        lastCoinMilestone=ms;showMilestone(ms,'金币');
        const bp=new THREE.Vector3(player.position.x,1.2,player.position.z);
        spawnSparks(bp,0xffd76a,16,1.8,.6,1.0,'sparkle');spawnSparks(bp,0xffeec0,10,1.3,.5,.8,'spark');
      }}
      sfx.play(coins%10===0?'coinCascade':'coin',{gain:.8,rate:.97+(coins%5)*.02+(multiplier-1)*.05});
      scene.remove(c.group);coinItems.splice(i,1);continue
    }
    if(c.pathDistance<distance-16){scene.remove(c.group);coinItems.splice(i,1)}
  }
  for(let i=gemItems.length-1;i>=0;i--){
    const g=gemItems[i];placeOnPath(g.group,g.pathDistance,lanes[g.lane]);
    g.group.position.y=1.4+Math.sin(runTime*2.2+g.pathDistance)*.14;
    g.group.children[0].rotation.y=runTime*3.2;
    if(g.group.userData.glow)g.group.userData.glow.material.opacity=.45+.25*Math.sin(runTime*8+g.pathDistance);
    if(!g.taken&&g.lane===lane&&Math.abs(g.pathDistance-distance)<1.35&&jumpY<2.4){
      g.taken=true;spawnFlyCoin(g.group.position.clone(),'gem');gems++;charState.gems=gems;saveCharState();$('gems').textContent=gems;
      const gp=new THREE.Vector3(g.group.position.x,g.group.position.y+.5,g.group.position.z);spawnSparks(gp,0xff8fae,10,.7,.3,.6,'spark');spawnSparks(gp,0xffd7e4,4,1.2,.5,.8,'wings');sfx.play('bonusPickup',{gain:.9});haptic(40);
      setHint('宝石 +1',1.4);
      {const ms=Math.floor(gems/10)*10;if(ms>=10&&ms>lastGemMilestone){lastGemMilestone=ms;showMilestone(ms,'宝石')}}
      scene.remove(g.group);gemItems.splice(i,1);continue;
    }
    if(g.pathDistance<distance-16){scene.remove(g.group);gemItems.splice(i,1)}
  }
  for(let i=pickups.length-1;i>=0;i--){
    const p=pickups[i];placeOnPath(p.group,p.pathDistance,lanes[p.lane]);
    p.group.position.y=1.35+Math.sin(runTime*2.6+p.pathDistance)*.12;
    p.group.rotation.y=runTime*2.4;
    if(p.group.userData.glow)p.group.userData.glow.material.opacity=.55+.25*Math.sin(runTime*7+p.pathDistance);
    if(!p.taken&&p.lane===lane&&Math.abs(p.pathDistance-distance)<.95&&jumpY<2.4){p.taken=true;const pos=p.group.position.clone();pos.y=Math.max(.9,pos.y);spawnSparks(pos,powerColor[p.kind],14,1.5,.62,1.0,'spark');spawnSparks(pos,0xffe8b0,8,1.1,.45,.8,'sparkle');activatePower(p.kind);scene.remove(p.group);pickups.splice(i,1);continue}
    if(p.pathDistance<distance-16){scene.remove(p.group);pickups.splice(i,1)}
  }
  if(hintTimeout>0){hintTimeout-=dt;if(hintTimeout<=0)$('hint').classList.remove('visible')}
  if(powerToastTimer>0){powerToastTimer-=dt;if(powerToastTimer<=0)$('powerToast').classList.add('hidden')}
  $('distance').textContent=Math.floor(distance);
  renderNum($('score'),Math.floor(distance)*10+coins*20,'num-lg');
  const bagEl=$('bagBtn');if(bagEl)bagEl.style.display=state==='playing'?'block':'none';
}
function resize(){const rect=canvas.getBoundingClientRect();const w=Math.max(1,rect.width),h=Math.max(1,rect.height);renderer.setSize(w,h,false);camera.aspect=w/h;camera.fov=w/h<.7?65:58;camera.updateProjectionMatrix()}
new ResizeObserver(resize).observe(canvas);resize();
function updateMultiBadge(){
  const badge=document.getElementById('multiBadge');if(!badge)return;
  badge.classList.toggle('hidden',multiplier<=1);
  badge.textContent='×'+multiplier;
  if(multiplier>1){badge.classList.remove('pop');void badge.offsetWidth;badge.classList.add('pop')}
}
/* ---- original menu panels: STORE / OPTIONS / STATS ---- */
let panelOpen=null;
const fmtNum=(n)=>n>=100000?(n/1000).toFixed(0)+'k':n>=10000?(n/1000).toFixed(1)+'k':String(n);
let storeTab='shop';
let previewRenderer=null,previewScene=null,previewCam=null,previewRig=null,previewLoad=null,previewChar='';
let previewYaw=0,previewDrag=null,previewIdleAt=0;
function buildPreviewScene(){
  previewScene=new THREE.Scene();
  previewCam=new THREE.PerspectiveCamera(30,1,.1,60);
  previewScene.add(new THREE.HemisphereLight(0xfff2da,0x3a2c1e,2.0));
  const key=new THREE.DirectionalLight(0xffe7bd,2.2);key.position.set(2.4,4,3.4);previewScene.add(key);
  const rim=new THREE.DirectionalLight(0x9fc4ff,.9);rim.position.set(-3,2.5,-2.4);previewScene.add(rim);
  const table=new THREE.Mesh(new THREE.CylinderGeometry(.62,.66,.07,36),new THREE.MeshStandardMaterial({color:0x2a241c,roughness:.6,metalness:.25}));
  table.position.y=-.035;previewScene.add(table);
  const ring=new THREE.Mesh(new THREE.TorusGeometry(.62,.02,8,48),new THREE.MeshStandardMaterial({color:0xd9b36a,roughness:.35,metalness:.7,emissive:0x3a2a10,emissiveIntensity:.5}));
  ring.rotation.x=Math.PI/2;ring.position.y=.0;previewScene.add(ring);
  const disc=new THREE.Mesh(new THREE.CircleGeometry(.52,28),new THREE.MeshBasicMaterial({color:0x05070a,transparent:true,opacity:.45}));
  disc.rotation.x=-Math.PI/2;disc.position.y=.008;previewScene.add(disc);
}
function ensureCharPreview(){
  const cv=$('charPreview');if(!cv)return null;
  if(previewRenderer&&previewRenderer.domElement===cv&&previewLoad)return previewLoad;
  if(previewRenderer){try{previewRenderer.dispose()}catch{}}
  previewRenderer=new THREE.WebGLRenderer({canvas:cv,antialias:true,alpha:true});
  previewRenderer.setPixelRatio(Math.min(devicePixelRatio||1,2));
  previewRenderer.outputColorSpace=THREE.SRGBColorSpace;
  if(!previewScene)buildPreviewScene();
  if(!cv.dataset.drag){
    cv.dataset.drag='1';
    cv.addEventListener('pointerdown',e=>{previewDrag={x:e.clientX,yaw:previewYaw};cv.setPointerCapture&&cv.setPointerCapture(e.pointerId)});
    cv.addEventListener('pointermove',e=>{if(!previewDrag)return;previewYaw=previewDrag.yaw+(e.clientX-previewDrag.x)*.011;previewIdleAt=performance.now()+2200});
    const endDrag=()=>{previewDrag=null};
    cv.addEventListener('pointerup',endDrag);cv.addEventListener('pointercancel',endDrag);cv.addEventListener('pointerleave',endDrag);
  }
  if(previewRig&&previewRig.object.parent!==previewScene)previewScene.add(previewRig.object);
  if(previewRig)return Promise.resolve(true);
  previewLoad=new Promise(resolve=>{
    loadRunnerRig(asset('runner-rig.json'),charTexUrl(charState.equipped),{scale:.27,yOffset:1.32}).then(rig=>{
      previewRig=rig;previewScene.add(rig.object);setPreviewChar(charState.equipped);resolve(true);
    }).catch(()=>resolve(false));
  });
  return previewLoad;
}
function setPreviewChar(id){
  previewChar=id;
  const c=charById(id);if($('cpName'))$('cpName').textContent=c?c.name:'';
  if($('cpStats')&&c){
    const sp=c.p>1?'速度 +'+Math.round((c.p-1)*100)+'%':c.p<1?'速度 -'+Math.round((1-c.p)*100)+'%':'标准速度';
    $('cpStats').innerHTML=`<span>${sp}</span><span>${c.g==='f'?'女声':'男声'}</span>`;
  }
  if(previewRig){for(const r of document.querySelectorAll('.store-row.previewing'))r.classList.remove('previewing');
    const row=document.querySelector(`.store-row[data-char="${id}"]`);if(row)row.classList.add('previewing')}
  if(!previewRig)return;
  new THREE.TextureLoader().load(charTexUrl(id),tex=>{
    applyCharTex(tex);
    if(previewRig.material){previewRig.material.map=tex;previewRig.material.needsUpdate=true}
  },undefined,()=>{});
}
function renderCharPreview(now){
  const cv=$('charPreview');
  if(!previewRenderer||!cv||previewRenderer.domElement!==cv||panelOpen!=='store'||storeTab!=='shop')return;
  const w=cv.clientWidth||220,h=cv.clientHeight||168;
  if(cv.width!==Math.floor(w*previewRenderer.getPixelRatio())){
    previewRenderer.setSize(w,h,false);previewCam.aspect=w/h;previewCam.updateProjectionMatrix();
  }
  previewCam.position.set(0,1.35,4.1);previewCam.lookAt(0,1.02,0);
  if(previewRig){
    previewRig.object.position.y=0;
    if(!previewDrag&&now>previewIdleAt)previewYaw+=Math.min(.12,(now-previewIdleAt)*.0004)*.016;
    previewRig.object.rotation.y=previewYaw;
    if(previewRig.setClip)previewRig.setClip('run');
    if(previewRig.update)previewRig.update(1/60,now/3200);
  }
  previewRenderer.render(previewScene,previewCam);
}
function panelStoreHTML(){
  const assets=`${import.meta.env.BASE_URL}assets/ui/`;
  const tabs=`<div class="store-tabs"><button class="store-tab ${storeTab==='shop'?'on':''}" data-tab="shop"><img src="${assets}word-shop.png" alt="SHOP"></button><button class="store-tab ${storeTab==='upgrades'?'on':''}" data-tab="upgrades"><img src="${assets}word-upgrades.png" alt="UPGRADES"></button></div>`;
  const rows=CHARS.map(c=>{
    const owned=charState.owned.includes(c.id), equipped=charState.equipped===c.id;
    const right=equipped
      ? `<span class="tag owned">已装备</span>`
      : owned
        ? `<button class="store-btn equip" data-equip="${c.id}">装备</button>`
        : c.gemPrice
          ? `<button class="store-btn buy gem ${(charState.gems||0)>=c.gemPrice?'':'disabled'}" data-buy="${c.id}"><img class="gem-ico" src="${import.meta.env.BASE_URL}assets/ui/gem.png" alt="">${numHTML(c.gemPrice)}</button>`
          : `<button class="store-btn buy ${charState.bank>=c.price?'':'disabled'}" data-buy="${c.id}">${numHTML(fmtNum(c.price))}</button>`;
    const av=c.av?`<span class="char-av" style="background-image:url(${c.av})" data-prev="${c.id}" title="预览 ${c.name}"></span>`:`<span class="char-av rune" data-prev="${c.id}">◆</span>`;
    return `<div class="store-row" data-char="${c.id}">${av}<button class="char-voice" data-voice="${c.id}" title="试听声音" aria-label="试听 ${c.name} 的声音">♪</button><div class="char-meta"><span class="char-name">${c.name}${c.isNew?'<i class="new-tag">NEW</i>':''}</span><small>${c.sub}</small></div>${right}</div>`;
  }).join('');
  const upEffect=(id,l)=>{
    if(id==='magnet')return (9+1.2*l).toFixed(1)+'s';
    if(id==='coin')return (100+25*l)+'%';
    return Math.max(20,50-10*l)+' 金币';
  };
  const upRows=UPGRADES.map(u=>{
    const lvl=upLvl(u.id),max=u.costs.length;
    const dots=Array.from({length:max},(_,i)=>`<i class="up-dot${i<lvl?' on':''}"></i>`).join('');
    const effect=lvl>=max?`<small class="up-effect">已达上限 · ${upEffect(u.id,lvl)}</small>`
      :`<small class="up-effect">${upEffect(u.id,lvl)} <b>→</b> ${upEffect(u.id,lvl+1)}</small>`;
    const right=lvl>=max?`<span class="tag owned">已满级</span>`:`<button class="store-btn buy ${charState.bank>=u.costs[lvl]?'':'disabled'}" data-up="${u.id}">${numHTML(fmtNum(u.costs[lvl]))}</button>`;
    return `<div class="store-row up-row${lvl>=max?' max':''}"><div class="up-meta"><span class="up-name">${u.name}<small>${u.sub}</small></span>${effect}<span class="up-dots">${dots}<em>Lv.${lvl}/${max}</em></span></div>${right}</div>`;
  }).join('');
  const body=storeTab==='shop'?rows:upRows;
  const preview=storeTab==='shop'?`<div class="char-preview"><canvas id="charPreview"></canvas><span class="cp-name" id="cpName"></span><span class="cp-hint">拖动旋转</span><span class="cp-stats" id="cpStats"></span></div>`:'';
  const note=storeTab==='shop'
    ?`<p class="panel-note">金币银行 ${fmtNum(charState.bank)} · 宝石 ${charState.gems||0} · 金币角色花银行金币，血鬼/骷髅用宝石解锁。</p>`
    :`<p class="panel-note">金币银行 ${fmtNum(charState.bank)} · 升级为永久效果，跨局保留。</p>`;
  return preview+tabs+body+note;
}
function buyChar(id){
  const c=charById(id);
  if(charState.owned.includes(id))return;
  if(c.gemPrice){
    if((charState.gems||0)<c.gemPrice)return;
    charState.gems-=c.gemPrice;gems=charState.gems;$('gems').textContent=gems;
  }else{
    if(charState.bank<c.price)return;
    charState.bank-=c.price;stats.coinsSpent+=c.price;saveStats();
  }
  charState.owned.push(id);charState.equipped=id;
  saveCharState();setRunnerSkin(id);sfx.play('coinCascade',{gain:.9});haptic(30);
  renderPanel('store');
}
function equipChar(id){
  if(!charState.owned.includes(id))return;
  charState.equipped=id;voiceGender=charGender();saveCharState();setRunnerSkin(id);sfx.play('click',{gain:.6});haptic(20);
  renderPanel('store');
}
function buyUpgrade(id){
  const u=UPGRADES.find(x=>x.id===id);if(!u)return;
  const lvl=upLvl(id);if(lvl>=u.costs.length||charState.bank<u.costs[lvl])return;
  charState.bank-=u.costs[lvl];stats.coinsSpent+=u.costs[lvl];saveStats();charState.upgrades[id]=lvl+1;saveCharState();
  sfx.play('coinCascade',{gain:.9});haptic(30);renderPanel('store');
}
function panelOptionsHTML(){
  return `<div class="switch-row"><span>音乐<small>原版背景音乐（61 s 循环）</small></span><input class="switch" type="checkbox" id="optMusic" ${settings.music?'checked':''}></div>
  <div class="switch-row"><span>音效<small>原版音效 · 奔跑/金币/转弯</small></span><input class="switch" type="checkbox" id="optSfx" ${settings.sfx?'checked':''}></div>
  <div class="switch-row"><span>震动反馈<small>设备支持时在碰撞/死亡触发</small></span><input class="switch" type="checkbox" id="optHaptics" ${settings.haptics?'checked':''}></div>
  <div class="switch-row"><span>高清渲染<small>按设备像素比渲染，关闭可提升帧率</small></span><input class="switch" type="checkbox" id="optHq" ${settings.hq?'checked':''}></div>
  <div class="switch-row"><span>倾斜转向<small>手机左右倾斜直接转弯（需授权）</small></span><input class="switch" type="checkbox" id="optTilt" ${settings.tilt?'checked':''}></div>
  <div class="switch-row"><span>玩法教学<small>重新播放滑动/转向教学</small></span><button class="mini-btn" id="optTutorial">播 放</button></div>
  <p class="panel-note">设置会自动保存在本地。</p>`;
}
function updateMenuCoins(){
  const el=$('menuCoins');if(!el)return;
  el.innerHTML=`持有 ${numHTML(fmtNum(charState.bank))} 金币 · 累计收集 ${numHTML(fmtNum(stats.totalCoins))}`;
}
function panelStatsHTML(){
  const rows=[
    ['历史最佳距离',`${best} m`],
    ['累计奔跑距离',`${fmtNum(stats.totalDistance)} m`],
    ['完成局数',String(stats.runs)],
    ['累计收集金币',fmtNum(stats.totalCoins)],
    ['当前持有金币',fmtNum(charState.bank)],
    ['已花费金币',fmtNum(stats.coinsSpent)],
    ['最高金币倍率',`×${stats.bestMulti}`],
    ['累计成功转弯',String(stats.turns)],
  ];
  return rows.map(([k,v])=>`<div class="stat-row"><span>${k}</span><b>${numHTML(v)}</b></div>`).join('')
    +`<p class="panel-note">数据来自本机记录。</p>`;
}
function objectiveProgress(o){const cur=Math.min(o.target,Math.max(0,o.get()||0));return {cur,pct:Math.round(cur/o.target*100)}}
function panelObjectivesHTML(){
  const rows=OBJECTIVES.map(o=>{
    const {cur,pct}=objectiveProgress(o);
    const claimed=!!charState.objectives[o.id];
    const done=cur>=o.target;
    const reward=o.reward.gems?`<img class="gem-ico" src="${import.meta.env.BASE_URL}assets/ui/gem.png" alt="">${o.reward.gems}`:`<b class="coin-amount">${fmtNum(o.reward.coins)}</b>`;
    const right=claimed?`<span class="tag owned">已领取</span>`:done?`<button class="store-btn claim" data-claim="${o.id}">领取</button>`:`<span class="obj-pct">${pct}%</span>`;
    return `<div class="store-row obj-row"><div class="obj-meta"><span class="obj-name">${o.name}<small>${o.sub}</small></span><span class="obj-bar"><i style="width:${pct}%"></i></span><span class="obj-now">${cur}${o.unit} / ${o.target}${o.unit}</span></div><div class="obj-right"><span class="obj-reward">${reward}</span>${right}</div></div>`;
  }).join('');
  return rows+`<p class="panel-note">完成目标后点击「领取」，奖励直接进入银行金币 / 宝石。</p>`;
}
function claimObjective(id){
  const o=OBJECTIVES.find(x=>x.id===id);if(!o)return;
  const {cur}=objectiveProgress(o);
  if(charState.objectives[id]||cur<o.target)return;
  if(o.reward.coins){charState.bank+=o.reward.coins}
  if(o.reward.gems){charState.gems+=o.reward.gems;gems=charState.gems;$('gems').textContent=gems}
  charState.objectives[id]=true;saveCharState();
  sfx.play('coinCascade',{gain:.9});haptic(40);renderPanel('objectives');
}
function renderPanel(name){
  panelOpen=name;
  const art={store:'word-store',options:'word-options',stats:'word-stats',objectives:'word-objectives'}[name];
  $('panelTitle').src=`${import.meta.env.BASE_URL}assets/ui/${art}.png`;
  $('panelBody').innerHTML=name==='store'?panelStoreHTML():name==='options'?panelOptionsHTML():name==='objectives'?panelObjectivesHTML():panelStatsHTML();
  if(name==='store'){
    $('panelBody').querySelectorAll('[data-buy]').forEach(btn=>btn.addEventListener('click',()=>buyChar(btn.dataset.buy)));
    $('panelBody').querySelectorAll('[data-equip]').forEach(btn=>btn.addEventListener('click',()=>equipChar(btn.dataset.equip)));
    $('panelBody').querySelectorAll('[data-voice]').forEach(btn=>btn.addEventListener('click',e=>{e.stopPropagation();sfx.unlockAudio();vplay('jump',{gain:.9},btn.dataset.voice)}));
    $('panelBody').querySelectorAll('[data-up]').forEach(btn=>btn.addEventListener('click',()=>buyUpgrade(btn.dataset.up)));
    $('panelBody').querySelectorAll('[data-tab]').forEach(btn=>btn.addEventListener('click',()=>{storeTab=btn.dataset.tab;renderPanel('store');sfx.play('click',{gain:.6})}));
    $('panelBody').querySelectorAll('[data-prev]').forEach(el=>el.addEventListener('click',e=>{e.stopPropagation();setPreviewChar(el.dataset.prev);sfx.unlockAudio();vplay('click',{gain:.5})}));
    if(storeTab==='shop'){ensureCharPreview().then(ok=>{if(ok)setPreviewChar(charState.equipped)});}
  }
  if(name==='objectives'){
    $('panelBody').querySelectorAll('[data-claim]').forEach(btn=>btn.addEventListener('click',()=>claimObjective(btn.dataset.claim)));
  }
  if(name==='options'){
    $('optMusic').addEventListener('change',e=>{settings.music=e.target.checked;saveSettings();applySettings();if(settings.music)sfx.play('click',{gain:.6})});
    $('optSfx').addEventListener('change',e=>{settings.sfx=e.target.checked;saveSettings();applySettings();if(settings.sfx)sfx.play('click',{gain:.6})});
    $('optHaptics').addEventListener('change',e=>{settings.haptics=e.target.checked;saveSettings();haptic(50)});
    $('optTilt').addEventListener('change',async e=>{
      const on=e.target.checked;
      if(on&&typeof DeviceOrientationEvent!=='undefined'&&DeviceOrientationEvent.requestPermission){
        try{const r=await DeviceOrientationEvent.requestPermission();if(r!=='granted'){e.target.checked=false;setHint('倾斜转向需要设备方向权限',1.6);settings.tilt=false;saveSettings();return}}catch{ }
      }
      settings.tilt=on;saveSettings();
      setHint(on?'倾斜转向已开启':'倾斜转向已关闭',1.4);
    });
    const tutBtn=$('optTutorial');if(tutBtn)tutBtn.addEventListener('click',()=>{closePanel();maybeShowTutorial(true)});
    $('optHq').addEventListener('change',e=>{settings.hq=e.target.checked;saveSettings();applySettings()});
  }
}
function openPanel(name){if(state!=='menu'&&state!=='paused'&&state!=='ended')return;renderPanel(name);show('panelOverlay',true);sfx.play('click',{gain:.6})}
let panelClosing=false;
function closePanel(){if(!panelOpen||panelClosing)return;const el=$('panelOverlay');if(!el)return;
  panelClosing=true;el.classList.add('closing');sfx.play('click',{gain:.5});
  setTimeout(()=>{el.classList.remove('closing');panelOpen=null;panelClosing=false;show('panelOverlay',false)},170);
}
window.render_game_to_text=()=>JSON.stringify({state,distance:Math.floor(distance),coins,gems,multiplier,lane,jumpY,sliding,
  speed,nextTurn,turnDirection,turnQueued,turnCount,turnFlash:+turnFlash.toFixed(2),chaseGap,stumbleCooldown,
  junctionVisible:junction.visible,pathSegments:pathSegments.length,death:death&&{kind:death.kind,progress:+Math.min(1,death.elapsed/death.duration).toFixed(2)},
  power:power.shield>0?'shield':power.type,powerRemain:+Math.max(0,power.until-runTime).toFixed(1),
  pickups:pickups.filter(p=>p.pathDistance>=distance-2&&p.pathDistance<distance+95).map(p=>({kind:p.kind,lane:p.lane,ahead:Math.round(p.pathDistance-distance)})),
  obstacles:obstacles.filter(o=>o.pathDistance>=distance-2&&o.pathDistance<distance+45).map(o=>({kind:o.kind,lane:o.lane,ahead:Math.round(o.pathDistance-distance)}))});
window.advanceTime=(ms)=>{const steps=Math.max(1,Math.ceil(ms/25)),step=Math.min(ms/steps/1000,.05);for(let i=0;i<steps;i++)update(step);renderer.render(scene,camera)};
if(import.meta.env.DEV)window.__templeDebug={ THREE, body:()=>body, landPulse:()=>landPulse, voicePitch:()=>charPitch(), equipped:()=>charState.equipped, owned:()=>charState.owned.slice(), giveChar:(id)=>{if(!charState.owned.includes(id))charState.owned.push(id);saveCharState()}, equipChar, junction:()=>junction, enemy:()=>enemy, scene, camera, player, audio:sfx, stats:()=>stats, settings:()=>settings, openPanel, closePanel, obstacles:()=>obstacles.map(o=>({kind:o.kind,full:o.full,lane:o.lane,d:+o.pathDistance.toFixed(1)})), coins:()=>coinItems.map(c=>({lane:c.lane,d:+c.pathDistance.toFixed(1),taken:c.taken})), 
  jumpTo(value){clearObjects();distance=value;nextSpawn=value+100;update(0.001);const from=pathAt(distance-10.0),now=pathAt(distance),ahead=pathAt(distance+10);camera.position.set(from.x,5.25,from.z);camera.lookAt(THREE.MathUtils.lerp(now.x,ahead.x,.3),1.15,THREE.MathUtils.lerp(now.z,ahead.z,.3));renderer.render(scene,camera)},
  setNextTurn(value){nextTurn=value},
  segments:()=>pathSegments.map(s=>({start:s.start,heading:+s.heading.toFixed(3)})),
  addCoins(n){coins+=n;renderNum($('coins'),coins,'num-sm')},
  milestone:(n,u)=>showMilestone(n,u||'m'), setMilestone:(v)=>{lastMilestone=v;milestoneTimer=0;show('milestone',false)},
  milestones:()=>({lastCoinMilestone,lastGemMilestone,milestoneTimer}), flameCount:()=>flames.length, flames:()=>flames, chargeMeter:(n)=>chargePowerMeter(n||1), audioStats:()=>sfx.stats?sfx.stats():null, gpu:()=>({geometries:renderer.info.memory.geometries,textures:renderer.info.memory.textures,programs:renderer.info.programs?renderer.info.programs.length:0,calls:renderer.info.render.calls,triangles:renderer.info.render.triangles}), pools:()=>({flames:flames.length,sparks:sparks.length,waterfalls:waterfalls.length,gateways:gateways.length,monkeys:monkeys.length,coins:coinItems.length,gems:gemItems.length,pickups:pickups.length,dust:dustMotes.length,fireflies:fireflies.length,leaves:leafSprites.length,sway:swayLeaves.length,watch:watchMonkeys.length,obstacles:obstacles.length}), bridgeAt:(d)=>isBridgeTile(d), hallAt:(d)=>isHallTile(d), cliffAt:(d)=>isCliffTile(d), stepLoop:()=>stepSurface,
  shafts:()=>lightShafts.length,
  spawnMonkey:(ahead=10)=>{spawnMonkey(ahead);return monkeys.length},monkeys:()=>monkeys.map(m=>({pd:+m.pd.toFixed(1),taken:m.taken})),
  skipToTurn(){this.jumpTo(nextTurn-14)},
  attemptTurn(dir){move(dir)},
  restart(){reset()},
  freeze(){speed=0},
  thaw(){speed=RUN_SPEED},
  setSpeed(value){speed=value},
  spawnObstacle(kind,ahead=5){obstacles.push(createObstacle(kind,lane,distance+ahead))},spawnObstacleIn(kind,ln,ahead=5){obstacles.push(createObstacle(kind,ln,distance+ahead))},spawnPickup(kind,ahead=6){pickups.push(createPickup(kind,lane,distance+ahead))},spawnCoin(laneIdx,ahead=6,y=1.3){coinItems.push(createCoin(laneIdx,distance+ahead,y))},spawnGem:(laneIdx=1,ahead=6)=>{gemItems.push(createGemPickup(laneIdx,distance+ahead))},hit:stumbleOrCatch,end,slowDeath:(v)=>{if(death)death.duration=v},
  givePower(kind){activatePower(kind)},rig:()=>runnerRig,tutorial:(v)=>{if(v)maybeShowTutorial(true);else hideTutorial()},
  embers(n=10){const p=pathAt(distance,laneX);for(let i=0;i<n;i++)spawnEmber(new THREE.Vector3(p.x+(Math.random()-.5)*2.2,1.2+Math.random()*2.6,p.z-2-Math.random()*3))},
  burst(n=16,ahead=3){const p=pathAt(distance+ahead,laneX*.4);spawnSparks(new THREE.Vector3(p.x,1.35,p.z),0xffd75e,n,1.4,.5,6)},
  inspect(px,py,pz,tx,ty,tz){window.__inspect={px,py,pz,tx,ty,tz}},
  gateways:()=>gateways.map(g=>({d:+g.pathDistance.toFixed(1),vis:g.group.visible,x:+g.group.position.x.toFixed(1),z:+g.group.position.z.toFixed(1)})),
  hold(on){window.__hold=!!on}, cameraGap:()=>{const c=camera.position,p=player.position;const dx=p.x-c.x,dz=p.z-c.z;return {dist:+Math.hypot(dx,dz).toFixed(2),height:+(c.y-p.y).toFixed(2),fov:+camera.fov.toFixed(1)}}, streakDebug:()=>({speed,rush:Math.max(0,Math.min(1,(speed-15)/7)),count:5+Math.round(Math.max(0,Math.min(1,(speed-15)/7))*7)}),
  uninspect(){delete window.__inspect}
};
let fpsAcc=0,fpsFrames=0,fpsLow=false,fpsWins=0;
function frame(now){const dt=Math.min(.05,(now-previous)/1000||0);previous=now;
  // Adaptive resolution: drop to 1x when the device can't hold ~40fps, restore to the
  // native pixel ratio once it has been smooth for a few seconds again.
  if(dt>0){fpsAcc+=dt;fpsFrames++;if(fpsFrames>=90){const avg=fpsAcc/fpsFrames;fpsAcc=0;fpsFrames=0;
    if(avg>1/40&&!fpsLow){fpsLow=true;fpsWins=0;renderer.setPixelRatio(1)}
    else if(avg<1/55&&fpsLow){fpsWins++;if(fpsWins>=3){fpsLow=false;renderer.setPixelRatio(Math.min(devicePixelRatio||1,2))}}
  }}
  try{if(!window.__hold&&!tutorialActive)update(dt);if(state!=='playing')setStepSurface(null);updateSpeedLines();
  // Ambient animation: guardian eye glow + subtle flame flicker on every torch/brazier.
  for(let i=0;i<guardianEyes.length;i++){const e=guardianEyes[i];e.material.opacity=.55+Math.sin(runTime*2.6+i*1.7)*.3}
  if(junction.visible)for(const h of guardianHeads){
    h.g.getWorldPosition(_tmpV);
    const dx=player.position.x-_tmpV.x, dz=player.position.z-_tmpV.z;
    if(dx*dx+dz*dz<400)h.g.rotation.y=Math.atan2(dx,dz)*.6;
  }
  for(let i=0;i<flames.length;i++){const f=flames[i];if(!f.userData.baseScale)f.userData.baseScale=f.scale.clone();
    const bs=f.userData.baseScale,k=1+Math.sin(runTime*7.3+i*1.9)*.07+Math.sin(runTime*13.1+i)*.04;
    f.scale.set(bs.x*k,bs.y*k,bs.z)}
  for(let i=stolenCoins.length-1;i>=0;i--){const c=stolenCoins[i];c.vy-=9*dt;c.g.position.x+=c.vx*dt;c.g.position.y+=c.vy*dt;c.g.position.z+=c.vz*dt;c.g.rotation.y+=dt*9;c.life-=dt;
    if(c.life<=0){scene.remove(c.g);stolenCoins.splice(i,1)}}
  const ins=window.__inspect;if(ins){camera.position.set(ins.px,ins.py,ins.pz);camera.lookAt(ins.tx,ins.ty,ins.tz)}renderer.render(scene,camera);renderCharPreview(now)}catch(error){console.error('Game frame failed',error);if(state==='playing')end('画面遇到问题，请重试。')}requestAnimationFrame(frame)}
requestAnimationFrame(frame);
$('startBtn').addEventListener('click',reset);$('restartBtn').addEventListener('click',()=>{commitRun();reset()});$('restartPauseBtn').addEventListener('click',()=>{commitRun();reset()});
$('reviveBtn').addEventListener('click',revive);$('endMenuBtn').addEventListener('click',goMenu);$('pauseMenuBtn').addEventListener('click',goMenu);
$('pauseBtn').addEventListener('click',pause);$('resumeBtn').addEventListener('click',pause);
$('fsBtn').addEventListener('click',async()=>{
  try{
    if(document.fullscreenElement){await document.exitFullscreen();}
    else{const el=document.documentElement;await (el.requestFullscreen?el.requestFullscreen({navigationUI:'hide'}):el.webkitRequestFullscreen());}
  }catch(e){showHint('当前浏览器不支持全屏');}
});
document.querySelectorAll('[data-panel]').forEach(btn=>btn.addEventListener('click',()=>openPanel(btn.dataset.panel)));
$('bagBtn').addEventListener('click',()=>{if(state==='playing')pause();storeTab='shop';openPanel('store')});
const endStoreBtn=$('endStoreBtn');if(endStoreBtn)endStoreBtn.addEventListener('click',()=>{if(state==='ended'){storeTab='shop';openPanel('store')}});
const endObjBtn=$('endObjBtn');if(endObjBtn)endObjBtn.addEventListener('click',()=>{if(state==='ended')openPanel('objectives')});
$('panelBack').addEventListener('click',closePanel);
applySettings();
updateMenuCoins();
// Menu BGM: browsers require a user gesture before audio can start, so begin the
// original theme on the first interaction anywhere on the page (not only on PLAY).
function ensureMenuMusic(){
  if(settings.music&&(state==='menu'||state==='playing')&&!sfx.musicInfo().current){sfx.unlockAudio();sfx.startMusic('theme')}
  const hint=$('audioHint');
  if(hint&&settings.music){hint.classList.add('hidden')}
}
window.addEventListener('pointerdown',ensureMenuMusic);
window.addEventListener('keydown',ensureMenuMusic);
$('soundBtn').addEventListener('click',()=>{settings.sfx=!settings.sfx;saveSettings();applySettings();if(settings.sfx){sfx.unlockAudio();sfx.play('click',{gain:.6})}});
for(const [id,fn] of [['leftBtn',()=>move(-1)],['rightBtn',()=>move(1)],['jumpBtn',jump],['slideBtn',slide]])$(id).addEventListener('pointerdown',e=>{
  e.preventDefault();fn();haptic(8);
  const b=$(id);b.classList.add('hit');setTimeout(()=>b.classList.remove('hit'),120);
});
// Tilt-to-turn (original Temple Run option): tipping the phone left/right turns at junctions.
let tiltDir=0;
window.addEventListener('deviceorientation',e=>{
  const g=typeof e.gamma==='number'?e.gamma:0;
  tiltDir=g<-20?-1:g>20?1:0;
  if(!settings.tilt||state!=='playing'||turnDirection===0||turnQueued)return;
  if(tiltDir===turnDirection&&distance>nextTurn-42&&distance<nextTurn+2){turnQueued=true;setHint('倾斜转弯！',.8);haptic(10)}
},{passive:true});
window.addEventListener('keydown',e=>{
  if(['ArrowLeft','ArrowRight','ArrowUp','ArrowDown','Space'].includes(e.code))e.preventDefault();
  if(e.repeat)return;
  if(e.code==='Escape'&&panelOpen){closePanel();return}
  if(e.code==='Escape'||e.code==='KeyP'){pause();return}
  if((state==='menu'||state==='ended')&&(e.code==='Space'||e.code==='Enter')){reset();return}
  if(e.code==='ArrowLeft'||e.code==='KeyA')move(-1);
  else if(e.code==='ArrowRight'||e.code==='KeyD')move(1);
  else if(e.code==='ArrowUp'||e.code==='Space'||e.code==='KeyW')jump();
  else if(e.code==='ArrowDown'||e.code==='KeyS')slide();
});
const unlockAudio=()=>{sfx.unlockAudio()};
addEventListener('pointerdown',unlockAudio,{once:true});addEventListener('keydown',unlockAudio,{once:true});
// Tutorial is a blocking intro: the run stays frozen until the player taps / presses a key.
addEventListener('keydown',dismissTutorial,true);
addEventListener('pointerdown',dismissTutorial,true);
let startX=0,startY=0;
canvas.addEventListener('pointerdown',e=>{startX=e.clientX;startY=e.clientY});
canvas.addEventListener('pointerup',e=>{
  if(state!=='playing')return;
  const dx=e.clientX-startX,dy=e.clientY-startY;
  if(Math.max(Math.abs(dx),Math.abs(dy))<28){jump();return} // tap = jump (original mobile feel)
  if(Math.abs(dx)>Math.abs(dy))move(dx<0?-1:1);else if(dy<0)jump();else slide();
});
// UI click feedback for every button (menus, store, panels) — the original UI is clicky.
document.addEventListener('pointerdown',e=>{const b=e.target&&e.target.closest?e.target.closest('button'):null;if(!b||b.disabled||b.classList.contains('disabled'))return;
  sfx.play('click',{gain:.4});
  b.classList.add('hit');setTimeout(()=>b.classList.remove('hit'),130);
},true);
document.addEventListener('visibilitychange',()=>{if(document.hidden&&state==='playing')pause()});
window.addEventListener('blur',()=>{if(state==='playing')pause()});
// LAN helper card: only useful when the page was opened on localhost (desktop).
if(location.hostname!=='localhost'&&location.hostname!=='127.0.0.1'){
  const qc=document.getElementById('qrCard');if(qc)qc.style.display='none';
}
// Portrait-only play: block interaction and pause when the phone is sideways.
const rotateMq=matchMedia('(orientation:landscape) and (max-height:560px) and (max-width:1000px)');
function syncRotateHint(){
  const el=$('rotateHint');if(!el)return;
  el.setAttribute('aria-hidden',rotateMq.matches?'false':'true');
  if(rotateMq.matches&&state==='playing')pause();
}
rotateMq.addEventListener?rotateMq.addEventListener('change',syncRotateHint):rotateMq.addListener(syncRotateHint);
syncRotateHint();
