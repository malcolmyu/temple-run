mesh(body,geo.box,mats.shirt,0,1.42,0,1.05,1.02,.62).castShadow=true;
mesh(body,geo.box,mats.belt,0,1.05,.34,.95,.17,.12);
mesh(body,geo.sphere,mats.skin,0,2.22,.04,.46,.52,.43).castShadow=true;
