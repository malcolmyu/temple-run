  const grd=g.createRadialGradient(64,64,4,64,64,62);grd.addColorStop(0,'rgba(226,240,232,.55)');grd.addColorStop(.5,'rgba(210,228,220,.22)');grd.addColorStop(1,'rgba(200,220,214,0)');
