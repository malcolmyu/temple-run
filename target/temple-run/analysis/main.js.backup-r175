  const grd=g.createLinearGradient(0,0,96,0);grd.addColorStop(0,'#6d1a16');grd.addColorStop(.5,'#a3281f');grd.addColorStop(1,'#5c1411');
  g.fillStyle=grd;g.fillRect(6,0,84,256);
