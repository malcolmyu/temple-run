const CORRIDOR_WALL_SCALE=.2,CORRIDOR_WALL_X=6.4,CORRIDOR_WALL_NEAR_TURN=10;

// Authentic Temple Run proportions: the exported tile carries a 30 u ground skirt, so sink it
// by 30*scale to leave the ~1.4 m ruin wall the original actually shows above the road.
const LOWWALL_SINK=-6.0;
// Original Temple Run map: path sections of very different lengths, with short
// "snake" stretches (two quick corners) and long straight runs. Chosen in tiles of 12 m.
function pickNextTurnLength(seed){
  const r=rand(seed*1.71+11.3);
  if(r<.30)return 24+Math.floor(rand(seed*2.9+3.7)*2)*12;      // 24-36 m: S/U curve
  if(r<.74)return 60+Math.floor(rand(seed*3.3+5.1)*4)*12;      // 60-96 m: medium
  return 132+Math.floor(rand(seed*4.7+7.9)*7)*12;              // 132-204 m: long run
}
// ---- original APK obstacle prefabs (exported by the asset scout) ----
const obstacleTreeMat=new THREE.MeshStandardMaterial({map:treeTexture,side:THREE.DoubleSide,roughness:.95,metalness:0,alphaTest:.4});
const obstacleStoneMat=new THREE.MeshStandardMaterial({map:obstacleStoneAtlas,color:0xd8c8a8,side:THREE.DoubleSide,roughness:.95,metalness:0});
const obstaclePrefabs={};
const boulderMat=new THREE.MeshStandardMaterial({map:obstacleStoneAtlas,color:0x9b8663,roughness:.92,metalness:.02});
const pedestalMat=new THREE.MeshStandardMaterial({map:obstacleStoneAtlas,color:0xd8c8a4,roughness:.9,metalness:.02,side:THREE.DoubleSide});
function loadObstaclePrefab(name){
  const tree=name.startsWith('tree');
  new OBJLoader().load(`${import.meta.env.BASE_URL}assets/obstacles/${name}.obj`,obj=>{
    obj.traverse(part=>{if(part.isMesh){part.material=tree?obstacleTreeMat:obstacleStoneMat;part.castShadow=true;part.receiveShadow=true}});
    // static APK scenery: origin sits at tile centre, so recentre XZ and drop it onto y=0
    const box=new THREE.Box3().setFromObject(obj),ctr=box.getCenter(new THREE.Vector3());
    obj.position.set(-ctr.x,-box.min.y,-ctr.z);
    const wrapped=new THREE.Group();wrapped.add(obj);
    obstaclePrefabs[name]=wrapped;
  },undefined,()=>console.warn('Obstacle prefab unavailable: '+name));
}
['tree-jump-left','tree-jump-right','tree-slide','flame-tower','stone-pedestal','tower-arch'].forEach(loadObstaclePrefab);
function obstaclePrefab(name,scale,rotY=Math.PI){
  const src=obstaclePrefabs[name];if(!src)return null;
  const clone=src.clone(true);clone.scale.setScalar(scale);clone.rotation.y=rotY;return clone;
}
