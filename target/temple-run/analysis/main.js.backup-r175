  g.beginPath();g.arc(48,88,26,0,Math.PI*2);g.fillStyle='#d8b56a';g.fill();
  g.beginPath();g.arc(48,88,18,0,Math.PI*2);g.fillStyle='#7a1d17';g.fill();
  g.fillStyle='#e8c97e';g.fillRect(44,64,8,48);g.fillRect(30,84,36,8);
  g.beginPath();g.moveTo(6,256);g.lineTo(48,232);g.lineTo(90,256);g.fillStyle='#5c1411';g.fill();
  const t=new THREE.CanvasTexture(c);t.colorSpace=THREE.SRGBColorSpace;return t})();
const rugTex=(()=>{const c=document.createElement('canvas');c.width=96;c.height=512;const g=c.getContext('2d');
  g.fillStyle='#7a1c16';g.fillRect(0,0,96,512);
