const shaftTex=(()=>{const c=document.createElement('canvas');c.width=64;c.height=256;const g=c.getContext('2d');
  const grd=g.createLinearGradient(0,0,0,256);
  grd.addColorStop(0,'rgba(255,240,200,0)');grd.addColorStop(.18,'rgba(255,238,196,.55)');
  grd.addColorStop(.55,'rgba(255,232,180,.28)');grd.addColorStop(1,'rgba(255,230,170,0)');
  g.fillStyle=grd;g.fillRect(0,0,64,256);
  const side=g.createLinearGradient(0,0,64,0);side.addColorStop(0,'rgba(0,0,0,1)');side.addColorStop(.5,'rgba(0,0,0,0)');side.addColorStop(1,'rgba(0,0,0,1)');
  g.globalCompositeOperation='destination-out';g.fillStyle=side;g.fillRect(0,0,64,256);
  const t=new THREE.CanvasTexture(c);t.colorSpace=THREE.SRGBColorSpace;return t;})();
const lightShafts=[];
function addLightShaft(parent,x,z,seed){
  const mat=new THREE.MeshBasicMaterial({map:shaftTex,color:0xffe9c2,transparent:true,opacity:.3,depthWrite:false,side:THREE.DoubleSide,blending:THREE.AdditiveBlending,fog:false});
  const m=new THREE.Mesh(new THREE.PlaneGeometry(4.2,13),mat);
  m.position.set(x,6.2,z);
  m.rotation.z=.14;
  m.renderOrder=2;parent.add(m);lightShafts.push(m);return m;
}
function makeFlameGlow(x,y,z,scale){const sp=new THREE.Sprite(new THREE.SpriteMaterial({map:flameGlow,color:0xffb45a,transparent:true,depthWrite:false,blending:THREE.AdditiveBlending,opacity:.6}));sp.position.set(x,y,z);sp.scale.setScalar(scale);return sp}
// Tiny additive sparkle bursts for coin / power-up pickups (original has a golden sparkle on pickup).
const sparks=[];
function spawnSparks(pos,color,count=6,spread=.7,size=.42,life=.6,texKey='sparkle'){
  for(let i=0;i<count;i++){
    const sp=new THREE.Sprite(new THREE.SpriteMaterial({map:FX[texKey]||FX.sparkle,color,transparent:true,depthWrite:false,blending:THREE.AdditiveBlending,opacity:.9}));
    sp.position.copy(pos);
    const k=size*(0.6+Math.random()*.8);sp.scale.setScalar(k);
    scene.add(sp);
    sparks.push({sp,vx:(Math.random()-.5)*spread,vy:.35+Math.random()*.9,vz:(Math.random()-.5)*spread,life:life*(.75+Math.random()*.45),max:life});
  }
}
function spawnEmber(pos){
  const sp=new THREE.Sprite(new THREE.SpriteMaterial({map:FX.ember,color:0xffb24a,transparent:true,depthWrite:false,blending:THREE.AdditiveBlending,opacity:.85}));
  sp.position.copy(pos);
  sp.scale.setScalar(.16+Math.random()*.18);
  scene.add(sp);
  sparks.push({sp,vx:(Math.random()-.5)*.28,vy:.55+Math.random()*.7,vz:(Math.random()-.5)*.28,life:.9+Math.random()*.9,max:1.8,ember:true});
}
function jumpKick(){
  // Launch dust: a small puff ring kicked back from the feet as the runner leaves the ground.
  const f=pathAt(distance-1.05,laneX);
  for(const s of [-1,1]){const q=pathAt(distance-1.0,laneX+s*.42);dustPuff(new THREE.Vector3(q.x,.1,q.z),3,.42)}
}
function dustPuff(pos,count=4,scale=.5){
  for(let i=0;i<count;i++){
    const sp=new THREE.Sprite(new THREE.SpriteMaterial({map:FX.dust,color:0xe0d2b4,transparent:true,opacity:.42,depthWrite:false}));
    sp.position.set(pos.x+(Math.random()-.5)*.5,pos.y+Math.random()*.12,pos.z+(Math.random()-.5)*.5);
    const k=scale*(0.7+Math.random()*.7);sp.scale.setScalar(k);
    scene.add(sp);
    sparks.push({sp,vx:(Math.random()-.5)*.32,vy:.25+Math.random()*.35,vz:(Math.random()-.5)*.32,life:.5+Math.random()*.2,max:.6,dust:true,size:k});
  }
}
let lastStepDustAt=-1,wasAirborne=false;
let stepSurface=null,hallReverbOn=false;
function setStepSurface(name){
  if(stepSurface===name)return;
  if(stepSurface)sfx.stopLoop(stepSurface,.14);
  stepSurface=name;
  if(name)sfx.startLoop(name,{gain:.5});
}
function updateSparks(dt){
  for(let i=sparks.length-1;i>=0;i--){
    const p=sparks[i];p.life-=dt;
    if(p.life<=0){scene.remove(p.sp);sparks.splice(i,1);continue}
    if(p.dust){
      p.sp.position.x+=p.vx*dt;p.sp.position.y+=p.vy*dt;p.sp.position.z+=p.vz*dt;
      p.sp.scale.setScalar(p.size*(1+(1-p.life/p.max)*1.6));
      p.sp.material.opacity=Math.max(0,p.life/p.max)*.4;
      continue;
    }
    if(p.ember){
      p.sp.position.x+=p.vx*dt;p.sp.position.y+=p.vy*dt;p.sp.position.z+=p.vz*dt;
      p.vx*=.985;p.vz*=.985;
      p.sp.material.opacity=Math.max(0,p.life/p.max)*.75;
      continue;
    }
    p.vy-=2.2*dt;
    p.sp.position.x+=p.vx*dt;p.sp.position.y+=p.vy*dt;p.sp.position.z+=p.vz*dt;
    p.sp.material.opacity=Math.max(0,p.life/p.max)*.95;
  }
}
