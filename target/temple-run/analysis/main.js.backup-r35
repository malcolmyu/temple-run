function updatePavementRepeat(){if(pavementTexture)pavementTexture.repeat.set(8.4/4,8.4/12);}
const junctionWallMat=material(0xa89b80,{side:THREE.DoubleSide});
// Crop one brick cell out of the original wallTexture atlas and tile it (avoids atlas wrap bleeding).
new THREE.TextureLoader().load(asset('wallTexture.png'),tex=>{
  const brickCanvas=document.createElement('canvas');brickCanvas.width=brickCanvas.height=256;
  brickCanvas.getContext('2d').drawImage(tex.image,256,0,256,256,0,0,256,256);
  const map=new THREE.CanvasTexture(brickCanvas);
  map.wrapS=map.wrapT=THREE.RepeatWrapping;map.colorSpace=THREE.SRGBColorSpace;
  map.repeat.set(3,2);
  junctionWallMat.map=map;junctionWallMat.needsUpdate=true;
  const stoneMap=map.clone();stoneMap.needsUpdate=true;stoneMap.repeat.set(1,1);
  obstacleStone.map=stoneMap;obstacleStone.needsUpdate=true;
  // Cropped paving cell (brick floor) for the junction platform.
  const paveCanvas=document.createElement('canvas');paveCanvas.width=paveCanvas.height=250;
  paveCanvas.getContext('2d').drawImage(tex.image,516,6,250,250,0,0,250,250);
  const paveMap=new THREE.CanvasTexture(paveCanvas);
  paveMap.wrapS=paveMap.wrapT=THREE.RepeatWrapping;paveMap.colorSpace=THREE.SRGBColorSpace;
  pavementTexture=paveMap;
  junctionPavingMat.map=paveMap;junctionPavingMat.needsUpdate=true;
  if(typeof updatePavementRepeat==='function')updatePavementRepeat();
},undefined,()=>{});
