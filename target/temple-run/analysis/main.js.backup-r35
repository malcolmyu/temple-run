const mats = {
  stone:material(0x837c65), edge:material(0xb7a98a), seam:material(0x544c3c),
  moss:material(0x496f4c), leaf:material(0x3c7451,{side:THREE.DoubleSide}),
  darkLeaf:material(0x254d3f), bark:material(0x554a34), gold:material(0xf5bb43,{metalness:.72,roughness:.25,emissive:0x6b4309,emissiveIntensity:.3}),
  goldLight:material(0xffdf7d,{emissive:0x9b6118,emissiveIntensity:.5}),
  red:material(0xae4135), fire:material(0xff7a24,{emissive:0xff5a12,emissiveIntensity:1.15}),
  black:material(0x1a231c), skin:material(0xb87751), shirt:material(0xd6b388), pants:material(0x554839),
  belt:material(0x433025), hair:material(0x34291f), eye:material(0x161713),
