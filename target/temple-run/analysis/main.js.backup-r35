const fireOuter=material(0xff5a10,{emissive:0xff6a12,emissiveIntensity:.7,transparent:true,opacity:.88,depthWrite:false});
const flameGlow=(()=>{const c=document.createElement('canvas');c.width=c.height=128;const g=c.getContext('2d');
  const grd=g.createRadialGradient(64,64,4,64,64,62);grd.addColorStop(0,'rgba(255,240,190,1)');grd.addColorStop(.35,'rgba(255,170,60,.75)');grd.addColorStop(1,'rgba(255,90,10,0)');
  g.fillStyle=grd;g.fillRect(0,0,128,128);const t=new THREE.CanvasTexture(c);t.colorSpace=THREE.SRGBColorSpace;return t;})();
function makeFlameGlow(x,y,z,scale){const sp=new THREE.Sprite(new THREE.SpriteMaterial({map:flameGlow,color:0xffb45a,transparent:true,depthWrite:false,blending:THREE.AdditiveBlending,opacity:.6}));sp.position.set(x,y,z);sp.scale.setScalar(scale);return sp}
// Tiny additive sparkle bursts for coin / power-up pickups (original has a golden sparkle on pickup).
const sparks=[];
function spawnSparks(pos,color,count=6,spread=.7,size=.42,life=.6){
  for(let i=0;i<count;i++){
    const sp=new THREE.Sprite(new THREE.SpriteMaterial({map:flameGlow,color,transparent:true,depthWrite:false,blending:THREE.AdditiveBlending,opacity:.9}));
    sp.position.copy(pos);
    const k=size*(0.6+Math.random()*.8);sp.scale.setScalar(k);
    scene.add(sp);
    sparks.push({sp,vx:(Math.random()-.5)*spread,vy:.35+Math.random()*.9,vz:(Math.random()-.5)*spread,life:life*(.75+Math.random()*.45),max:life});
  }
}
function updateSparks(dt){
  for(let i=sparks.length-1;i>=0;i--){
    const p=sparks[i];p.life-=dt;
    if(p.life<=0){scene.remove(p.sp);sparks.splice(i,1);continue}
    p.vy-=2.2*dt;
    p.sp.position.x+=p.vx*dt;p.sp.position.y+=p.vy*dt;p.sp.position.z+=p.vz*dt;
    p.sp.material.opacity=Math.max(0,p.life/p.max)*.95;
  }
}
const facadeTexture=textureLoader.load(asset('wallTexture.png'));facadeTexture.colorSpace=THREE.SRGBColorSpace;
const facadeMat=new THREE.MeshStandardMaterial({map:facadeTexture,side:THREE.DoubleSide,roughness:.95,metalness:0});
const treeTexture=textureLoader.load(asset('treeTexture.png'));treeTexture.colorSpace=THREE.SRGBColorSpace;
const treeMat=new THREE.MeshStandardMaterial({map:treeTexture,side:THREE.DoubleSide,roughness:.95,metalness:0});
let treeTemplate=null,rockTemplate=null;
