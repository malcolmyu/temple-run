  g.addColorStop(0,'#2b4033');g.addColorStop(.45,'#45603f');g.addColorStop(.75,'#557050');g.addColorStop(1,'#3a5038');
  const ctx2=skyCanvas.getContext('2d');ctx2.fillStyle=g;ctx2.fillRect(0,0,8,256);
}
